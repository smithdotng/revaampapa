# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.
# Locally, anything missing here is read from the Express app's ../.env.

# MongoDB Atlas connection string (same database as the old site)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/revaampap

# Must match the old site's value so people stay signed in after the move
SESSION_SECRET=

# Public address, used in emails, canonical links and the sitemap
BASE_URL=https://revaampapa.com

# Hostinger SMTP
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=info@revaampapa.com
EMAIL_PASS=
# Optional: where contact-form messages go (defaults to info@revaampapa.com)
# CONTACT_TO=info@revaampapa.com

# Paystack (project subscriber plans, old verification-fee callbacks)
PAYSTACK_SECRET_KEY=

# File uploads. On Vercel, connect a Blob store to the project and this is added for you.
# BLOB_READ_WRITE_TOKEN=

# Where files uploaded before the move are served from. After running
# scripts/upload-legacy-files.mjs, set this to the Blob store URL it prints,
# e.g. https://abc123.public.blob.vercel-storage.com
# NEXT_PUBLIC_UPLOADS_URL=

# Agency-fee split used when recording a completed deal (percent)
# PROMOTER_COMMISSION=70
# OWNER_COMMISSION=10

# Local only: folder for uploads when there's no Blob store (defaults to ../public/uploads)
# UPLOAD_DIR=
