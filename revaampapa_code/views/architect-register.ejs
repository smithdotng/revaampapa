<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="author" content="RevaampAPA">
    <title>Revaamp Partner Architect Registration | Join Africa's Property Ecosystem</title>
    <meta name="description" content="Join the REVAAMP Project Management Solution as a Partner Architect. Connect with property owners and developers across Africa. Register at revaampapa.com/architect/register.">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://revaampapa.com/architect/register">
    <meta property="og:title" content="Revaamp Partner Architect — Design. Collaborate. Earn.">
    <meta property="og:description" content="Are you a licensed architect in Africa? Join the Revaamp network and access a continent-wide pipeline of design briefs, project management opportunities, and multiple income streams. Register free today.">
    <meta property="og:image" content="https://revaampapa.com/img/architect-og.jpg">
    <meta property="og:image:width" content="1080">
    <meta property="og:image:height" content="1080">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:secure_url" content="https://revaampapa.com/img/architect-og.jpg">
    <meta property="og:image:alt" content="Revaamp Partner Architect — Join Africa's property ecosystem">
    <meta property="og:site_name" content="RevaampAPA">
    <meta property="og:locale" content="en_NG">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://revaampapa.com/architect/register">
    <meta name="twitter:title" content="Revaamp Partner Architect — Design. Collaborate. Earn.">
    <meta name="twitter:description" content="Licensed architect in Africa? Join Revaamp and access a continent-wide pipeline of design briefs, developers, and project management opportunities.">
    <meta name="twitter:image" content="https://revaampapa.com/img/architect-og.jpg">
    <meta name="twitter:site" content="@revaampap">
    <meta name="twitter:creator" content="@revaampap">

    <!-- WhatsApp / LinkedIn -->
    <meta property="og:image:secure_url" content="https://revaampapa.com/img/architect-og.jpg">
    <meta property="linkedin:card" content="summary_large_image">

    <!-- Canonical -->
    <link rel="canonical" href="https://revaampapa.com/architect/register">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/properties">Properties</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <a href="/login" class="mil-btn mil-sm">Log in</a>
                    <a href="/register" class="mil-btn mil-sm mil-light">List Property</a>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger alert-dismissible fade show m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success alert-dismissible fade show m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;">
                <i class="fas fa-check-circle"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert">&times;</button>
            </div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Project Management Solution &mdash; Verification Phase</div>
                                <h1 class="mil-mb-60 mil-up">REVAAMP Partner Architect</h1>
                                <ul class="mil-breadcrumbs mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/architect/register">Partner Architect</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-cta mil-up mil-mt-30">
                <div class="container">
                    <div class="mil-out-frame mil-p-80-80" style="background: linear-gradient(135deg, #2c3e50 0%, #03A6A6 100%);">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-xl-12 mil-text-center">
                                <h2 class="mil-light mil-mb-15 mil-up">📐 Conduct Structural Assessments of Proposed Projects 📐</h2>
                                <p class="mil-text-m mil-light mil-mb-0 mil-up">Verify proposed plans &nbsp;|&nbsp; Submit structural reports &nbsp;|&nbsp; Pan-African project ecosystem</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-6">
                            <div class="mil-price-card">
                                <div class="mil-text-center mil-mb-30">
                                    <i class="fa fa-drafting-compass" style="font-size: 60px; color: #03A6A6;"></i>
                                    <h3 class="mil-mb-15 mil-mt-15">Register as Partner Architect</h3>
                                    <p class="mil-text-m mil-soft">Onboard to the REVAAMP Project Management Solution and assess proposed projects across Africa</p>
                                </div>

                                <form action="/architect/register" method="POST" enctype="multipart/form-data">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="name" placeholder="Full name" value="<%= typeof userData !== 'undefined' && userData ? userData.name : '' %>" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="email" name="email" placeholder="Email address" value="<%= typeof userData !== 'undefined' && userData ? userData.email : '' %>" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="tel" name="phone" placeholder="Phone number" value="<%= typeof userData !== 'undefined' && userData ? userData.phone : '' %>" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="firm" placeholder="Architectural firm / practice name" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="arconNumber" placeholder="ARCON Registration Number" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="countryOfPractice" placeholder="Country of Practice" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="territory" placeholder="Your Territory (State/Region)">
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="specialization" placeholder="Specialization (e.g. residential, commercial, structural) — comma separated">
                                        </div>
                                        <div class="col-md-12">
                                            <textarea class="mil-input mil-up mil-mb-15" name="experience" rows="3" placeholder="Years of experience & relevant project background"></textarea>
                                        </div>
                                        <% if (typeof userData === 'undefined' || !userData) { %>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="password" name="password" placeholder="Password (min. 8 characters)" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-30" type="password" name="confirmPassword" placeholder="Confirm Password" required>
                                        </div>
                                        <% } %>
                                    </div>

                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Upload Documents</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">ARCON Certificate</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="arconCertificate" accept="image/*,.pdf">
                                        <p class="mil-text-xs mil-soft mil-mt-5">Upload your ARCON registration certificate (image or PDF)</p>
                                    </div>

                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">Firm Registration (Optional)</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="firmRegistration" accept="image/*,.pdf">
                                        <p class="mil-text-xs mil-soft mil-mt-5">Upload your firm / practice registration document</p>
                                    </div>

                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">Professional Profile / CV</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="professionalProfile" accept=".pdf,.doc,.docx">
                                        <p class="mil-text-xs mil-soft mil-mt-5">Upload your professional profile or CV (PDF or DOC - Max 10MB)</p>
                                    </div>

                                    <div class="mil-checkbox-frame mil-up mil-mb-30">
                                        <div class="mil-checkbox">
                                            <input type="checkbox" id="mandate" name="mandate" required>
                                            <label for="mandate"></label>
                                        </div>
                                        <p class="mil-text-xs mil-soft">I accept the mandate to act as a REVAAMP Partner Architect and conduct structural assessments in good faith</p>
                                    </div>

                                    <div class="mil-checkbox-frame mil-up mil-mb-30">
                                        <div class="mil-checkbox">
                                            <input type="checkbox" id="terms" name="terms" required>
                                            <label for="terms"></label>
                                        </div>
                                        <p class="mil-text-xs mil-soft">I agree to the <a href="/terms" class="mil-accent">Terms and Conditions</a> and <a href="/privacy" class="mil-accent">Privacy Policy</a></p>
                                    </div>

                                    <div class="mil-up">
                                        <button type="submit" class="mil-btn mil-md mil-fw">Register as Partner Architect</button>
                                    </div>

                                    <div class="mil-text-center mil-mt-30">
                                        <p class="mil-text-s mil-soft">
                                            Already have an account? <a href="/login" class="mil-accent">Login here</a>
                                        </p>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Project Management Solution</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(function(alert) {
                alert.style.opacity = '0';
                setTimeout(function() { if (alert.parentNode) alert.remove(); }, 300);
            });
        }, 5000);
    </script>

    <style>
        .mil-fw { width: 100%; }
        .mil-mt-30 { margin-top: 30px; }
        .mil-mt-10 { margin-top: 10px; }
        .mil-mb-5 { margin-bottom: 5px; }
        .mil-mb-15 { margin-bottom: 15px; }
        .mil-mb-30 { margin-bottom: 30px; }
        .mil-input { width: 100%; padding: 12px 15px; border: 1px solid #e0e0e0; border-radius: 8px; }
        .mil-divider { height: 1px; background: #e0e0e0; margin: 15px 0; }
        label { display: block; margin-bottom: 5px; font-weight: 500; }
    </style>
</body>
</html>
