<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <!-- Rich text editor -->
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .form-section { background: #f8f9fa; padding: 25px; border-radius: 12px; margin-bottom: 25px; }
        .form-section h5 { margin-bottom: 18px; color: #03A6A6; border-bottom: 2px solid #03A6A6; padding-bottom: 8px; font-size: 15px; letter-spacing: 0.5px; }
        .image-preview { max-width: 100%; max-height: 220px; object-fit: cover; border-radius: 10px; margin-top: 10px; display: none; }
        .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px,1fr)); gap: 10px; }
        .category-item { display: flex; align-items: center; gap: 8px; background: white; padding: 8px 12px; border-radius: 8px; border: 1px solid #eee; cursor: pointer; transition: all 0.2s; }
        .category-item:hover { border-color: #03A6A6; }
        .category-item input:checked + label { color: #03A6A6; font-weight: 600; }
        .char-count { font-size: 12px; color: #999; text-align: right; margin-top: 4px; }
        .char-count.over { color: #dc3545; }
        .sticky-sidebar { position: sticky; top: 100px; }
        .status-select { border: 2px solid #eee; border-radius: 10px; padding: 12px; font-size: 15px; width: 100%; background: white; }
        .status-select:focus { outline: none; border-color: #03A6A6; }
    </style>
</head>
<body>
<div id="smooth-wrapper" class="mil-wrapper">
    <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
    <div class="mil-progress-track"><div class="mil-progress"></div></div>
    <div class="progress-wrap active-progress"></div>

    <div class="mil-top-panel">
        <div class="container">
            <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
            <nav class="mil-top-menu">
                <ul>
                    <li><a href="/superadmin/dashboard">Dashboard</a></li>
                    <li class="mil-active"><a href="/superadmin/blogs">Blog</a></li>
                    <li><a href="/superadmin/bid-notices">Bid Notices</a></li>
                </ul>
            </nav>
            <div class="mil-menu-buttons">
                <div class="dropdown" style="position:relative;">
                    <a href="#" class="mil-btn mil-sm dropdown-toggle"><i class="fa fa-user-circle"></i> <%= user.name %></a>
                    <ul class="dropdown-menu" style="position:absolute;right:0;top:100%;min-width:200px;background:white;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.15);padding:10px 0;margin-top:10px;z-index:1000;">
                        <li><a href="/superadmin/dashboard" style="padding:10px 20px;display:block;color:#333;text-decoration:none;">Dashboard</a></li>
                        <li><hr></li>
                        <li><a href="/logout" style="padding:10px 20px;display:block;color:#dc3545;text-decoration:none;">Logout</a></li>
                    </ul>
                </div>
                <div class="mil-menu-btn"><span></span></div>
            </div>
        </div>
    </div>

    <div id="smooth-content">
        <div class="mil-banner mil-banner-inner mil-dissolve">
            <div class="container">
                <div class="row align-items-center justify-content-center">
                    <div class="col-xl-8">
                        <div class="mil-banner-text mil-text-center">
                            <h1 class="mil-mb-60 mil-up"><%= blog ? 'Edit Post' : 'New Blog Post' %></h1>
                            <ul class="mil-breadcrumbs mil-center mil-up">
                                <li><a href="/superadmin/dashboard">Dashboard</a></li>
                                <li><a href="/superadmin/blogs">Blog</a></li>
                                <li><%= blog ? 'Edit' : 'Create' %></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mil-blog-list mil-p-80-80">
            <div class="container">
                <% if (locals.error && error.length) { %>
                    <div style="background:#f8d7da;color:#721c24;padding:15px;border-radius:8px;margin-bottom:25px;"><%= error[0] %></div>
                <% } %>

                <form action="/superadmin/blogs/<%= blog ? blog._id + '/edit' : 'create' %>" method="POST" enctype="multipart/form-data" id="blogForm">

                    <div class="row">
                        <!-- Main content column -->
                        <div class="col-xl-8">

                            <!-- Title & Excerpt -->
                            <div class="form-section">
                                <h5><i class="fa fa-pencil"></i> Post Content</h5>

                                <div class="mil-mb-20">
                                    <label class="mil-text-sm mil-soft mil-mb-10">Post Title *</label>
                                    <input type="text" name="title" class="mil-input" id="titleInput"
                                           value="<%= blog ? blog.title : '' %>"
                                           placeholder="Enter a compelling title..." required
                                           oninput="updateCharCount('titleInput','titleCount',100)">
                                    <div class="char-count" id="titleCount"></div>
                                </div>

                                <div class="mil-mb-20">
                                    <label class="mil-text-sm mil-soft mil-mb-10">Excerpt / Summary * <small style="color:#999;">(max 300 chars — shown on listing page)</small></label>
                                    <textarea name="excerpt" class="mil-input" id="excerptInput" rows="3"
                                              placeholder="Brief summary of the post..." required maxlength="300"
                                              oninput="updateCharCount('excerptInput','excerptCount',300)"><%= blog ? blog.excerpt : '' %></textarea>
                                    <div class="char-count" id="excerptCount"></div>
                                </div>

                                <div>
                                    <label class="mil-text-sm mil-soft mil-mb-10">Full Content *</label>
                                    <textarea name="content" id="contentEditor" rows="20"><%= blog ? blog.content : '' %></textarea>
                                </div>
                            </div>

                            <!-- Featured Image -->
                            <div class="form-section">
                                <h5><i class="fa fa-image"></i> Featured Image <%= blog ? '(leave empty to keep current)' : '*' %></h5>
                                <% if (blog && blog.featuredImage) { %>
                                    <div style="margin-bottom:15px;">
                                        <p class="mil-text-sm mil-soft">Current image:</p>
                                        <img src="<%= blog.featuredImage %>" style="max-height:180px;border-radius:10px;object-fit:cover;" onerror="this.style.display='none'">
                                    </div>
                                <% } %>
                                <input type="file" name="featuredImage" id="featuredImageInput" class="mil-input"
                                       accept="image/*" onchange="previewImage(this)" <%= blog ? '' : 'required' %>>
                                <img id="imagePreview" class="image-preview" alt="Preview">
                                <p class="mil-text-xs mil-soft" style="margin-top:8px;">Max 5MB · JPG, PNG, WebP</p>
                            </div>

                            <!-- SEO -->
                            <div class="form-section">
                                <h5><i class="fa fa-search"></i> SEO Settings</h5>
                                <div class="mil-mb-15">
                                    <label class="mil-text-sm mil-soft mil-mb-10">Meta Title <small style="color:#999;">(leave blank to use post title)</small></label>
                                    <input type="text" name="metaTitle" class="mil-input" value="<%= blog ? blog.metaTitle || '' : '' %>" placeholder="SEO page title...">
                                </div>
                                <div class="mil-mb-15">
                                    <label class="mil-text-sm mil-soft mil-mb-10">Meta Description</label>
                                    <textarea name="metaDescription" class="mil-input" rows="2" placeholder="SEO meta description (150–160 chars recommended)..."><%= blog ? blog.metaDescription || '' : '' %></textarea>
                                </div>
                                <div>
                                    <label class="mil-text-sm mil-soft mil-mb-10">Meta Keywords <small style="color:#999;">(comma-separated)</small></label>
                                    <input type="text" name="metaKeywords" class="mil-input" value="<%= blog ? blog.metaKeywords || '' : '' %>" placeholder="real estate, property, Nigeria...">
                                </div>
                            </div>

                        </div>

                        <!-- Sidebar -->
                        <div class="col-xl-4">
                            <div class="sticky-sidebar">

                                <!-- Publish settings -->
                                <div class="mil-price-card mil-up mil-mb-20">
                                    <h5 style="margin-bottom:15px;font-size:15px;font-weight:700;">Publish</h5>

                                    <div class="mil-mb-15">
                                        <label class="mil-text-sm mil-soft mil-mb-10">Status</label>
                                        <select name="status" class="status-select">
                                            <option value="draft" <%= !blog || blog.status === 'draft' ? 'selected' : '' %>>📝 Draft</option>
                                            <option value="published" <%= blog && blog.status === 'published' ? 'selected' : '' %>>🌐 Published</option>
                                            <option value="archived" <%= blog && blog.status === 'archived' ? 'selected' : '' %>>📦 Archived</option>
                                        </select>
                                    </div>

                                    <div class="mil-mb-20">
                                        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                                            <input type="checkbox" name="featured" value="on" <%= blog && blog.featured ? 'checked' : '' %> style="width:18px;height:18px;">
                                            <span class="mil-text-sm">⭐ Mark as Featured Post</span>
                                        </label>
                                        <p class="mil-text-xs mil-soft" style="margin-top:5px;">Featured posts are highlighted on the blog homepage.</p>
                                    </div>

                                    <div style="display:flex;flex-direction:column;gap:10px;">
                                        <button type="submit" class="mil-btn mil-accent" style="width:100%;">
                                            <i class="fa fa-save"></i> <%= blog ? 'Update Post' : 'Create Post' %>
                                        </button>
                                        <a href="/superadmin/blogs" class="mil-btn mil-light" style="width:100%;text-align:center;">Cancel</a>
                                    </div>
                                </div>

                                <!-- Categories -->
                                <div class="mil-price-card mil-up mil-mb-20">
                                    <h5 style="margin-bottom:15px;font-size:15px;font-weight:700;">Categories</h5>
                                    <div class="category-grid">
                                        <% const allCategories = ['Market News','Buying Guide','Selling Tips','Renting Advice','Investment','Legal Guide','Agent Tips','Property Spotlight','Industry Insights']; %>
                                        <% allCategories.forEach(cat => { %>
                                            <label class="category-item">
                                                <input type="checkbox" name="categories" value="<%= cat %>"
                                                       <%= blog && blog.categories && blog.categories.includes(cat) ? 'checked' : '' %>>
                                                <span style="font-size:13px;"><%= cat %></span>
                                            </label>
                                        <% }) %>
                                    </div>
                                </div>

                                <!-- Tags -->
                                <div class="mil-price-card mil-up">
                                    <h5 style="margin-bottom:15px;font-size:15px;font-weight:700;">Tags</h5>
                                    <input type="text" name="tags" class="mil-input" id="tagsInput"
                                           value="<%= blog && blog.tags ? blog.tags.join(', ') : '' %>"
                                           placeholder="property, abuja, investment...">
                                    <p class="mil-text-xs mil-soft" style="margin-top:8px;">Separate tags with commas.</p>
                                </div>

                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <footer class="mil-p-80-0">
            <div class="container"><div class="mil-footer-bottom"><p class="mil-text-s mil-soft">© 2026 RevaampAPA All rights reserved.</p></div></div>
        </footer>
    </div>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script src="/js/plugins/swiper.min.js"></script>
<script src="/js/plugins/gsap.min.js"></script>
<script src="/js/plugins/ScrollSmoother.min.js"></script>
<script src="/js/plugins/ScrollTrigger.min.js"></script>
<script src="/js/plugins/ScrollTo.min.js"></script>
<script src="/js/plugins/magnific-popup.js"></script>
<script src="/js/main.js"></script>
<script>
    // TinyMCE rich text editor
    tinymce.init({
        selector: '#contentEditor',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
        height: 500,
        promotion: false,
        branding: false,
        skin: 'oxide',
        content_css: 'default',
        images_upload_url: '/api/upload-editor-image',
        automatic_uploads: true
    });

    // Image preview
    function previewImage(input) {
        const preview = document.getElementById('imagePreview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Character counter
    function updateCharCount(inputId, countId, max) {
        const el = document.getElementById(inputId);
        const countEl = document.getElementById(countId);
        const len = el.value.length;
        countEl.textContent = `${len} / ${max}`;
        countEl.className = 'char-count' + (len > max ? ' over' : '');
    }

    // Init char counts
    document.addEventListener('DOMContentLoaded', () => {
        updateCharCount('titleInput','titleCount',100);
        updateCharCount('excerptInput','excerptCount',300);
    });
</script>
</body>
</html>
