<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    
    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu,
        .dropdown .dropdown-menu.show { display: block; }
        .hotel-image { width: 80px; height: 60px; object-fit: cover; border-radius: 8px; }
        .status-badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .status-active { background: #28a745; color: #fff; }
        .status-inactive { background: #dc3545; color: #fff; }
        .featured-badge { background: #ffd700; color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .action-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
        .modal { display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); }
        .modal-content { background-color: white; margin: 15% auto; padding: 30px; border-radius: 12px; width: 90%; max-width: 500px; text-align: center; }
        .modal-buttons { display: flex; gap: 15px; justify-content: center; margin-top: 25px; }
        .confirm-delete { background: #dc3545; color: white; border: none; padding: 10px 25px; border-radius: 8px; cursor: pointer; }
        .cancel-delete { background: #6c757d; color: white; border: none; padding: 10px 25px; border-radius: 8px; cursor: pointer; }
        .mil-table { width: 100%; border-collapse: collapse; }
        .mil-table th, .mil-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .mil-table th { font-weight: 600; color: #333; }
        .mil-table-responsive { overflow-x: auto; }
        .mil-mt-30 { margin-top: 30px; }
        .text-right { text-align: right; }
        .mil-p-0-80 { padding: 0 0 80px; }
        .mil-p-80-80 { padding: 80px 0; }
        .mil-mb-30 { margin-bottom: 30px; }
        .mil-up { transition: transform 0.3s ease, opacity 0.3s ease; }
    </style>
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/superadmin/dashboard">Dashboard</a></li>
                        <li><a href="/superadmin/properties">Properties</a></li>
                        <li><a href="/superadmin/hotels" class="mil-active">Hotels</a></li>
                        <li><a href="/superadmin/promoters">Promoters</a></li>
                        <li><a href="/superadmin/property-owners">Owners</a></li>
                        <li><a href="/superadmin/transactions">Transactions</a></li>
                        <li><a href="/superadmin/inquiries">Inquiries</a></li>
                        <li><a href="/superadmin/analytics">Analytics</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown" style="position: relative;">
                        <a href="#" class="mil-btn mil-sm dropdown-toggle" data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-user-circle" style="font-size: 18px;"></i> 
                            <span><%= user.name %></span>
                            <i class="fa fa-chevron-down" style="font-size: 12px;"></i>
                        </a>
                        <ul class="dropdown-menu" style="position: absolute; right: 0; top: 100%; min-width: 220px; background: white; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); padding: 10px 0; margin-top: 10px; z-index: 1000;">
                            <li><a href="/superadmin/profile" style="display: flex; align-items: center; gap: 10px; padding: 12px 20px; color: #333; text-decoration: none;"><i class="fa fa-user" style="width: 20px; color: #03A6A6;"></i> Profile</a></li>
                            <li><a href="/superadmin/settings" style="display: flex; align-items: center; gap: 10px; padding: 12px 20px; color: #333; text-decoration: none;"><i class="fa fa-cog" style="width: 20px; color: #03A6A6;"></i> Settings</a></li>
                            <li><hr style="margin: 8px 0; border-color: #eee;"></li>
                            <li><a href="/logout" style="display: flex; align-items: center; gap: 10px; padding: 12px 20px; color: #dc3545; text-decoration: none;"><i class="fa fa-sign-out-alt" style="width: 20px;"></i> Logout</a></li>
                        </ul>
                    </div>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-60 mil-up">Hotel Management</h1>
                                <ul class="mil-breadcrumbs mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/superadmin/dashboard">Dashboard</a></li>
                                    <li>Hotels</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="mil-blog-list mil-p-0-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-3 col-md-6">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h3><%= stats.total %></h3>
                                <p>Total Hotels</p>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h3><%= stats.active %></h3>
                                <p>Active</p>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h3><%= stats.inactive %></h3>
                                <p>Inactive</p>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h3><%= stats.featured %></h3>
                                <p>Featured</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="mil-blog-list mil-p-0-40">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <a href="/superadmin/hotels/add" class="mil-btn mil-md">+ Add New Hotel</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hotels Table -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-30">All Hotels (<%= total %>)</h4>
                                <% if (hotels && hotels.length > 0) { %>
                                    <div class="mil-table-responsive">
                                        <table class="mil-table">
                                            <thead>
                                                <tr>
                                                    <th>Image</th>
                                                    <th>Name</th>
                                                    <th>Location</th>
                                                    <th>Commission</th>
                                                    <th>Status</th>
                                                    <th>Featured</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% hotels.forEach(function(hotel) { %>
                                                <tr id="hotel-row-<%= hotel._id %>">
                                                    <td>
                                                        <% if (hotel.images && hotel.images.length > 0) { %>
                                                            <img src="<%= hotel.images[0].url %>" class="hotel-image" onerror="this.src='/img/hotel-placeholder.jpg'">
                                                        <% } else { %>
                                                            <div style="width:80px;height:60px;background:#f0f0f0;border-radius:8px;"></div>
                                                        <% } %>
                                                    </td>
                                                    <td><%= hotel.name %></td>
                                                    <td><%= hotel.location.city %>, <%= hotel.location.state %></td>
                                                    <td><%= hotel.commissionRate %>%</td>
                                                    <td>
                                                        <span class="status-badge status-<%= hotel.isActive ? 'active' : 'inactive' %>">
                                                            <%= hotel.isActive ? 'Active' : 'Inactive' %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <% if (hotel.featured) { %>
                                                            <span class="featured-badge"><i class="fa fa-star"></i> Featured</span>
                                                        <% } else { %>-<% } %>
                                                    </td>
                                                    <td class="action-buttons">
                                                        <a href="/superadmin/hotels/<%= hotel._id %>/edit" class="mil-link mil-accent">Edit</a>
                                                        <button onclick="toggleStatus('<%= hotel._id %>', <%= hotel.isActive %>)" class="mil-link" style="color:#17a2b8;">
                                                            <%= hotel.isActive ? 'Deactivate' : 'Activate' %>
                                                        </button>
                                                        <button onclick="toggleFeatured('<%= hotel._id %>', <%= hotel.featured %>)" class="mil-link" style="color:#ffc107;">
                                                            <%= hotel.featured ? 'Unfeature' : 'Feature' %>
                                                        </button>
                                                        <button onclick="confirmDelete('<%= hotel._id %>', '<%= hotel.name.replace(/'/g, "\\'") %>')" class="mil-link" style="color:#dc3545;">Delete</button>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <p class="mil-text-m mil-soft mil-text-center">No hotels found. <a href="/superadmin/hotels/add">Add your first hotel</a></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6">
                                <p class="mil-text-s mil-soft">© 2026 RevaampAPA All rights reserved.</p>
                            </div>
                            <div class="col-xl-6">
                                <p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Superadmin Dashboard</p>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Delete Modal -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <i class="fa fa-exclamation-triangle" style="font-size:48px;color:#dc3545;"></i>
            <h3>Confirm Delete</h3>
            <p id="deleteMessage">Are you sure you want to delete this hotel?</p>
            <div class="modal-buttons">
                <button class="cancel-delete" onclick="closeDeleteModal()">Cancel</button>
                <button class="confirm-delete" onclick="deleteHotel()">Delete</button>
            </div>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        let hotelToDelete = null;
        
        function confirmDelete(id, name) {
            hotelToDelete = id;
            document.getElementById('deleteMessage').innerText = `Delete "${name}"? This action cannot be undone.`;
            document.getElementById('deleteModal').style.display = 'block';
        }
        
        function closeDeleteModal() {
            document.getElementById('deleteModal').style.display = 'none';
            hotelToDelete = null;
        }
        
        function deleteHotel() {
            if (!hotelToDelete) return;
            fetch(`/superadmin/hotels/${hotelToDelete}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => { 
                    if (data.success) { 
                        location.reload(); 
                    } else { 
                        alert('Error deleting hotel'); 
                    } 
                    closeDeleteModal();
                })
                .catch(err => { alert('Error deleting hotel'); closeDeleteModal(); });
        }
        
        function toggleStatus(id, current) {
            fetch(`/superadmin/hotels/${id}/toggle-status`, { method: 'POST' })
                .then(res => res.json())
                .then(data => { if (data.success) location.reload(); });
        }
        
        function toggleFeatured(id, current) {
            fetch(`/superadmin/hotels/${id}/toggle-featured`, { method: 'POST' })
                .then(res => res.json())
                .then(data => { if (data.success) location.reload(); });
        }
    </script>
</body>
</html>