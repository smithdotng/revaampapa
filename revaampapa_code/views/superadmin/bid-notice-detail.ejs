<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-table { width:100%; border-collapse:collapse; }
        .mil-table th, .mil-table td { padding:12px; text-align:left; border-bottom:1px solid #eee; }
        .mil-table th { font-weight:600; color:#333; background:#f8f9fa; }
        .mil-table-responsive { overflow-x:auto; }
        .notice-card { background:#fff; border:2px solid #03A6A6; border-radius:16px; padding:30px; margin-bottom:30px; }
        .notice-row { display:flex; justify-content:space-between; padding:12px 0; border-bottom:1px solid #f0f0f0; }
        .notice-row:last-child { border-bottom:none; }
        .notice-label { color:#666; font-size:14px; }
        .notice-value { font-weight:600; color:#333; }
        .badge { display:inline-block; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:600; }
        .badge-active { background:#d4edda; color:#155724; }
        .badge-closed { background:#f8d7da; color:#721c24; }
        .badge-pending { background:#fff3cd; color:#856404; }
        .badge-approved { background:#d4edda; color:#155724; }
        .badge-rejected { background:#f8d7da; color:#721c24; }
        .profit-highlight { color:#28a745; font-size:20px; font-weight:700; }
    </style>
</head>
<body>
<div id="smooth-wrapper" class="mil-wrapper">
    <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
    <div class="mil-progress-track"><div class="mil-progress"></div></div>
    <div class="progress-wrap active-progress"></div>

    <div class="mil-top-panel">
        <div class="container">
            <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
            <nav class="mil-top-menu">
                <ul>
                    <li><a href="/superadmin/dashboard">Dashboard</a></li>
                    <li class="mil-active"><a href="/superadmin/bid-notices">Bid Notices</a></li>
                </ul>
            </nav>
            <div class="mil-menu-buttons">
                <div class="dropdown" style="position:relative;">
                    <a href="#" class="mil-btn mil-sm dropdown-toggle"><i class="fa fa-user-circle"></i> <%= user.name %></a>
                    <ul class="dropdown-menu" style="position:absolute;right:0;top:100%;min-width:180px;background:white;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.15);padding:10px 0;margin-top:10px;z-index:1000;">
                        <li><a href="/superadmin/dashboard">Dashboard</a></li>
                        <li><hr></li>
                        <li><a href="/logout">Logout</a></li>
                    </ul>
                </div>
                <div class="mil-menu-btn"><span></span></div>
            </div>
        </div>
    </div>

    <div id="smooth-content">
        <div class="mil-banner mil-banner-inner mil-dissolve">
            <div class="container">
                <div class="row align-items-center justify-content-center">
                    <div class="col-xl-8">
                        <div class="mil-banner-text mil-text-center">
                            <h1 class="mil-mb-30 mil-up"><%= notice.transactionNumber %></h1>
                            <p class="mil-text-m mil-up" style="color:rgba(255,255,255,0.85)"><%= notice.client %></p>
                            <ul class="mil-breadcrumbs mil-center mil-up" style="margin-top:20px;">
                                <li><a href="/superadmin/bid-notices">Bid Notices</a></li>
                                <li><%= notice.transactionNumber %></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mil-blog-list mil-p-80-80">
            <div class="container">
                <% if (locals.success && success.length) { %>
                    <div style="background:#d4edda;color:#155724;padding:15px;border-radius:8px;margin-bottom:20px;"><%= success[0] %></div>
                <% } %>

                <div class="row">
                    <!-- Notice Details -->
                    <div class="col-xl-7">
                        <div class="notice-card mil-up">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                                <h3><%= notice.title %></h3>
                                <span class="badge badge-<%= notice.status %>"><%= notice.status.toUpperCase() %></span>
                            </div>

                            <p style="color:#555;margin-bottom:25px;line-height:1.7;"><%= notice.description %></p>

                            <div class="notice-row">
                                <span class="notice-label">Transaction Number</span>
                                <span class="notice-value"><%= notice.transactionNumber %></span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Client</span>
                                <span class="notice-value"><%= notice.client %></span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Total Lots Available</span>
                                <span class="notice-value"><%= notice.totalLots %> lots</span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Transaction Price per Lot</span>
                                <span class="notice-value">₦<%= notice.transactionPricePerLot.toLocaleString() %></span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Transaction Cost per Lot</span>
                                <span class="notice-value">₦<%= notice.transactionCostPerLot.toLocaleString() %></span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Profit per Lot</span>
                                <span class="profit-highlight">₦<%= notice.profitPerLot.toLocaleString() %></span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Deadline</span>
                                <span class="notice-value">
                                    <% if (notice.deadlineText) { %><%= notice.deadlineText %><% } else { %>
                                        <%= new Date(notice.deadline).toLocaleString('en-NG') %>
                                    <% } %>
                                </span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Payment Period</span>
                                <span class="notice-value"><%= notice.paymentDays %> days from notification</span>
                            </div>
                            <div class="notice-row">
                                <span class="notice-label">Payment to Bidders</span>
                                <span class="notice-value"><%= notice.paymentToPartnerDays %>th day from receipt of transaction cost</span>
                            </div>

                            <% if (notice.conditions && notice.conditions.length) { %>
                                <div style="margin-top:20px;">
                                    <h6 style="color:#03A6A6;margin-bottom:10px;">CONDITIONS FOR PARTICIPATION</h6>
                                    <ul style="list-style:disc;padding-left:20px;color:#555;">
                                        <% notice.conditions.forEach(c => { %><li><%= c %></li><% }) %>
                                    </ul>
                                </div>
                            <% } %>
                            <% if (notice.allocationCriteria && notice.allocationCriteria.length) { %>
                                <div style="margin-top:15px;">
                                    <h6 style="color:#03A6A6;margin-bottom:10px;">CRITERIA FOR ALLOCATION OF LOTS</h6>
                                    <ul style="list-style:disc;padding-left:20px;color:#555;">
                                        <% notice.allocationCriteria.forEach(c => { %><li><%= c %></li><% }) %>
                                    </ul>
                                </div>
                            <% } %>
                            <% if (notice.importantNotes && notice.importantNotes.length) { %>
                                <div style="margin-top:15px;">
                                    <h6 style="color:#dc3545;margin-bottom:10px;">IMPORTANT NOTES</h6>
                                    <ul style="list-style:disc;padding-left:20px;color:#555;">
                                        <% notice.importantNotes.forEach(n => { %><li><%= n %></li><% }) %>
                                    </ul>
                                </div>
                            <% } %>

                            <div style="margin-top:25px;display:flex;gap:10px;flex-wrap:wrap;">
                                <% if (notice.status === 'active') { %>
                                    <form action="/superadmin/bid-notices/<%= notice._id %>/close" method="POST" onsubmit="return confirm('Close this bid notice? No new bids will be accepted.')">
                                        <button type="submit" class="mil-btn mil-sm" style="background:#dc3545;">Close Bid Notice</button>
                                    </form>
                                <% } %>
                                <form action="/superadmin/bid-notices/<%= notice._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this notice and all its bids? This cannot be undone.')">
                                    <button type="submit" class="mil-btn mil-sm mil-light">Delete</button>
                                </form>
                                <a href="/superadmin/bid-notices" class="mil-btn mil-sm mil-light">← Back</a>
                            </div>
                        </div>
                    </div>

                    <!-- Bids Received -->
                    <div class="col-xl-5">
                        <div class="mil-price-card mil-up">
                            <h4 class="mil-mb-20">Bids Received (<%= bids.length %>)</h4>
                            <% if (bids.length === 0) { %>
                                <div style="text-align:center;padding:40px 20px;color:#999;">
                                    <i class="fa fa-inbox" style="font-size:40px;margin-bottom:15px;display:block;"></i>
                                    No bids yet.
                                </div>
                            <% } else { %>
                                <div class="mil-table-responsive">
                                    <table class="mil-table">
                                        <thead>
                                            <tr>
                                                <th>Partner</th>
                                                <th>Lots</th>
                                                <th>Cost</th>
                                                <th>Status</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% bids.forEach(b => { %>
                                                <tr>
                                                    <td>
                                                        <strong><%= b.bidder.name %></strong><br>
                                                        <small style="color:#999;"><%= b.bidder.email %></small>
                                                    </td>
                                                    <td><strong><%= b.numberOfLots %></strong></td>
                                                    <td>₦<%= (b.totalCost || 0).toLocaleString() %></td>
                                                    <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
                                                    <td style="font-size:12px;"><%= new Date(b.createdAt).toLocaleDateString('en-NG') %></td>
                                                </tr>
                                                <% if (b.message) { %>
                                                    <tr>
                                                        <td colspan="5" style="font-size:12px;color:#777;font-style:italic;padding-top:0;">Message: <%= b.message %></td>
                                                    </tr>
                                                <% } %>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <div style="margin-top:15px;padding:15px;background:#f8f9fa;border-radius:8px;">
                                    <strong>Total lots bid: <%= bids.reduce((s,b) => s + b.numberOfLots, 0) %></strong>
                                    / <%= notice.totalLots %> available
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mil-p-80-0">
            <div class="container"><div class="mil-footer-bottom"><p class="mil-text-s mil-soft">© 2026 RevaampAPA All rights reserved.</p></div></div>
        </footer>
    </div>
</div>
<script src="/js/plugins/jquery.min.js"></script>
<script src="/js/plugins/swiper.min.js"></script>
<script src="/js/plugins/gsap.min.js"></script>
<script src="/js/plugins/ScrollSmoother.min.js"></script>
<script src="/js/plugins/ScrollTrigger.min.js"></script>
<script src="/js/plugins/ScrollTo.min.js"></script>
<script src="/js/plugins/magnific-popup.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
