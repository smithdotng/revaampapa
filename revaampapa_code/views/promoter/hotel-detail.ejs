<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    
    <style>
        .hotel-gallery .main-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 12px;
        }
        .stat-card {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }
        .stat-number {
            font-size: 36px;
            font-weight: 700;
            color: #03A6A6;
        }
        .share-link {
            background: #f0f0f0;
            padding: 15px;
            border-radius: 8px;
            word-break: break-all;
        }
        .copy-btn {
            background: #03A6A6;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
        }
        .share-buttons {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            flex-wrap: wrap;
        }
        .share-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 8px;
            color: white;
            text-decoration: none;
        }
        .share-facebook { background: #3b5998; }
        .share-twitter { background: #1da1f2; }
        .share-whatsapp { background: #25d366; }
        .share-linkedin { background: #0077b5; }
        .recent-click {
            padding: 12px;
            border-bottom: 1px solid #eee;
        }
        .recent-click:last-child { border-bottom: none; }
        .commission-badge {
            background: #28a745;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
        }
    </style>
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/promoter/dashboard">Dashboard</a></li>
                        <li><a href="/promoter/hotels">Hotels</a></li>
                        <li><a href="/promoter/earnings">Earnings</a></li>
                        <li><a href="/promoter/profile">Profile</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown"><a href="#" class="mil-btn mil-sm dropdown-toggle"><i class="fa fa-user-circle"></i> <%= user.name %></a></div>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-60 mil-up"><%= hotel.name %></h1>
                                <ul class="mil-breadcrumbs mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/promoter/hotels">Hotels</a></li>
                                    <li><%= hotel.name %></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-8">
                            <!-- Gallery -->
                            <div class="hotel-gallery mil-mb-30">
                                <% if (hotel.images && hotel.images.length > 0) { %>
                                    <img src="<%= hotel.images[0].url %>" class="main-image" onerror="this.src='/img/hotel-placeholder.jpg'">
                                <% } else { %>
                                    <div class="main-image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-building" style="font-size: 80px; color: #ccc;"></i>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Description -->
                            <div class="mil-mb-40">
                                <h3>Description</h3>
                                <div class="mil-text-m mil-soft"><%- hotel.description %></div>
                            </div>

                            <!-- Amenities -->
                            <% if (hotel.amenities && hotel.amenities.length > 0) { %>
                            <div class="mil-mb-40">
                                <h3>Amenities</h3>
                                <div class="row">
                                    <% hotel.amenities.forEach(function(amenity) { %>
                                    <div class="col-md-4 mil-mb-10">
                                        <i class="fa fa-check-circle" style="color: #28a745;"></i> 
                                        <%= amenity.charAt(0).toUpperCase() + amenity.slice(1) %>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                            <% } %>

                            <!-- Location -->
                            <div class="mil-mb-40">
                                <h3>Location</h3>
                                <p class="mil-text-m mil-soft">
                                    <i class="fa fa-map-marker"></i> 
                                    <%= hotel.location.address ? hotel.location.address + ', ' : '' %>
                                    <%= hotel.location.city %>, <%= hotel.location.state %>, <%= hotel.location.country %>
                                </p>
                            </div>
                        </div>

                        <div class="col-xl-4">
                            <!-- Stats Card -->
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-20">Your Performance</h4>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="stat-card">
                                            <div class="stat-number"><%= stats.clicks %></div>
                                            <div class="mil-text-s mil-soft">Clicks</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-card">
                                            <div class="stat-number"><%= stats.conversions %></div>
                                            <div class="mil-text-s mil-soft">Bookings</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mil-mt-20 text-center">
                                    <span class="commission-badge"><%= hotel.commissionRate %>% Commission on Bookings</span>
                                </div>
                            </div>

                            <!-- Share Link Card -->
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-20">Your Unique Link</h4>
                                <div class="share-link">
                                    <code id="shareLink"><%= shareUrl %></code>
                                </div>
                                <div class="mil-mt-20">
                                    <button onclick="copyLink()" class="copy-btn"><i class="fa fa-copy"></i> Copy Link</button>
                                </div>
                                <div class="share-buttons">
                                    <a href="#" onclick="shareOnFacebook()" class="share-btn share-facebook"><i class="fa fa-facebook"></i> Facebook</a>
                                    <a href="#" onclick="shareOnTwitter()" class="share-btn share-twitter"><i class="fa fa-twitter"></i> Twitter</a>
                                    <a href="#" onclick="shareOnWhatsApp()" class="share-btn share-whatsapp"><i class="fa fa-whatsapp"></i> WhatsApp</a>
                                    <a href="#" onclick="shareOnLinkedIn()" class="share-btn share-linkedin"><i class="fa fa-linkedin"></i> LinkedIn</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Clicks -->
                    <% if (recentClicks && recentClicks.length > 0) { %>
                    <div class="row mil-mt-30">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-20">Recent Clicks</h4>
                                <div>
                                    <% recentClicks.forEach(function(click) { %>
                                    <div class="recent-click">
                                        <div class="row align-items-center">
                                            <div class="col-md-4">
                                                <strong><%= click.hotel ? click.hotel.name : 'Hotel' %></strong>
                                            </div>
                                            <div class="col-md-4">
                                                <small><i class="fa fa-clock-o"></i> <%= new Date(click.clickedAt).toLocaleString() %></small>
                                            </div>
                                            <div class="col-md-2">
                                                <% if (click.converted) { %>
                                                    <span class="badge badge-success">Converted</span>
                                                <% } else { %>
                                                    <span class="badge badge-secondary">Click</span>
                                                <% } %>
                                            </div>
                                            <div class="col-md-2">
                                                <small><%= click.referrer || 'Direct' %></small>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <p class="mil-text-s mil-soft">© 2026 RevaampAPA All rights reserved.</p>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .badge-success { background: #28a745; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-secondary { background: #6c757d; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .mil-mt-20 { margin-top: 20px; }
        .mil-mt-30 { margin-top: 30px; }
        .text-center { text-align: center; }
        code { font-size: 12px; word-break: break-all; }
    </style>

    <script>
        const shareUrl = '<%= shareUrl %>';
        const hotelName = '<%= hotel.name %>';
        const hotelId = '<%= hotel._id %>';
        const uniqueCode = '<%= uniqueCode %>';
        
        function copyLink() {
            const linkInput = document.getElementById('shareLink');
            const textArea = document.createElement('textarea');
            textArea.value = shareUrl;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            alert('Link copied to clipboard!');
        }
        
        function shareOnFacebook() {
            const url = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('facebook');
        }
        
        function shareOnTwitter() {
            const text = `Check out ${hotelName} on RevaampAP!`;
            const url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(shareUrl)}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('twitter');
        }
        
        function shareOnWhatsApp() {
            const text = `${hotelName} - ${shareUrl}`;
            const url = `https://wa.me/?text=${encodeURIComponent(text)}`;
            window.open(url, '_blank');
            trackShare('whatsapp');
        }
        
        function shareOnLinkedIn() {
            const url = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('linkedin');
        }
        
        function trackShare(platform) {
            fetch('/promoter/hotels/track-share', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hotelId, code: uniqueCode, platform })
            }).catch(err => console.error('Track share error:', err));
        }
    </script>
</body>
</html>