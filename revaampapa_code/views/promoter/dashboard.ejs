<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="RevaampAP" />
    <meta name="description" content="Promoter Dashboard - Track your earnings, manage promotions, referrals, and grow your business" />

    <!-- switzer font css -->
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <!-- font awesome css -->
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <!-- bootstrap grid css -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <!-- swiper css -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <!-- magnific popup -->
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <!-- plax css -->
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <!-- custom css -->
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- QRCode.js -->
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

    <!-- Favicon -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    
    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu,
        .dropdown .dropdown-menu.show { display: block; }
        .dropdown-menu li a:hover { background: #f8f9fa; padding-left: 25px; }
        .mil-table-responsive { overflow-x: auto; }
        .mil-table { width: 100%; border-collapse: collapse; }
        .mil-table th, .mil-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .mil-table th { font-weight: 600; color: #333; background: #f8f9fa; }
        .mil-xs { padding: 4px 8px; font-size: 11px; }
        .mil-flex-between { display: flex; justify-content: space-between; align-items: center; }
        .mil-mb-10 { margin-bottom: 10px; }
        .mil-mb-20 { margin-bottom: 20px; }
        .share-link-btn { cursor: pointer; transition: all 0.3s ease; background: #03A6A6; color: white; border: none; padding: 10px 15px; border-radius: 8px; font-size: 14px; width: 100%; }
        .share-link-btn:hover { transform: translateY(-2px); background: #028484; }
        .property-card { transition: transform 0.3s ease; }
        .property-card:hover { transform: translateY(-5px); }
        .badge-new { background: #28a745; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-click { background: #17a2b8; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-referral { background: #ffc107; color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-converted { background: #6c757d; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .stat-box { background: #f8f9fa; padding: 20px; border-radius: 12px; text-align: center; transition: transform 0.3s; }
        .stat-box:hover { transform: translateY(-5px); }
        .stat-number { font-size: 32px; font-weight: 700; color: #03A6A6; }
        .stat-label { font-size: 14px; color: #666; margin-top: 5px; }
        .mil-buttons-frame { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }
        .copy-btn { background: #03A6A6; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; }
        .copy-btn:hover { background: #028484; }
        .tab-buttons { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #eee; flex-wrap: wrap; }
        .tab-btn { padding: 10px 20px; background: none; border: none; cursor: pointer; font-weight: 600; color: #666; transition: all 0.3s; }
        .tab-btn.active { color: #03A6A6; border-bottom: 2px solid #03A6A6; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .referral-link-container { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .referral-link-input { flex: 1; padding: 12px; border: none; border-radius: 8px; background: rgba(255,255,255,0.15); color: white; font-size: 14px; word-break: break-all; }
        
        /* Share Modal Styles */
        .share-modal {
            display: none;
            position: fixed;
            z-index: 10001;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            align-items: center;
            justify-content: center;
        }
        .share-modal-content {
            background-color: white;
            border-radius: 16px;
            width: 90%;
            max-width: 500px;
            max-height: 80vh;
            overflow-y: auto;
            animation: modalSlideIn 0.3s ease;
        }
        @keyframes modalSlideIn {
            from { transform: translateY(-50px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .share-modal-header {
            padding: 20px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .share-modal-header h3 {
            margin: 0;
            color: #333;
        }
        .share-modal-close {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: #999;
        }
        .share-modal-close:hover {
            color: #333;
        }
        .share-modal-body {
            padding: 20px;
        }
        .share-link-box {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            word-break: break-all;
        }
        .share-link-box code {
            font-size: 12px;
            color: #03A6A6;
        }
        .share-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .share-option-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
            transition: all 0.3s ease;
            width: 100%;
        }
        .share-option-btn:hover {
            transform: translateX(5px);
        }
        .share-wa { background: #25d366; color: white; }
        .share-fb { background: #3b5998; color: white; }
        .share-twitter { background: #1da1f2; color: white; }
        .share-linkedin { background: #0077b5; color: white; }
        .share-qr { background: #03A6A6; color: white; }
        .share-copy { background: #6c757d; color: white; }
        .share-option-btn i { font-size: 20px; width: 25px; }
        .share-message-preview {
            background: #f0f0f0;
            padding: 12px;
            border-radius: 8px;
            font-size: 12px;
            color: #666;
            margin-bottom: 15px;
        }
        
        /* QR Modal Styles */
        .qr-modal {
            display: none;
            position: fixed;
            z-index: 10002;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.8);
            align-items: center;
            justify-content: center;
        }
        .qr-modal-content {
            background-color: white;
            border-radius: 20px;
            width: 90%;
            max-width: 400px;
            text-align: center;
            padding: 30px;
            animation: modalSlideIn 0.3s ease;
        }
        .qr-code-container {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            display: flex;
            justify-content: center;
        }
        .qr-download-btn {
            background: #03A6A6;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 15px;
            width: 100%;
        }
        @media (max-width: 768px) {
            .mil-table th, .mil-table td { padding: 8px; font-size: 12px; }
            .referral-link-container { flex-direction: column; }
            .referral-link-input { width: 100%; }
            .tab-buttons { justify-content: center; }
        }
    </style>
</head>

<body>

    <div id="smooth-wrapper" class="mil-wrapper">

        <div class="mil-preloader">
            <div class="mil-load"></div>
            <p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p>
        </div>

        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>

        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo">
                    <img src="/img/logo.png" alt="RevaampAP" width="83" height="32">
                </a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/properties">Properties</a></li>
                        <li class="mil-active"><a href="/promoter/dashboard">Dashboard</a></li>
                        <li><a href="/promoter/hotels">Hotels</a></li>
                        <li><a href="/promoter/earnings">Earnings</a></li>
                        <li><a href="/promoter/analytics">Analytics</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown" style="position: relative;">
                        <a href="#" class="mil-btn mil-sm dropdown-toggle" data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-user-circle" style="font-size: 18px;"></i> 
                            <span><%= user.name %></span>
                            <i class="fa fa-chevron-down" style="font-size: 12px;"></i>
                        </a>
                        <ul class="dropdown-menu" style="position: absolute; right: 0; top: 100%; min-width: 220px; background: white; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); padding: 10px 0; margin-top: 10px; z-index: 1000;">
                            <li><a href="/promoter/dashboard"><i class="fa fa-tachometer"></i> Dashboard</a></li>
                            <li><a href="/promoter/earnings"><i class="fa fa-money"></i> Earnings</a></li>
                            <li><a href="/promoter/analytics"><i class="fa fa-chart-line"></i> Analytics</a></li>
                            <li><a href="/promoter/settings"><i class="fa fa-cog"></i> Settings</a></li>
                            <li><hr></li>
                            <li><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </div>
                    <div class="mil-menu-btn">
                        <span></span>
                    </div>
                </div>
            </div>
        </div>

        <div id="smooth-content">

            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Welcome back, <%= user.name %>!</div>
                                <h1 class="mil-mb-60 mil-up">Promoter Dashboard</h1>
                                <ul class="mil-breadcrumbs mil-pub-info mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/promoter/dashboard">Dashboard</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Commission Structure Banner -->
            <div class="mil-cta mil-up">
                <div class="container">
                    <div class="mil-out-frame mil-p-80-80" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-xl-12 mil-text-center">
                                <h2 class="mil-light mil-mb-30 mil-up">Your Commission Structure</h2>
                                <p class="mil-text-m mil-dark-soft mil-up">Earn up to 90% commission on property sales. Multiple income streams including property introductions (40%), buyer referrals (90%+50%), hotel onboarding (30%), and business partner referrals (₦10,000). Start earning today!</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Commission Structure Banner End -->

            <!-- ============= REFERRAL LINK SECTION ============= -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-10">
                            <div class="mil-price-card mil-up mil-mb-30" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                <div class="mil-text-center">
                                    <i class="fa fa-users" style="font-size: 60px; color: white; margin-bottom: 20px;"></i>
                                    <h2 class="mil-light mil-mb-15">Invite & Earn Residual Income!</h2>
                                    <p class="mil-dark-soft mil-mb-30" style="color: rgba(255,255,255,0.9);">
                                        Share your unique referral link to invite friends to become promoters. 
                                        <strong>Earn 70% of administrative fee</strong> every time your referred promoter earns!
                                    </p>
                                    <div class="referral-link-container" style="background: rgba(255,255,255,0.15); border-radius: 12px; padding: 20px; margin-bottom: 25px;">
                                        <input type="text" id="referralLinkInput" class="referral-link-input" value="Generating link..." readonly>
                                        <button class="mil-btn mil-sm mil-light" onclick="generateAndCopyReferralLink()" style="white-space: nowrap;">
                                            <i class="fa fa-copy"></i> Generate & Copy
                                        </button>
                                    </div>
                                    <div class="mil-buttons-frame">
                                        <button class="mil-btn mil-md mil-light" onclick="shareOnWhatsApp()">
                                            <i class="fa fa-whatsapp"></i> Share on WhatsApp
                                        </button>
                                        <button class="mil-btn mil-md mil-light" onclick="shareOnFacebook()">
                                            <i class="fa fa-facebook"></i> Share on Facebook
                                        </button>
                                        <button class="mil-btn mil-md mil-light" onclick="shareOnTwitter()">
                                            <i class="fa fa-twitter"></i> Share on Twitter
                                        </button>
                                        <button class="mil-btn mil-md mil-light" onclick="showQRCodeForReferral()">
                                            <i class="fa fa-qrcode"></i> Share QR Code
                                        </button>
                                    </div>
                                    <div class="mil-mt-20">
                                        <small style="color: rgba(255,255,255,0.7);">
                                            <i class="fa fa-info-circle"></i> Each click on your link is tracked. You earn 70% commission when your referral registers and starts earning!
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ============= REFERRAL LINK SECTION END ============= -->
            
            <!-- All Properties Section - Promotable Properties -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="mil-text-center">
                        <h2 class="mil-mb-30 mil-up">Properties Available for Promotion</h2>
                        <p class="mil-text-m mil-soft mil-mb-60 mil-up">Click "Share Link" on any property to get your unique referral link and share it on social media!</p>
                    </div>
                    <div class="row" id="propertiesGrid">
                        <% if (typeof properties !== 'undefined' && properties && properties.length > 0) { %>
                            <% properties.forEach(function(property) { %>
                                <div class="col-xl-4 col-md-6 mil-mb-30">
                                    <div class="mil-price-card mil-up property-card" style="height: 100%;">
                                        <div class="property-image" style="position: relative; overflow: hidden; border-radius: 15px; margin-bottom: 20px;">
                                            <% if(property.images && property.images.length > 0) { %>
                                                <img src="<%= property.images[0].url %>" alt="<%= property.title %>" style="width: 100%; height: 220px; object-fit: cover;">
                                            <% } else { %>
                                                <img src="/img/property-placeholder.jpg" alt="<%= property.title %>" style="width: 100%; height: 220px; object-fit: cover;">
                                            <% } %>
                                            <div class="property-badges" style="position: absolute; top: 10px; left: 10px;">
                                                <span class="mil-badge" style="background: #28a745; color: white; padding: 4px 10px; border-radius: 5px; font-size: 11px;">✓ Verified</span>
                                            </div>
                                        </div>
                                        <div class="property-content">
                                            <div class="mil-flex-between mil-mb-10">
                                                <h5 class="property-price" style="color: #03A6A6;">₦<%= property.price ? property.price.toLocaleString() : '0' %></h5>
                                                <span class="mil-text-xs mil-soft"><%= property.transactionType === 'sale' ? 'For Sale' : 'For Rent' %></span>
                                            </div>
                                            <h4 class="property-title mil-mb-10"><%= property.title %></h4>
                                            <p class="mil-text-s mil-soft mil-mb-15"><i class="fa fa-map-marker"></i> <%= property.location ? property.location.city + ', ' + property.location.state : 'Location TBD' %></p>
                                            <div class="property-features mil-flex-between mil-mb-20">
                                                <div class="feature-item"><i class="fa fa-bed"></i> <span><%= property.features && property.features.bedrooms ? property.features.bedrooms : '0' %> beds</span></div>
                                                <div class="feature-item"><i class="fa fa-bath"></i> <span><%= property.features && property.features.bathrooms ? property.features.bathrooms : '0' %> baths</span></div>
                                                <div class="feature-item"><i class="fa fa-car"></i> <span><%= property.features && property.features.parkingSpaces ? property.features.parkingSpaces : '0' %> parking</span></div>
                                            </div>
                                            <div class="property-footer">
                                                <button class="share-link-btn" onclick="openShareModal('<%= property._id %>', '<%= property.title.replace(/'/g, "\\'") %>')">
                                                    <i class="fa fa-share-alt"></i> Share Link
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-xl-12">
                                <div class="mil-price-card mil-up mil-text-center" style="padding: 60px 20px;">
                                    <i class="fa fa-building-o" style="font-size: 60px; opacity: 0.3; margin-bottom: 20px;"></i>
                                    <h3 class="mil-mb-15">No Properties Available</h3>
                                    <p class="mil-text-m mil-soft mil-mb-30">Check back soon for new properties to promote!</p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <!-- All Properties End -->

            <!-- Share Modal -->
            <div id="shareModal" class="share-modal">
                <div class="share-modal-content">
                    <div class="share-modal-header">
                        <h3><i class="fa fa-share-alt"></i> Share Property</h3>
                        <button class="share-modal-close" onclick="closeShareModal()">&times;</button>
                    </div>
                    <div class="share-modal-body">
                        <div id="sharePropertyTitle" style="font-weight: 600; margin-bottom: 15px; color: #03A6A6;"></div>
                        <div class="share-link-box">
                            <code id="sharePropertyLink">Loading...</code>
                        </div>
                        <div class="share-message-preview" id="shareMessagePreview"></div>
                        <div class="share-options">
                            <button class="share-option-btn share-wa" onclick="shareToWhatsApp()">
                                <i class="fa fa-whatsapp"></i> Share on WhatsApp
                            </button>
                            <button class="share-option-btn share-fb" onclick="shareToFacebook()">
                                <i class="fa fa-facebook"></i> Share on Facebook
                            </button>
                            <button class="share-option-btn share-twitter" onclick="shareToTwitter()">
                                <i class="fa fa-twitter"></i> Share on Twitter
                            </button>
                            <button class="share-option-btn share-linkedin" onclick="shareToLinkedIn()">
                                <i class="fa fa-linkedin"></i> Share on LinkedIn
                            </button>
                            <button class="share-option-btn share-qr" onclick="showQRCodeForProperty()">
                                <i class="fa fa-qrcode"></i> Generate QR Code
                            </button>
                            <button class="share-option-btn share-copy" onclick="copyShareLink()">
                                <i class="fa fa-copy"></i> Copy Link
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- QR Code Modal -->
            <div id="qrModal" class="qr-modal">
                <div class="qr-modal-content">
                    <h3><i class="fa fa-qrcode"></i> Scan QR Code</h3>
                    <div class="qr-code-container" id="qrCodeContainer"></div>
                    <p id="qrDescription" style="margin: 10px 0; color: #666;">Scan to view this property</p>
                    <button class="qr-download-btn" onclick="downloadQRCode()">
                        <i class="fa fa-download"></i> Download QR Code
                    </button>
                    <button class="share-option-btn share-wa" style="margin-top: 10px;" onclick="shareQRCode()">
                        <i class="fa fa-whatsapp"></i> Share QR Code
                    </button>
                    <button class="share-modal-close" style="margin-top: 15px; background: none; border: none; color: #999; cursor: pointer;" onclick="closeQRModal()">Close</button>
                </div>
            </div>

            <!-- ============= PROMOTIONS & REFERRALS TABS ============= -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <div class="tab-buttons">
                                    <button class="tab-btn active" onclick="showTab('promotions')">🏠 Active Promotions (Properties)</button>
                                    <button class="tab-btn" onclick="showTab('referrals')">👥 Promoters Onboarded</button>
                                    <button class="tab-btn" onclick="showTab('clicks')">📊 Clicks & Activity</button>
                                    <button class="tab-btn" onclick="showTab('conversions')">💰 Conversions</button>
                                </div>

                                <!-- Promotions Tab (Properties) -->
                                <div id="promotionsTab" class="tab-content active">
                                    <h4 class="mil-mb-20">Your Active Property Promotions</h4>
                                    <div id="promotionsList">
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Referrals Tab (Promoters Onboarded) -->
                                <div id="referralsTab" class="tab-content">
                                    <h4 class="mil-mb-20">Promoters You've Onboarded</h4>
                                    
                                    <!-- Summary Stats for Referrals -->
                                    <div class="row mil-mb-30">
                                        <div class="col-md-4">
                                            <div class="stat-box" style="padding: 15px;">
                                                <div class="stat-number" id="referralClicksCount">0</div>
                                                <div class="stat-label">Referral Link Clicks</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="stat-box" style="padding: 15px;">
                                                <div class="stat-number" id="totalReferralsCount">0</div>
                                                <div class="stat-label">Promoters Onboarded</div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="stat-box" style="padding: 15px;">
                                                <div class="stat-number" id="referralEarningsCount">₦0</div>
                                                <div class="stat-label">Earnings from Referrals</div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div id="referralsTable">
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Clicks Tab -->
                                <div id="clicksTab" class="tab-content">
                                    <h4 class="mil-mb-20">Recent Clicks on Your Promotions</h4>
                                    <div id="clicksTable">
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
