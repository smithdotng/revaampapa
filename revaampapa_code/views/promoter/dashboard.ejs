    <script>
        let referralLink = null;
        let currentSharePropertyId = null;
        let currentSharePropertyTitle = null;
        let currentSharePropertyLink = null;
        let currentQRCode = null;

        // Tab switching
        function showTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`${tabName}Tab`).classList.add('active');
            event.target.classList.add('active');
            
            if (tabName === 'promotions') loadPromotions();
            if (tabName === 'referrals') loadReferrals();
            if (tabName === 'clicks') loadClicks();
            if (tabName === 'conversions') loadConversions();
        }

        // Generate and copy referral link
        async function generateAndCopyReferralLink() {
            try {
                const response = await fetch('/promoter/api/generate-referral-link');
                const data = await response.json();
                if (data.success) {
                    referralLink = data.link;
                    const inputField = document.getElementById('referralLinkInput');
                    inputField.value = referralLink;
                    inputField.select();
                    document.execCommand('copy');
                    alert('Referral link generated and copied to clipboard!');
                    await trackShare('copy', 'referral');
                } else {
                    alert('Error generating referral link.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error generating referral link.');
            }
        }

        // Load existing referral link
        async function loadReferralLink() {
            try {
                const response = await fetch('/promoter/api/generate-referral-link');
                const data = await response.json();
                if (data.success) {
                    referralLink = data.link;
                    document.getElementById('referralLinkInput').value = referralLink;
                }
            } catch (error) {
                console.error('Error loading referral link:', error);
            }
        }

        // Share functions for referral link
        async function shareOnWhatsApp() {
            if (!referralLink) {
                alert('Please generate your referral link first.');
                return;
            }
            const message = `Become a promoter using my referral link: ${referralLink} and earn up to 90% commission on property sales. Multiple income streams including property introductions (40%), buyer referrals (90%+50%), hotel onboarding (30%), and business partner referrals (₦10,000). Start earning today!`;
            window.open(`https://wa.me/?text=${encodeURIComponent(message)}`, '_blank');
            await trackShare('whatsapp', 'referral');
        }

        async function shareOnFacebook() {
            if (!referralLink) {
                alert('Please generate your referral link first.');
                return;
            }
            window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(referralLink)}`, '_blank', 'width=600,height=400');
            await trackShare('facebook', 'referral');
        }

        async function shareOnTwitter() {
            if (!referralLink) {
                alert('Please generate your referral link first.');
                return;
            }
            const text = `Become a promoter using my referral link and earn up to 90% commission on property sales!`;
            window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(referralLink)}`, '_blank', 'width=600,height=400');
            await trackShare('twitter', 'referral');
        }

        // Show QR Code for Referral Link
        function showQRCodeForReferral() {
            if (!referralLink) {
                alert('Please generate your referral link first.');
                return;
            }
            const modal = document.getElementById('qrModal');
            const container = document.getElementById('qrCodeContainer');
            const description = document.getElementById('qrDescription');
            
            container.innerHTML = '';
            description.innerHTML = 'Scan to join as a promoter and start earning!';
            
            new QRCode(container, {
                text: referralLink,
                width: 200,
                height: 200,
                colorDark: '#03A6A6',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.H
            });
            
            currentQRCode = referralLink;
            modal.style.display = 'flex';
        }

        // Property Share Functions
        async function openShareModal(propertyId, propertyTitle) {
            currentSharePropertyId = propertyId;
            currentSharePropertyTitle = propertyTitle;
            
            document.getElementById('sharePropertyTitle').innerHTML = `<i class="fa fa-home"></i> ${propertyTitle}`;
            document.getElementById('shareModal').style.display = 'flex';
            
            document.getElementById('sharePropertyLink').innerHTML = 'Generating link...';
            document.getElementById('shareMessagePreview').innerHTML = 'Loading...';
            
            try {
                const response = await fetch(`/promoter/api/promotion/${propertyId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                if (data.success) {
                    currentSharePropertyLink = data.promotion.referralLink;
                    document.getElementById('sharePropertyLink').innerHTML = currentSharePropertyLink;
                    
                    const shareMessage = `🏠 Check out this amazing property: ${propertyTitle}\n\n🔗 View details: ${currentSharePropertyLink}\n\nShare and earn commission!`;
                    document.getElementById('shareMessagePreview').innerHTML = shareMessage.substring(0, 150) + (shareMessage.length > 150 ? '...' : '');
                } else {
                    document.getElementById('sharePropertyLink').innerHTML = 'Error generating link. Please try again.';
                }
            } catch (error) {
                console.error('Error generating property link:', error);
                document.getElementById('sharePropertyLink').innerHTML = 'Error generating link.';
            }
        }

        function closeShareModal() {
            document.getElementById('shareModal').style.display = 'none';
            currentSharePropertyId = null;
            currentSharePropertyTitle = null;
            currentSharePropertyLink = null;
        }

        function shareToWhatsApp() {
            if (!currentSharePropertyLink) return;
            const message = `🏠 Check out this property: ${currentSharePropertyTitle}\n\n🔗 View details: ${currentSharePropertyLink}\n\nShare and earn commission!`;
            window.open(`https://wa.me/?text=${encodeURIComponent(message)}`, '_blank');
            trackPropertyShare('whatsapp');
            closeShareModal();
        }

        function shareToFacebook() {
            if (!currentSharePropertyLink) return;
            window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentSharePropertyLink)}`, '_blank', 'width=600,height=400');
            trackPropertyShare('facebook');
            closeShareModal();
        }

        function shareToTwitter() {
            if (!currentSharePropertyLink) return;
            const text = `Check out this property: ${currentSharePropertyTitle}`;
            window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(currentSharePropertyLink)}`, '_blank', 'width=600,height=400');
            trackPropertyShare('twitter');
            closeShareModal();
        }

        function shareToLinkedIn() {
            if (!currentSharePropertyLink) return;
            window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentSharePropertyLink)}`, '_blank', 'width=600,height=400');
            trackPropertyShare('linkedin');
            closeShareModal();
        }

        function copyShareLink() {
            if (!currentSharePropertyLink) return;
            navigator.clipboard.writeText(currentSharePropertyLink);
            alert('Link copied to clipboard!');
            trackPropertyShare('copy');
            closeShareModal();
        }

        // Show QR Code for Property
        function showQRCodeForProperty() {
            if (!currentSharePropertyLink) {
                alert('Please generate the property link first.');
                return;
            }
            const modal = document.getElementById('qrModal');
            const container = document.getElementById('qrCodeContainer');
            const description = document.getElementById('qrDescription');
            
            container.innerHTML = '';
            description.innerHTML = `Scan to view ${currentSharePropertyTitle}`;
            
            new QRCode(container, {
                text: currentSharePropertyLink,
                width: 200,
                height: 200,
                colorDark: '#03A6A6',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.H
            });
            
            currentQRCode = currentSharePropertyLink;
            modal.style.display = 'flex';
            closeShareModal();
        }

        function closeQRModal() {
            document.getElementById('qrModal').style.display = 'none';
            currentQRCode = null;
        }

        function downloadQRCode() {
            if (!currentQRCode) return;
            const canvas = document.querySelector('#qrCodeContainer canvas');
            if (canvas) {
                const link = document.createElement('a');
                link.download = 'qrcode.png';
                link.href = canvas.toDataURL();
                link.click();
            }
        }

        function shareQRCode() {
            if (!currentQRCode) return;
            const message = `Check this out on RevaampAP!\n\nScan the QR code or visit: ${currentQRCode}`;
            window.open(`https://wa.me/?text=${encodeURIComponent(message)}`, '_blank');
        }

        async function trackPropertyShare(platform) {
            try {
                await fetch('/promoter/api/track-share', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        platform, 
                        link: currentSharePropertyLink, 
                        linkType: 'property',
                        propertyId: currentSharePropertyId
                    })
                });
            } catch (error) {
                console.error('Error tracking share:', error);
            }
        }

        async function trackShare(platform, linkType) {
            try {
                await fetch('/promoter/api/track-share', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ platform, link: referralLink, linkType })
                });
            } catch (error) {
                console.error('Error tracking share:', error);
            }
        }

        // Load promotions (property links)
        async function loadPromotions() {
            try {
                const response = await fetch('/promoter/api/promotions');
                const data = await response.json();
                const container = document.getElementById('promotionsList');
                
                if (data.success && data.promotions && data.promotions.length > 0) {
                    container.innerHTML = `
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead>
                                    <tr><th>Property</th><th>Referral Link</th><th>Clicks</th><th>Interests</th><th>Created</th><th>Actions</th></tr>
                                </thead>
                                <tbody>
                                    ${data.promotions.map(promo => `
                                        <tr>
                                            <td>${promo.property?.title || 'N/A'}</td>
                                            <td><code style="font-size: 11px; word-break: break-all;">${promo.referralLink}</code>
                                                <button class="mil-btn mil-xs" onclick="copyToClipboard('${promo.referralLink}')"><i class="fa fa-copy"></i></button>
                                            </td>
                                            <td>${promo.clicks || 0}</td>
                                            <td>${promo.inquiries || 0}</td>
                                            <td>${new Date(promo.createdAt).toLocaleDateString()}</td>
                                            <td><button class="mil-btn mil-xs mil-accent" onclick="openShareModal('${promo.property?._id}', '${promo.property?.title}')"><i class="fa fa-share-alt"></i> Share</button></td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="text-center py-4"><p>No active promotions yet. Click "Share Link" on any property to get started!</p></div>';
                }
            } catch (error) {
                console.error('Error loading promotions:', error);
                document.getElementById('promotionsList').innerHTML = '<div class="text-center py-4"><p>Error loading promotions.</p></div>';
            }
        }

        // Load referrals (promoters onboarded)
        async function loadReferrals() {
            try {
                const response = await fetch('/promoter/api/referrals');
                const data = await response.json();
                const container = document.getElementById('referralsTable');
                
                if (data.success && data.referrals && data.referrals.length > 0) {
                    container.innerHTML = `
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead>
                                    <td><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Registered</th><th>Earnings</th></tr>
                                </thead>
                                <tbody>
                                    ${data.referrals.map(ref => `
                                        <tr>
                                            <td>${ref.name || 'N/A'}</td>
                                            <td>${ref.email}</td>
                                            <td>${ref.phone || 'N/A'}</td>
                                            <td>${ref.isApproved ? '<span class="badge-new">Approved</span>' : '<span class="badge-click">Pending</span>'}</td>
                                            <td>${new Date(ref.createdAt).toLocaleDateString()}</td>
                                            <td>₦${(ref.earningsFromReferral || 0).toLocaleString()}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="text-center py-4"><p>No referrals yet. Share your referral link to invite others!</p></div>';
                }
                
                document.getElementById('referralClicksCount').innerText = data.stats?.totalClicks || 0;
                document.getElementById('totalReferralsCount').innerText = data.stats?.totalReferrals || 0;
                document.getElementById('referralEarningsCount').innerHTML = `₦${(data.stats?.totalEarnings || 0).toLocaleString()}`;
                
            } catch (error) {
                console.error('Error loading referrals:', error);
                document.getElementById('referralsTable').innerHTML = '<div class="text-center py-4"><p>Error loading referrals data.</p></div>';
            }
        }

        // Load clicks
        async function loadClicks() {
            try {
                const response = await fetch('/promoter/api/clicks');
                const data = await response.json();
                const container = document.getElementById('clicksTable');
                
                if (data.success && data.clicks && data.clicks.length > 0) {
                    container.innerHTML = `
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead><tr><th>Item</th><th>Type</th><th>IP</th><th>Device</th><th>Clicked At</th><th>Status</th></td></thead>
                                <tbody>
                                    ${data.clicks.map(click => `
                                        <tr>
                                            <td>${click.itemTitle || 'N/A'}</td>
                                            <td><span class="badge-click">${click.type || 'Property'}</span></td>
                                            <td><code>${click.ipAddress || 'N/A'}</code></td>
                                            <td><small>${click.deviceInfo || 'N/A'}</small></td>
                                            <td>${new Date(click.clickedAt).toLocaleString()}</td>
                                            <td>${click.converted ? '<span class="badge-new">Converted</span>' : '<span class="badge-click">Clicked</span>'}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="text-center py-4"><p>No clicks recorded yet.</p></div>';
                }
            } catch (error) {
                console.error('Error loading clicks:', error);
                document.getElementById('clicksTable').innerHTML = '<div class="text-center py-4"><p>Error loading clicks data.</p></div>';
            }
        }

        // Load conversions
        async function loadConversions() {
            try {
                const response = await fetch('/promoter/api/conversions');
                const data = await response.json();
                const container = document.getElementById('conversionsTable');
                
                if (data.success && data.conversions && data.conversions.length > 0) {
                    container.innerHTML = `
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead><td><th>Item</th><th>Buyer</th><th>Email</th><th>Amount</th><th>Commission</th><th>Date</th></tr></thead>
                                <tbody>
                                    ${data.conversions.map(conv => `
                                        <tr>
                                            <td>${conv.itemTitle || 'N/A'}</td>
                                            <td>${conv.buyerName || 'N/A'}</td>
                                            <td>${conv.buyerEmail || 'N/A'}</td>
                                            <td>₦${(conv.amount || 0).toLocaleString()}</td>
                                            <td>₦${(conv.commission || 0).toLocaleString()}</td>
                                            <td>${new Date(conv.createdAt).toLocaleDateString()}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="text-center py-4"><p>No conversions yet. Keep sharing your links!</p></div>';
                }
            } catch (error) {
                console.error('Error loading conversions:', error);
                document.getElementById('conversionsTable').innerHTML = '<div class="text-center py-4"><p>Error loading conversions data.</p></div>';
            }
        }

        // Helper functions
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => alert('Link copied!'), () => alert('Failed to copy'));
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const shareModal = document.getElementById('shareModal');
            const qrModal = document.getElementById('qrModal');
            if (event.target === shareModal) {
                closeShareModal();
            }
            if (event.target === qrModal) {
                closeQRModal();
            }
        }

        // Newsletter subscription
        function initNewsletter() {
            const form = document.getElementById('footerNewsletterForm');
            if (form) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const email = form.querySelector('input[type="email"]').value;
                    try {
                        const response = await fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
                        const data = await response.json();
                        alert(data.success ? 'Subscribed!' : 'Error.');
                        if (data.success) form.reset();
                    } catch (error) { console.error('Error:', error); alert('Error.'); }
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadReferralLink();
            loadPromotions();
            loadReferrals();
            loadClicks();
            loadConversions();
            initNewsletter();
        });
    </script>
</body>

</html>