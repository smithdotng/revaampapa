<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <!-- Top Panel -->
        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li class="mil-active"><a href="/architect/dashboard">Dashboard</a></li>
                        <li><a href="/architect/assessment/new">New Assessment</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown" style="position: relative;">
                        <a href="#" class="mil-btn mil-sm dropdown-toggle" data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-user-circle"></i>
                            <span><%= user.name %></span>
                            <i class="fa fa-chevron-down"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </div>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Project Management Solution &mdash; Verification Phase</div>
                                <h1 class="mil-mb-30 mil-up">Welcome, <%= user.name %></h1>
                                <p class="mil-text-m mil-soft mil-up">REVAAMP Partner Architect &mdash; <%= user.firm %></p>
                                <% if (!user.architectProfile || !user.architectProfile.isActive) { %>
                                    <p class="mil-text-s mil-up" style="color:#e67e22;"><i class="fa fa-clock"></i> Your account is pending approval.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="mil-p-80-40">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-4 col-md-6 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center">
                                <i class="fa fa-file-signature" style="font-size:40px;color:#03A6A6;"></i>
                                <h3 class="mil-mb-5 mil-mt-15"><%= stats.assessmentsSubmitted %></h3>
                                <p class="mil-text-s mil-soft">Assessments Submitted</p>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-6 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center">
                                <i class="fa fa-check-circle" style="font-size:40px;color:#28a745;"></i>
                                <h3 class="mil-mb-5 mil-mt-15"><%= stats.projectsVerified %></h3>
                                <p class="mil-text-s mil-soft">Projects Verified</p>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-12 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="display:flex;flex-direction:column;justify-content:center;height:100%;">
                                <a href="/architect/assessment/new" class="mil-btn mil-md mil-fw"><i class="fa fa-plus"></i> New Structural Assessment</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Assessments table -->
            <div class="mil-p-0-80">
                <div class="container">
                    <div class="mil-price-card mil-up mil-mb-30">
                        <h4 class="mil-mb-30">My Structural Assessment Reports</h4>

                        <% if (assessments && assessments.length > 0) { %>
                            <div class="mil-table-responsive">
                                <table class="mil-table">
                                    <thead>
                                        <tr><th>Project</th><th>Location</th><th>Integrity</th><th>Recommendation</th><th>Status</th><th>Submitted</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        <% assessments.forEach(function(a) { %>
                                            <tr>
                                                <td><strong><%= a.projectTitle %></strong></td>
                                                <td><%= a.projectLocation || 'N/A' %></td>
                                                <td><%= (a.structuralIntegrityRating || '').replace(/_/g,' ') %></td>
                                                <td><%= (a.recommendation || '').replace(/_/g,' ') %></td>
                                                <td><%= (a.status || '').replace(/_/g,' ') %></td>
                                                <td><%= new Date(a.submittedAt || a.createdAt).toLocaleDateString() %></td>
                                                <td><a href="/architect/assessment/<%= a._id %>" class="mil-btn mil-sm">View</a></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="mil-text-center mil-p-60">
                                <i class="fa fa-drafting-compass" style="font-size: 64px; color: #03A6A6;"></i>
                                <h4 class="mil-mt-30">No Assessment Reports Yet</h4>
                                <p class="mil-text-m mil-soft">Submit your first structural assessment of a proposed project.</p>
                                <a href="/architect/assessment/new" class="mil-btn mil-md mil-mt-15"><i class="fa fa-plus"></i> New Structural Assessment</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Architect Dashboard</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-fw { width: 100%; }
        .mil-p-80-40 { padding: 80px 0 40px; }
        .mil-p-0-80 { padding: 0 0 80px; }
        .mil-p-60 { padding: 60px; }
        .mil-table { width: 100%; text-transform: capitalize; }
    </style>
</body>

</html>
