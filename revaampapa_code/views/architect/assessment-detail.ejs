<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/architect/dashboard">Dashboard</a></li>
                        <li><a href="/architect/assessment/new">New Assessment</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <a href="/architect/dashboard" class="mil-btn mil-sm"><i class="fa fa-arrow-left"></i> Back</a>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success alert-dismissible fade show m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;">
                <i class="fas fa-check-circle"></i> <%= success %>
            </div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Structural Assessment Report</div>
                                <h1 class="mil-mb-15 mil-up"><%= assessment.projectTitle %></h1>
                                <p class="mil-text-m mil-soft mil-up">
                                    Status: <strong style="text-transform:capitalize;"><%= (assessment.status || '').replace(/_/g,' ') %></strong>
                                    &nbsp;|&nbsp; Submitted <%= new Date(assessment.submittedAt || assessment.createdAt).toLocaleDateString() %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-price-card mil-mb-30">
                                <h4 class="mil-mb-15">Project Details</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <p><strong>Location:</strong> <%= assessment.projectLocation || 'N/A' %></p>
                                <p><strong>Promoter:</strong> <%= assessment.promoterName || 'N/A' %></p>
                                <p><strong>Proposed use:</strong> <%= assessment.proposedUse || 'N/A' %></p>

                                <h4 class="mil-mb-15 mil-mt-30">Assessment Verdict</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <p style="text-transform:capitalize;"><strong>Structural integrity:</strong> <%= (assessment.structuralIntegrityRating || '').replace(/_/g,' ') %></p>
                                <p style="text-transform:capitalize;"><strong>Recommendation:</strong> <%= (assessment.recommendation || '').replace(/_/g,' ') %></p>
                                <% if (assessment.conditions) { %><p><strong>Conditions:</strong> <%= assessment.conditions %></p><% } %>

                                <h4 class="mil-mb-15 mil-mt-30">Findings</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <%
                                    var sections = [
                                        ['Site conditions', assessment.siteConditions],
                                        ['Soil / foundation assessment', assessment.foundationAssessment],
                                        ['Structural design review', assessment.structuralDesignReview],
                                        ['Materials assessment', assessment.materialsAssessment],
                                        ['Load-bearing evaluation', assessment.loadBearingEvaluation],
                                        ['Compliance with codes', assessment.complianceWithCodes],
                                        ['Identified risks', assessment.identifiedRisks],
                                        ['Recommendations', assessment.recommendations],
                                        ['Additional remarks', assessment.remarks]
                                    ];
                                %>
                                <% sections.forEach(function(s) { if (s[1]) { %>
                                    <p class="mil-mb-15"><strong><%= s[0] %>:</strong><br><%= s[1] %></p>
                                <% } }); %>

                                <% if (assessment.supportingDocuments && assessment.supportingDocuments.length) { %>
                                    <h4 class="mil-mb-15 mil-mt-30">Supporting Documents</h4>
                                    <div class="mil-divider mil-mb-30"></div>
                                    <ul>
                                        <% assessment.supportingDocuments.forEach(function(doc) { %>
                                            <li><a href="<%= doc.url %>" target="_blank" class="mil-accent"><i class="fa fa-file-alt"></i> <%= doc.name || 'Document' %></a></li>
                                        <% }); %>
                                    </ul>
                                <% } %>

                                <div class="mil-mt-30">
                                    <a href="/architect/dashboard" class="mil-btn mil-md">Back to Dashboard</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Architect Dashboard</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .mil-mt-30 { margin-top: 30px; }
        .mil-mb-15 { margin-bottom: 15px; }
        .mil-mb-30 { margin-bottom: 30px; }
        .mil-divider { height: 1px; background: #e0e0e0; margin: 15px 0; }
    </style>
</body>

</html>
