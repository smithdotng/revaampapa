<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <%- include('../partials/voucher-nav', { user: user, active: 'dashboard' }) %>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-exclamation-circle"></i> <%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-check-circle"></i> <%= success %></div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Revaamp Room Voucher</div>
                                <h1 class="mil-mb-30 mil-up">Welcome, <%= user.name %></h1>
                                <p class="mil-text-m mil-soft mil-up">Membership <strong><%= user.subscriberCode %></strong></p>
                                <% var sub = user.subscription || {}; %>
                                <% if (user.hasActiveSubscription && user.hasActiveSubscription()) { %>
                                    <p class="mil-text-s mil-up" style="color:#28a745;"><i class="fa fa-check-circle"></i> Subscription active<% if (sub.expiresAt) { %> until <%= new Date(sub.expiresAt).toLocaleDateString() %><% } %></p>
                                <% } else if (user.isSuspended) { %>
                                    <p class="mil-text-s mil-up" style="color:#dc3545;"><i class="fa fa-ban"></i> Subscription suspended<%= user.suspensionReason ? ' — ' + user.suspensionReason : '' %></p>
                                <% } else { %>
                                    <p class="mil-text-s mil-up" style="color:#e67e22;"><i class="fa fa-clock"></i> Subscription <%= sub.status || 'pending' %> — you can browse, but stays cannot be registered until it is active</p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if (!(user.hasActiveSubscription && user.hasActiveSubscription())) { %>
            <div class="mil-p-80-40">
                <div class="container">
                    <div class="mil-price-card mil-up" style="border-left:5px solid #e67e22;">
                        <h4 class="mil-mb-15"><i class="fa fa-hourglass-half" style="color:#e67e22;"></i> Your subscription is not active yet</h4>
                        <p class="mil-text-m mil-soft mil-mb-0">Our team activates subscriptions after the paperwork is confirmed, and we will email you the moment it is live. Until then you can browse listed hotels, but a stay registered now would not be claimable.</p>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Stats -->
            <div class="mil-p-80-40">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-calendar-check-o" style="font-size:36px;color:#6C2BD9;"></i>
                                <h3 class="mil-mb-5 mil-mt-15"><%= stats.upcoming %></h3>
                                <p class="mil-text-s mil-soft">Upcoming stays</p>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-moon-o" style="font-size:36px;color:#03A6A6;"></i>
                                <h3 class="mil-mb-5 mil-mt-15"><%= stats.nights %></h3>
                                <p class="mil-text-s mil-soft">Nights registered</p>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-hourglass-half" style="font-size:36px;color:#e67e22;"></i>
                                <h3 class="mil-mb-5 mil-mt-15">&#8358;<%= (stats.cashbackPending + stats.cashbackApproved).toLocaleString() %></h3>
                                <p class="mil-text-s mil-soft">Cashback owing</p>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-money" style="font-size:36px;color:#28a745;"></i>
                                <h3 class="mil-mb-5 mil-mt-15">&#8358;<%= stats.cashbackPaid.toLocaleString() %></h3>
                                <p class="mil-text-s mil-soft">Cashback paid out</p>
                            </div>
                        </div>
                    </div>

                    <div class="mil-price-card mil-up mil-mb-30" style="background: linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%);">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h5 class="mil-light mil-mb-10">Planning a stay?</h5>
                                <p class="mil-text-s mil-mb-0" style="color:rgba(255,255,255,0.85);">Register it against the hotel listing <strong>before you check in</strong>. That registration is your claim &mdash; cashback cannot be applied afterwards.</p>
                            </div>
                            <div class="col-md-4 mil-text-right">
                                <a href="/hotels?voucher=1" class="mil-btn mil-md mil-light"><i class="fa fa-search"></i> Browse listed hotels</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent reservations -->
            <div class="mil-p-0-80">
                <div class="container">
                    <div class="mil-price-card mil-up">
                        <div class="row align-items-center mil-mb-30">
                            <div class="col-md-8"><h4 style="margin:0;">Recent reservations</h4></div>
                            <div class="col-md-4 mil-text-right"><a href="/voucher/reservations" class="mil-link mil-accent">View all &rarr;</a></div>
                        </div>

                        <% if (reservations && reservations.length > 0) { %>
                            <div class="mil-table-responsive">
                                <table class="mil-table">
                                    <thead>
                                        <tr><th>Reference</th><th>Hotel</th><th>Check in</th><th>Nights</th><th>Cashback</th><th>Status</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        <% reservations.forEach(function(r) { %>
                                            <tr>
                                                <td><strong><%= r.reference %></strong></td>
                                                <td><%= r.hotel && r.hotel.name ? r.hotel.name : (r.hotelName || '—') %></td>
                                                <td><%= new Date(r.checkInDate).toLocaleDateString() %></td>
                                                <td><%= r.nights %></td>
                                                <td>&#8358;<%= (r.cashbackAmount || 0).toLocaleString() %> <span class="mil-text-xs mil-soft">(<%= r.cashbackStatus %>)</span></td>
                                                <td><%= (r.status || '').replace(/_/g, ' ') %></td>
                                                <td><a href="/voucher/reservations/<%= r._id %>" class="mil-btn mil-sm">View</a></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="mil-text-center mil-p-60">
                                <i class="fa fa-ticket" style="font-size: 56px; color: #6C2BD9;"></i>
                                <h5 class="mil-mt-30">No stays registered yet</h5>
                                <p class="mil-text-s mil-soft">Pick a hotel from the Revaamp directory and register your stay to start earning cashback.</p>
                                <a href="/hotels?voucher=1" class="mil-btn mil-md mil-mt-15">Browse listed hotels</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">&copy; 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Room Voucher Dashboard</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-p-80-40 { padding: 80px 0 40px; }
        .mil-p-0-80 { padding: 0 0 80px; }
        .mil-p-60 { padding: 60px; }
        .mil-mt-15 { margin-top: 15px; }
        .mil-mb-5 { margin-bottom: 5px; }
        .mil-table { width: 100%; }
    </style>
</body>
</html>
