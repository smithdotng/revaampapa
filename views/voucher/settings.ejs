<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <%- include('../partials/voucher-nav', { user: user, active: 'settings' }) %>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-exclamation-circle"></i> <%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-check-circle"></i> <%= success %></div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-30 mil-up">Account Settings</h1>
                                <p class="mil-text-m mil-soft mil-up">Membership <strong><%= user.subscriberCode %></strong></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-7">

                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-30">Your details</h4>
                                <form action="/voucher/settings" method="POST">
                                    <label class="mil-text-s mil-soft">Full name</label>
                                    <input class="mil-input mil-mb-15 mil-mt-5" type="text" name="name" value="<%= user.name || '' %>" required>

                                    <label class="mil-text-s mil-soft">Phone</label>
                                    <input class="mil-input mil-mb-15 mil-mt-5" type="tel" name="phone" value="<%= user.phone || '' %>">

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="mil-text-s mil-soft">City</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="text" name="city" value="<%= (user.location && user.location.city) || '' %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="mil-text-s mil-soft">State</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="text" name="state" value="<%= (user.location && user.location.state) || '' %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="mil-text-s mil-soft">Country</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="text" name="country" value="<%= (user.location && user.location.country) || 'Nigeria' %>">
                                        </div>
                                    </div>

                                    <label class="mil-text-s mil-soft">Email (contact support to change)</label>
                                    <input class="mil-input mil-mb-30 mil-mt-5" type="email" value="<%= user.email %>" disabled>

                                    <button type="submit" class="mil-btn mil-md mil-fw">Save Changes</button>
                                </form>
                            </div>

                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-30">Change Password</h4>
                                <form action="/voucher/change-password" method="POST">
                                    <label class="mil-text-s mil-soft">Current password</label>
                                    <input class="mil-input mil-mb-15 mil-mt-5" type="password" name="currentPassword" required>

                                    <label class="mil-text-s mil-soft">New password (min. 8 characters)</label>
                                    <input class="mil-input mil-mb-15 mil-mt-5" type="password" name="newPassword" required>

                                    <label class="mil-text-s mil-soft">Confirm new password</label>
                                    <input class="mil-input mil-mb-30 mil-mt-5" type="password" name="confirmPassword" required>

                                    <button type="submit" class="mil-btn mil-md mil-fw">Update Password</button>
                                </form>
                            </div>

                            <div class="mil-price-card mil-up">
                                <h4 class="mil-mb-30">Subscription</h4>
                                <% var sub = user.subscription || {}; %>
                                <p class="mil-text-s mil-soft mil-mb-10">Status: <strong style="text-transform:capitalize;"><%= sub.status || 'pending' %></strong></p>
                                <% if (sub.startedAt) { %>
                                    <p class="mil-text-s mil-soft mil-mb-10">Started: <strong><%= new Date(sub.startedAt).toLocaleDateString() %></strong></p>
                                <% } %>
                                <% if (sub.expiresAt) { %>
                                    <p class="mil-text-s mil-soft mil-mb-10">Renews / expires: <strong><%= new Date(sub.expiresAt).toLocaleDateString() %></strong></p>
                                <% } %>
                                <p class="mil-text-s mil-soft mil-mb-10">Subscription fee:
                                    <strong>
                                        <% if (user.pricing && user.pricing.fee) { %>
                                            <%= user.pricing.currency || 'NGN' %> <%= Number(user.pricing.fee).toLocaleString() %> (<%= user.pricing.feeStatus %>)
                                        <% } else { %>
                                            Not currently applied
                                        <% } %>
                                    </strong>
                                </p>
                                <p class="mil-text-xs mil-soft mil-mt-15">Questions about your subscription or a cashback payment? <a href="/contact" class="mil-accent">Contact the Revaamp team</a>.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">&copy; 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Room Voucher Programme</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-fw { width: 100%; }
        .mil-p-80-80 { padding: 80px 0; }
        .mil-mt-5 { margin-top: 5px; }
        .mil-mt-15 { margin-top: 15px; }
    </style>
</body>
</html>
