<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <%- include('../partials/voucher-nav', { user: user, active: 'reservations' }) %>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-exclamation-circle"></i> <%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-check-circle"></i> <%= success %></div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up"><%= reservation.reference %></div>
                                <h1 class="mil-mb-30 mil-up"><%= reservation.hotel && reservation.hotel.name ? reservation.hotel.name : (reservation.hotelName || 'Reservation') %></h1>
                                <p class="mil-text-m mil-soft mil-up">
                                    <%= new Date(reservation.checkInDate).toLocaleDateString() %>
                                    &rarr; <%= new Date(reservation.checkOutDate).toLocaleDateString() %>
                                    &nbsp;&middot;&nbsp; <%= reservation.nights %> night<%= reservation.nights === 1 ? '' : 's' %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-8">

                            <!-- Cashback -->
                            <div class="mil-price-card mil-up mil-mb-30" style="background: linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%);">
                                <div class="row align-items-center">
                                    <div class="col-md-7">
                                        <h5 class="mil-light mil-mb-10">Your cashback</h5>
                                        <p class="mil-text-s mil-mb-0" style="color:rgba(255,255,255,0.85);">
                                            <%= reservation.voucherDiscountRate || 0 %>% of an estimated &#8358;<%= (reservation.estimatedTotal || 0).toLocaleString() %> stay.
                                            <% if (reservation.cashbackStatus === 'paid') { %>
                                                Paid<%= reservation.cashbackPaidAt ? ' on ' + new Date(reservation.cashbackPaidAt).toLocaleDateString() : '' %>.
                                            <% } else if (reservation.cashbackStatus === 'approved') { %>
                                                Approved and queued for payment.
                                            <% } else if (reservation.cashbackStatus === 'void') { %>
                                                Not payable on this reservation.
                                            <% } else { %>
                                                Confirmed against the actual stay before payment.
                                            <% } %>
                                        </p>
                                    </div>
                                    <div class="col-md-5 mil-text-right">
                                        <h2 class="mil-light" style="margin:0;">&#8358;<%= (reservation.cashbackAmount || 0).toLocaleString() %></h2>
                                        <p class="mil-text-s mil-mb-0" style="color:rgba(255,255,255,0.85);text-transform:capitalize;"><%= reservation.cashbackStatus %></p>
                                    </div>
                                </div>
                            </div>

                            <!-- Details -->
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-30">Reservation details</h4>
                                <div class="mil-table-responsive">
                                    <table class="mil-table">
                                        <tbody>
                                            <tr><td class="mil-soft">Status</td><td><strong style="text-transform:capitalize;"><%= (reservation.status || '').replace(/_/g, ' ') %></strong></td></tr>
                                            <tr><td class="mil-soft">Guest</td><td><%= reservation.guestName %></td></tr>
                                            <tr><td class="mil-soft">Contact</td><td><%= reservation.guestEmail || '—' %><%= reservation.guestPhone ? ' · ' + reservation.guestPhone : '' %></td></tr>
                                            <tr><td class="mil-soft">Room type</td><td><%= reservation.roomType || 'Not specified' %></td></tr>
                                            <tr><td class="mil-soft">Rooms / guests</td><td><%= reservation.numberOfRooms %> room<%= reservation.numberOfRooms === 1 ? '' : 's' %>, <%= reservation.numberOfGuests %> guest<%= reservation.numberOfGuests === 1 ? '' : 's' %></td></tr>
                                            <tr><td class="mil-soft">Quoted nightly rate</td><td>&#8358;<%= (reservation.roomRate || 0).toLocaleString() %></td></tr>
                                            <tr><td class="mil-soft">Estimated total</td><td>&#8358;<%= (reservation.estimatedTotal || 0).toLocaleString() %></td></tr>
                                            <tr><td class="mil-soft">Registered</td><td><%= new Date(reservation.createdAt).toLocaleString() %></td></tr>
                                            <% if (reservation.specialRequests) { %>
                                            <tr><td class="mil-soft">Special requests</td><td><%= reservation.specialRequests %></td></tr>
                                            <% } %>
                                            <% if (reservation.adminNotes) { %>
                                            <tr><td class="mil-soft">Note from Revaamp</td><td><%= reservation.adminNotes %></td></tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>

                                <% if (reservation.hotel && reservation.hotel.contactInfo) { %>
                                    <div class="mil-mt-30">
                                        <h5 class="mil-mb-10">Booking with the hotel</h5>
                                        <p class="mil-text-s mil-soft">
                                            Registering here records your claim &mdash; you still book the room with the hotel directly.
                                            <% if (reservation.hotel.contactInfo.phone) { %>
                                                <br><i class="fa fa-phone"></i> <%= reservation.hotel.contactInfo.phone %>
                                            <% } %>
                                            <% if (reservation.hotel.contactInfo.email) { %>
                                                <br><i class="fa fa-envelope"></i> <%= reservation.hotel.contactInfo.email %>
                                            <% } %>
                                        </p>
                                    </div>
                                <% } %>
                            </div>

                            <div class="mil-text-center">
                                <a href="/voucher/reservations" class="mil-btn mil-sm">&larr; All reservations</a>
                                <% if (['registered', 'confirmed'].indexOf(reservation.status) !== -1) { %>
                                    <button onclick="cancelReservation('<%= reservation._id %>')" class="mil-btn mil-sm" style="background:#dc3545;">Cancel this reservation</button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">&copy; 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Room Voucher Programme</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        function cancelReservation(id) {
            if (!confirm('Cancel this reservation? Any cashback on it will no longer be payable.')) return;
            fetch('/voucher/reservations/' + id + '/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) { location.reload(); }
                else { alert(d.error || 'Could not cancel this reservation'); }
            })
            .catch(function (e) { console.error(e); alert('Could not cancel this reservation'); });
        }
    </script>

    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-p-80-80 { padding: 80px 0; }
        .mil-mt-30 { margin-top: 30px; }
        .mil-mt-10 { margin-top: 10px; }
        .mil-table { width: 100%; }
        .mil-table td { padding: 8px 12px 8px 0; vertical-align: top; }
    </style>
</body>
</html>
