<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/hotels">Hotels</a></li>
                        <% if (user && user.type === 'voucher_subscriber') { %>
                            <li><a href="/voucher/dashboard">Dashboard</a></li>
                            <li><a href="/voucher/reservations">My Reservations</a></li>
                        <% } %>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <span class="mil-btn mil-sm" style="background:#6C2BD9;color:#fff;"><i class="fa fa-ticket"></i> <%= subscriber.subscriberCode %></span>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Register your stay</div>
                                <h1 class="mil-mb-30 mil-up"><%= hotel.name %></h1>
                                <p class="mil-text-m mil-soft mil-up">
                                    <i class="fa fa-map-marker"></i>
                                    <%= hotel.location && hotel.location.city ? hotel.location.city : '' %><%= hotel.location && hotel.location.state ? ', ' + hotel.location.state : '' %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-7">

                            <div class="mil-price-card mil-up mil-mb-30" style="background: linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%);">
                                <div class="row align-items-center">
                                    <div class="col-md-7">
                                        <h5 class="mil-light mil-mb-10">Your cashback rate here</h5>
                                        <p class="mil-text-s mil-mb-0" style="color:rgba(255,255,255,0.85);">Registered against this listing before check-in, then paid to you after the stay.</p>
                                    </div>
                                    <div class="col-md-5 mil-text-right">
                                        <h1 class="mil-light" style="margin:0;"><%= hotel.voucherDiscountRate || 0 %>%</h1>
                                    </div>
                                </div>
                            </div>

                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-30">Stay details</h4>
                                <form action="/voucher/reserve/<%= hotel.slug %>" method="POST" id="reserveForm">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Check in *</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="date" name="checkInDate" id="checkInDate" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Check out *</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="date" name="checkOutDate" id="checkOutDate" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Room type</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="text" name="roomType" list="roomTypeList" placeholder="e.g. Deluxe">
                                            <datalist id="roomTypeList">
                                                <option value="Standard"></option>
                                                <option value="Deluxe"></option>
                                                <option value="Executive"></option>
                                                <option value="Suite"></option>
                                            </datalist>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Quoted rate per night (&#8358;)</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="number" min="0" step="1000" name="roomRate" id="roomRate" placeholder="e.g. 75000">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Rooms</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="number" min="1" name="numberOfRooms" id="numberOfRooms" value="1">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Guests</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="number" min="1" name="numberOfGuests" value="1">
                                        </div>
                                    </div>

                                    <h4 class="mil-mb-15 mil-mt-30">Guest details</h4>
                                    <div class="mil-divider mil-mb-30"></div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label class="mil-text-s mil-soft">Guest name *</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="text" name="guestName" value="<%= subscriber.name %>" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Email</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="email" name="guestEmail" value="<%= subscriber.email %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft">Phone</label>
                                            <input class="mil-input mil-mb-15 mil-mt-5" type="tel" name="guestPhone" value="<%= subscriber.phone %>">
                                        </div>
                                        <div class="col-md-12">
                                            <label class="mil-text-s mil-soft">Special requests</label>
                                            <textarea class="mil-input mil-mb-15 mil-mt-5" name="specialRequests" rows="3" placeholder="Late arrival, accessibility needs, anything the hotel should know"></textarea>
                                        </div>
                                    </div>

                                    <div class="mil-mt-30 mil-mb-30" id="estimateBox" style="background:#f6f2ff;border-left:4px solid #6C2BD9;padding:20px;border-radius:8px;">
                                        <p class="mil-text-s mil-soft mil-mb-5">Estimated stay total</p>
                                        <h4 class="mil-mb-10" id="estTotal">&#8358;0</h4>
                                        <p class="mil-text-s mil-soft mil-mb-5">Estimated cashback at <%= hotel.voucherDiscountRate || 0 %>%</p>
                                        <h3 style="color:#6C2BD9;margin:0;" id="estCashback">&#8358;0</h3>
                                        <p class="mil-text-xs mil-soft mil-mt-10">An estimate based on the rate you enter. The final amount is confirmed against the actual stay before cashback is paid.</p>
                                    </div>

                                    <button type="submit" class="mil-btn mil-md mil-fw">Register This Stay</button>
                                    <p class="mil-text-xs mil-soft mil-text-center mil-mt-15">Registering does not book the room. Book with the hotel as normal &mdash; this records your claim so the cashback can be paid.</p>
                                </form>
                            </div>

                            <p class="mil-text-s mil-soft mil-text-center">
                                <a href="/hotels/<%= hotel.slug %>" class="mil-accent">&larr; Back to <%= hotel.name %></a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">&copy; 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Room Voucher Programme</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        (function () {
            var RATE = <%= Number(hotel.voucherDiscountRate) || 0 %>;
            var today = new Date().toISOString().slice(0, 10);
            var ci = document.getElementById('checkInDate');
            var co = document.getElementById('checkOutDate');
            if (ci) ci.min = today;
            if (co) co.min = today;

            function money(n) {
                return '₦' + (Math.round(n * 100) / 100).toLocaleString(undefined, { maximumFractionDigits: 2 });
            }

            function recalc() {
                var rate = parseFloat(document.getElementById('roomRate').value) || 0;
                var rooms = parseInt(document.getElementById('numberOfRooms').value, 10) || 1;
                var inD = ci.value ? new Date(ci.value) : null;
                var outD = co.value ? new Date(co.value) : null;
                var nights = 0;
                if (inD && outD && outD > inD) {
                    nights = Math.round((outD - inD) / 86400000);
                }
                if (ci.value) co.min = ci.value;
                var total = rate * rooms * nights;
                document.getElementById('estTotal').textContent =
                    money(total) + (nights ? '  (' + nights + ' night' + (nights === 1 ? '' : 's') + ')' : '');
                document.getElementById('estCashback').textContent = money(total * RATE / 100);
            }

            ['checkInDate', 'checkOutDate', 'roomRate', 'numberOfRooms'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.addEventListener('input', recalc);
            });
            recalc();
        })();
    </script>

    <style>
        .mil-fw { width: 100%; }
        .mil-p-80-80 { padding: 80px 0; }
        .mil-mt-5 { margin-top: 5px; }
        .mil-mt-10 { margin-top: 10px; }
        .mil-mt-15 { margin-top: 15px; }
        .mil-mb-5 { margin-bottom: 5px; }
    </style>
</body>
</html>
