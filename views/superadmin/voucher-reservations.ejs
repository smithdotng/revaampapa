<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/superadmin/dashboard">Dashboard</a></li>
                        <li><a href="/superadmin/hotels">Hotels</a></li>
                        <li><a href="/superadmin/partner-hotels">Partner Hotels</a></li>
                        <li><a href="/superadmin/voucher-subscribers">Voucher</a></li>
                        <li class="mil-active"><a href="/superadmin/voucher-reservations">Reservations</a></li>
                        <li><a href="/superadmin/promoters">Promoters</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown" style="position: relative;">
                        <a href="#" class="mil-btn mil-sm dropdown-toggle" style="display:flex;align-items:center;gap:8px;">
                            <i class="fa fa-user-circle"></i><span><%= user.name %></span><i class="fa fa-chevron-down"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="/superadmin/profile"><i class="fa fa-user"></i> Profile</a></li>
                            <li><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </div>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-60 mil-up">Room Voucher Reservations</h1>
                                <ul class="mil-breadcrumbs mil-pub-info mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/superadmin/dashboard">Dashboard</a></li>
                                    <li>Voucher Reservations</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-40">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3><%= stats.registered %></h3><p class="mil-text-s mil-soft">Registered / upcoming</p></div></div>
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3><%= stats.stayed %></h3><p class="mil-text-s mil-soft">Stayed</p></div></div>
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3>&#8358;<%= stats.cashbackOwing.toLocaleString() %></h3><p class="mil-text-s mil-soft">Cashback owing</p></div></div>
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3>&#8358;<%= stats.cashbackPaid.toLocaleString() %></h3><p class="mil-text-s mil-soft">Cashback paid</p></div></div>
                    </div>
                    <div class="mil-mb-30">
                        <a href="/superadmin/voucher-reservations?status=registered" class="mil-btn mil-sm">Registered</a>
                        <a href="/superadmin/voucher-reservations?status=confirmed" class="mil-btn mil-sm">Confirmed</a>
                        <a href="/superadmin/voucher-reservations?status=stayed" class="mil-btn mil-sm">Stayed</a>
                        <a href="/superadmin/voucher-reservations?cashback=approved" class="mil-btn mil-sm">Cashback approved</a>
                        <a href="/superadmin/voucher-reservations?cashback=paid" class="mil-btn mil-sm">Cashback paid</a>
                        <a href="/superadmin/voucher-reservations" class="mil-btn mil-sm">All</a>
                    </div>
                </div>
            </div>

            <div class="mil-p-0-80">
                <div class="container">
                    <div class="mil-price-card mil-up">
                        <h4 class="mil-mb-30">Reservations (<%= reservations.length %>)</h4>

                        <% if (reservations && reservations.length > 0) { %>
                            <div class="mil-table-responsive">
                                <table class="mil-table">
                                    <thead>
                                        <tr>
                                            <th>Reference</th><th>Subscriber</th><th>Hotel</th><th>Dates</th>
                                            <th>Est. total</th><th>Cashback</th><th>Stay</th><th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% reservations.forEach(function(r) { %>
                                            <tr>
                                                <td><strong><%= r.reference %></strong><br><span class="mil-text-xs mil-soft"><%= new Date(r.createdAt).toLocaleDateString() %></span></td>
                                                <td>
                                                    <% if (r.subscriber) { %>
                                                        <%= r.subscriber.name %><br><span class="mil-text-xs mil-soft"><%= r.subscriber.subscriberCode %><br><%= r.subscriber.email %></span>
                                                    <% } else { %><span class="mil-soft">—</span><% } %>
                                                </td>
                                                <td><%= r.hotel && r.hotel.name ? r.hotel.name : (r.hotelName || '—') %></td>
                                                <td>
                                                    <span class="mil-text-xs"><%= new Date(r.checkInDate).toLocaleDateString() %> &rarr; <%= new Date(r.checkOutDate).toLocaleDateString() %><br><%= r.nights %>n &times; <%= r.numberOfRooms %> room<%= r.numberOfRooms === 1 ? '' : 's' %></span>
                                                </td>
                                                <td>&#8358;<%= (r.estimatedTotal || 0).toLocaleString() %></td>
                                                <td>
                                                    <strong>&#8358;<%= (r.cashbackAmount || 0).toLocaleString() %></strong><br>
                                                    <span class="mil-text-xs" style="color:<%= r.cashbackStatus === 'paid' ? '#28a745' : (r.cashbackStatus === 'void' ? '#dc3545' : '#e67e22') %>;"><%= r.cashbackStatus %> @ <%= r.voucherDiscountRate || 0 %>%</span>
                                                </td>
                                                <td style="text-transform:capitalize;"><%= (r.status || '').replace(/_/g,' ') %></td>
                                                <td>
                                                    <select onchange="setStatus('<%= r._id %>', this.value)" class="mil-input" style="padding:4px;font-size:12px;margin-bottom:5px;">
                                                        <% ['registered','confirmed','stayed','cancelled','no_show'].forEach(function(s) { %>
                                                            <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option>
                                                        <% }); %>
                                                    </select>
                                                    <% if (r.cashbackStatus === 'pending') { %>
                                                        <button onclick="setCashback('<%= r._id %>','approved')" class="mil-btn mil-sm" style="background:#e67e22;">Approve cashback</button>
                                                    <% } else if (r.cashbackStatus === 'approved') { %>
                                                        <button onclick="setCashback('<%= r._id %>','paid')" class="mil-btn mil-sm" style="background:#28a745;">Mark paid</button>
                                                    <% } else if (r.cashbackStatus === 'paid') { %>
                                                        <span class="mil-text-xs" style="color:#28a745;"><i class="fa fa-check"></i> Paid<%= r.cashbackPaidAt ? ' ' + new Date(r.cashbackPaidAt).toLocaleDateString() : '' %></span>
                                                    <% } else { %>
                                                        <span class="mil-text-xs mil-soft">Void</span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="mil-text-center mil-p-60">
                                <i class="fa fa-calendar" style="font-size:64px;color:#6C2BD9;"></i>
                                <h4 class="mil-mt-30">No reservations under this filter</h4>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container"><div class="mil-footer-bottom"><div class="row">
                    <div class="col-xl-6"><p class="mil-text-s mil-soft">&copy; 2026 RevaampAPA All rights reserved.</p></div>
                    <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Superadmin Dashboard</p></div>
                </div></div></div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-p-80-40 { padding: 80px 0 40px; }
        .mil-p-0-80 { padding: 0 0 80px; }
        .mil-p-60 { padding: 60px; }
        .mil-table { width: 100%; }
    </style>

    <script>
        function setStatus(id, status) {
            fetch('/superadmin/voucher-reservations/' + id + '/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: status })
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) { location.reload(); } else { alert(d.error || 'Error updating status'); }
            })
            .catch(function (e) { console.error(e); alert('Error updating status'); });
        }

        function setCashback(id, cashbackStatus) {
            var body = { cashbackStatus: cashbackStatus };
            if (cashbackStatus === 'paid') {
                var ref = prompt('Payment reference for this cashback (optional):');
                if (ref === null) return;
                body.paymentReference = ref;
            } else if (!confirm('Approve this cashback for payment?')) {
                return;
            }
            fetch('/superadmin/voucher-reservations/' + id + '/cashback', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) {
                    if (cashbackStatus === 'paid') {
                        alert('Marked paid.' + (d.emailed ? ' Subscriber notified by email.' : ' NOTE: email could not be sent.'));
                    }
                    location.reload();
                } else { alert(d.error || 'Error updating cashback'); }
            })
            .catch(function (e) { console.error(e); alert('Error updating cashback'); });
        }
    </script>
</body>
</html>
