<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/superadmin/dashboard">Dashboard</a></li>
                        <li><a href="/superadmin/hotels">Hotels</a></li>
                        <li><a href="/superadmin/partner-hotels">Partner Hotels</a></li>
                        <li class="mil-active"><a href="/superadmin/voucher-subscribers">Voucher</a></li>
                        <li><a href="/superadmin/voucher-reservations">Reservations</a></li>
                        <li><a href="/superadmin/promoters">Promoters</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown" style="position: relative;">
                        <a href="#" class="mil-btn mil-sm dropdown-toggle" style="display:flex;align-items:center;gap:8px;">
                            <i class="fa fa-user-circle"></i><span><%= user.name %></span><i class="fa fa-chevron-down"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="/superadmin/profile"><i class="fa fa-user"></i> Profile</a></li>
                            <li><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </div>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-60 mil-up">Room Voucher Subscribers</h1>
                                <ul class="mil-breadcrumbs mil-pub-info mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/superadmin/dashboard">Dashboard</a></li>
                                    <li>Voucher Subscribers</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-40">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3><%= stats.pending %></h3><p class="mil-text-s mil-soft">Awaiting activation</p></div></div>
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3><%= stats.active %></h3><p class="mil-text-s mil-soft">Active</p></div></div>
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3><%= stats.suspended %></h3><p class="mil-text-s mil-soft">Suspended / cancelled</p></div></div>
                        <div class="col-xl-3 col-md-6 mil-mb-30"><div class="mil-price-card mil-up mil-text-center"><h3><%= stats.total %></h3><p class="mil-text-s mil-soft">Total subscribers</p></div></div>
                    </div>
                    <div class="mil-mb-30">
                        <a href="/superadmin/voucher-subscribers?status=pending" class="mil-btn mil-sm">Pending</a>
                        <a href="/superadmin/voucher-subscribers?status=active" class="mil-btn mil-sm">Active</a>
                        <a href="/superadmin/voucher-subscribers?status=suspended" class="mil-btn mil-sm">Suspended</a>
                        <a href="/superadmin/voucher-subscribers" class="mil-btn mil-sm">All</a>
                    </div>
                </div>
            </div>

            <div class="mil-p-0-80">
                <div class="container">
                    <div class="mil-price-card mil-up">
                        <h4 class="mil-mb-30">Subscribers (<%= subscribers.length %>)</h4>

                        <% if (subscribers && subscribers.length > 0) { %>
                            <div class="mil-table-responsive">
                                <table class="mil-table">
                                    <thead>
                                        <tr><th>Member</th><th>Contact</th><th>Location</th><th>Introduced by</th><th>Subscription</th><th>Joined</th><th>Actions</th></tr>
                                    </thead>
                                    <tbody>
                                        <% subscribers.forEach(function(s) { %>
                                            <tr>
                                                <td><strong><%= s.name %></strong><br><span class="mil-text-xs mil-soft"><%= s.subscriberCode %></span></td>
                                                <td><span class="mil-text-xs"><%= s.email %><br><%= s.phone %></span></td>
                                                <td><span class="mil-text-xs"><%= (s.location && s.location.city) || '—' %><%= s.location && s.location.state ? ', ' + s.location.state : '' %></span></td>
                                                <td>
                                                    <% if (s.referral && s.referral.referredBy) { %>
                                                        <span class="mil-text-xs"><%= s.referral.referredBy.name || 'Partner' %><br><%= (s.referral.referrerType || '').replace(/_/g,' ') %> · <%= s.referral.commissionRate %>%</span>
                                                    <% } else { %><span class="mil-soft">—</span><% } %>
                                                </td>
                                                <td>
                                                    <% if (s.isSuspended) { %><span style="color:#dc3545;">Suspended</span>
                                                    <% } else if (s.subscription && s.subscription.status === 'active') { %><span style="color:#28a745;">Active</span>
                                                    <% } else { %><span style="color:#e67e22;text-transform:capitalize;"><%= (s.subscription && s.subscription.status) || 'pending' %></span><% } %>
                                                </td>
                                                <td><span class="mil-text-xs"><%= new Date(s.createdAt).toLocaleDateString() %></span></td>
                                                <td>
                                                    <% if (!s.subscription || s.subscription.status !== 'active' || s.isSuspended) { %>
                                                        <button onclick="activateSubscriber('<%= s._id %>')" class="mil-btn mil-sm" style="background:#28a745;margin-bottom:5px;"><i class="fa fa-check"></i> Activate</button><br>
                                                    <% } %>
                                                    <button onclick="suspendSubscriber('<%= s._id %>')" class="mil-btn mil-sm" style="background:#dc3545;"><i class="fa fa-ban"></i> Suspend</button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="mil-text-center mil-p-60">
                                <i class="fa fa-ticket" style="font-size:64px;color:#6C2BD9;"></i>
                                <h4 class="mil-mt-30">No subscribers under this filter</h4>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container"><div class="mil-footer-bottom"><div class="row">
                    <div class="col-xl-6"><p class="mil-text-s mil-soft">&copy; 2026 RevaampAPA All rights reserved.</p></div>
                    <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Superadmin Dashboard</p></div>
                </div></div></div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-p-80-40 { padding: 80px 0 40px; }
        .mil-p-0-80 { padding: 0 0 80px; }
        .mil-p-60 { padding: 60px; }
        .mil-table { width: 100%; }
    </style>

    <script>
        function activateSubscriber(id) {
            var months = prompt('Activate this subscription for how many months? (blank = no expiry)', '12');
            if (months === null) return;
            fetch('/superadmin/voucher-subscribers/' + id + '/activate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ months: months })
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) { alert('Subscription activated.' + (d.emailed ? ' Subscriber notified by email.' : ' NOTE: email could not be sent.')); location.reload(); }
                else { alert(d.error || 'Error activating subscription'); }
            })
            .catch(function (e) { console.error(e); alert('Error activating subscription'); });
        }

        function suspendSubscriber(id) {
            var reason = prompt('Reason for suspending this subscription:');
            if (!reason) return;
            fetch('/superadmin/voucher-subscribers/' + id + '/suspend', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: reason })
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) { location.reload(); } else { alert(d.error || 'Error'); }
            })
            .catch(function (e) { console.error(e); alert('Error'); });
        }
    </script>
</body>
</html>
