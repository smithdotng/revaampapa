<!DOCTYPE html>
<html lang="en-US">

<head>
    <title>Share Analytics - RevaampAP</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    
    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu { display: block; }
        .stat-card { background: #f8f9fa; padding: 20px; border-radius: 12px; text-align: center; }
        .stat-number { font-size: 32px; font-weight: 700; color: #03A6A6; }
        .filter-bar { display: flex; gap: 15px; margin-bottom: 30px; flex-wrap: wrap; }
        .filter-select { padding: 10px 15px; border: 1px solid #ddd; border-radius: 8px; }
    </style>
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/properties">Properties</a></li>
                        <li><a href="/promoter/dashboard">Dashboard</a></li>
                        <li><a href="/promoter/hotels">Hotels</a></li>
                        <li><a href="/promoter/share-analytics" class="mil-active">Share Analytics</a></li>
                        <li><a href="/promoter/earnings">Earnings</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown"><a href="#" class="mil-btn mil-sm dropdown-toggle"><i class="fa fa-user-circle"></i> <%= user.name %></a></div>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-60 mil-up">Share Analytics</h1>
                                <ul class="mil-breadcrumbs mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/promoter/dashboard">Dashboard</a></li>
                                    <li>Share Analytics</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <!-- Filters -->
                    <div class="filter-bar">
                        <select id="periodFilter" class="filter-select" onchange="loadAnalytics()">
                            <option value="week">Last 7 Days</option>
                            <option value="month">Last 30 Days</option>
                            <option value="year">Last Year</option>
                            <option value="all">All Time</option>
                        </select>
                        <select id="platformFilter" class="filter-select" onchange="loadAnalytics()">
                            <option value="all">All Platforms</option>
                            <option value="whatsapp">WhatsApp</option>
                            <option value="facebook">Facebook</option>
                            <option value="twitter">Twitter</option>
                            <option value="linkedin">LinkedIn</option>
                            <option value="copy">Copy Link</option>
                        </select>
                        <select id="typeFilter" class="filter-select" onchange="loadAnalytics()">
                            <option value="all">All Types</option>
                            <option value="referral">Referral Links</option>
                            <option value="property">Properties</option>
                            <option value="hotel">Hotels</option>
                        </select>
                    </div>

                    <!-- Stats Cards -->
                    <div class="row" id="statsContainer">
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="stat-number" id="totalShares">0</div>
                                <div>Total Shares</div>
                            </div>
                        </div>
                    </div>

                    <!-- Platform Chart -->
                    <div class="row mil-mt-30">
                        <div class="col-xl-6">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4>Shares by Platform</h4>
                                <canvas id="platformChart" width="400" height="300"></canvas>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4>Shares by Link Type</h4>
                                <canvas id="typeChart" width="400" height="300"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Daily Shares Chart -->
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4>Daily Shares Trend</h4>
                                <canvas id="dailyChart" width="800" height="300"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Shares Table -->
                    <div class="row mil-mt-30">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4>Recent Shares</h4>
                                <div class="mil-table-responsive">
                                    <table class="mil-table">
                                        <thead>
                                            <tr><th>Platform</th><th>Type</th><th>Link</th><th>Shared At</th></tr>
                                        </thead>
                                        <tbody id="sharesTable">
                                            <tr><td colspan="4" class="text-center">Loading...</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <p class="mil-text-s mil-soft">© 2026 RevaampAPA All rights reserved.</p>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        let platformChart, typeChart, dailyChart;

        async function loadAnalytics() {
            const period = document.getElementById('periodFilter').value;
            const platform = document.getElementById('platformFilter').value;
            const linkType = document.getElementById('typeFilter').value;
            
            const response = await fetch(`/promoter/api/share-analytics?period=${period}&platform=${platform}&linkType=${linkType}`);
            const data = await response.json();
            
            if (data.success) {
                // Update stats
                document.getElementById('totalShares').innerText = data.stats.totalShares;
                
                // Update platform chart
                const platformLabels = data.stats.platformStats.map(s => s._id);
                const platformCounts = data.stats.platformStats.map(s => s.count);
                
                if (platformChart) platformChart.destroy();
                platformChart = new Chart(document.getElementById('platformChart'), {
                    type: 'bar',
                    data: { labels: platformLabels, datasets: [{ label: 'Shares', data: platformCounts, backgroundColor: '#03A6A6' }] }
                });
                
                // Update type chart
                const typeLabels = data.stats.linkTypeStats.map(s => s._id);
                const typeCounts = data.stats.linkTypeStats.map(s => s.count);
                
                if (typeChart) typeChart.destroy();
                typeChart = new Chart(document.getElementById('typeChart'), {
                    type: 'pie',
                    data: { labels: typeLabels, datasets: [{ data: typeCounts, backgroundColor: ['#03A6A6', '#667eea', '#764ba2', '#28a745'] }] }
                });
                
                // Update daily chart
                const dailyLabels = data.stats.dailyStats.map(s => s._id);
                const dailyCounts = data.stats.dailyStats.map(s => s.count);
                
                if (dailyChart) dailyChart.destroy();
                dailyChart = new Chart(document.getElementById('dailyChart'), {
                    type: 'line',
                    data: { labels: dailyLabels, datasets: [{ label: 'Shares', data: dailyCounts, borderColor: '#03A6A6', fill: false }] }
                });
                
                // Update shares table
                const tbody = document.getElementById('sharesTable');
                if (data.shares.length > 0) {
                    tbody.innerHTML = data.shares.map(share => `
                        <tr>
                            <td><span class="badge-click">${share.platform}</span></td>
                            <td><span class="badge-referral">${share.linkType}</span></td>
                            <td><code style="font-size: 11px;">${share.link.substring(0, 50)}...</code></td>
                            <td>${new Date(share.sharedAt).toLocaleString()}</td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center">No shares recorded yet</td></tr>';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', loadAnalytics);
    </script>
</body>
</html>