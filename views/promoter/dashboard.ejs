<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="RevaampAP" />
    <meta name="description" content="Promoter Dashboard - Track your earnings, manage promotions, referrals, and grow your business" />

    <!-- switzer font css -->
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <!-- font awesome css -->
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <!-- bootstrap grid css -->
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <!-- swiper css -->
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <!-- magnific popup -->
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <!-- plax css -->
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <!-- custom css -->
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Favicon -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    
    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu,
        .dropdown .dropdown-menu.show { display: block; }
        .dropdown-menu li a:hover { background: #f8f9fa; padding-left: 25px; }
        .mil-table-responsive { overflow-x: auto; }
        .mil-table { width: 100%; border-collapse: collapse; }
        .mil-table th, .mil-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .mil-table th { font-weight: 600; color: #333; background: #f8f9fa; }
        .mil-xs { padding: 4px 8px; font-size: 11px; }
        .mil-flex-between { display: flex; justify-content: space-between; align-items: center; }
        .mil-mb-10 { margin-bottom: 10px; }
        .mil-mb-20 { margin-bottom: 20px; }
        .promote-btn { cursor: pointer; transition: all 0.3s ease; }
        .promote-btn:hover { transform: translateY(-2px); }
        .property-card { transition: transform 0.3s ease; }
        .property-card:hover { transform: translateY(-5px); }
        .badge-new { background: #28a745; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-click { background: #17a2b8; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-referral { background: #ffc107; color: #000; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-converted { background: #6c757d; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .stat-box { background: #f8f9fa; padding: 20px; border-radius: 12px; text-align: center; transition: transform 0.3s; }
        .stat-box:hover { transform: translateY(-5px); }
        .stat-number { font-size: 32px; font-weight: 700; color: #03A6A6; }
        .stat-label { font-size: 14px; color: #666; margin-top: 5px; }
        .mil-buttons-frame { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }
        .copy-btn { background: #03A6A6; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; }
        .copy-btn:hover { background: #028484; }
        .share-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 8px; color: white; text-decoration: none; }
        .share-wa { background: #25d366; }
        .share-fb { background: #3b5998; }
        .tab-buttons { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #eee; }
        .tab-btn { padding: 10px 20px; background: none; border: none; cursor: pointer; font-weight: 600; color: #666; transition: all 0.3s; }
        .tab-btn.active { color: #03A6A6; border-bottom: 2px solid #03A6A6; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        @media (max-width: 768px) {
            .mil-table th, .mil-table td { padding: 8px; font-size: 12px; }
        }
    </style>
</head>

<body>

    <!-- wrapper -->
    <div id="smooth-wrapper" class="mil-wrapper">

        <!-- preloader -->
        <div class="mil-preloader">
            <div class="mil-load"></div>
            <p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p>
        </div>
        <!-- preloader end -->

        <!-- scroll progress -->
        <div class="mil-progress-track">
            <div class="mil-progress"></div>
        </div>
        <!-- scroll progress end -->

        <!-- back to top -->
        <div class="progress-wrap active-progress"></div>

        <!-- top panel -->
        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo">
                    <img src="/img/logo.png" alt="RevaampAP" width="83" height="32">
                </a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/properties">Properties</a></li>
                        <li class="mil-active"><a href="/promoter/dashboard">Dashboard</a></li>
                        <li><a href="/promoter/hotels">Hotels</a></li>
                        <li><a href="/promoter/earnings">Earnings</a></li>
                        <li><a href="/promoter/analytics">Analytics</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown" style="position: relative;">
                        <a href="#" class="mil-btn mil-sm dropdown-toggle" data-bs-toggle="dropdown" style="display: flex; align-items: center; gap: 8px;">
                            <i class="fa fa-user-circle" style="font-size: 18px;"></i> 
                            <span><%= user.name %></span>
                            <i class="fa fa-chevron-down" style="font-size: 12px;"></i>
                        </a>
                        <ul class="dropdown-menu" style="position: absolute; right: 0; top: 100%; min-width: 220px; background: white; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); padding: 10px 0; margin-top: 10px; z-index: 1000;">
                            <li><a href="/promoter/dashboard"><i class="fa fa-tachometer"></i> Dashboard</a></li>
                            <li><a href="/promoter/earnings"><i class="fa fa-money"></i> Earnings</a></li>
                            <li><a href="/promoter/analytics"><i class="fa fa-chart-line"></i> Analytics</a></li>
                            <li><a href="/promoter/settings"><i class="fa fa-cog"></i> Settings</a></li>
                            <li><hr></li>
                            <li><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
                        </ul>
                    </div>
                    <div class="mil-menu-btn">
                        <span></span>
                    </div>
                </div>
            </div>
        </div>
        <!-- top panel end -->

        <!-- content -->
        <div id="smooth-content">

            <!-- banner -->
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Welcome back, <%= user.name %>!</div>
                                <h1 class="mil-mb-60 mil-up">Promoter Dashboard</h1>
                                <ul class="mil-breadcrumbs mil-pub-info mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/promoter/dashboard">Dashboard</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- banner end -->

            <!-- Stats Cards -->
            <div class="mil-blog-list mil-p-0-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-box mil-up mil-mb-30">
                                <div class="stat-number"><%= stats.totalClicks || 0 %></div>
                                <div class="stat-label">Total Clicks</div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-box mil-up mil-mb-30">
                                <div class="stat-number"><%= stats.totalReferrals || 0 %></div>
                                <div class="stat-label">Total Referrals</div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-box mil-up mil-mb-30">
                                <div class="stat-number"><%= stats.totalTransactions || 0 %></div>
                                <div class="stat-label">Successful Sales</div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-box mil-up mil-mb-30">
                                <div class="stat-number">₦<%= (stats.totalEarnings || 0).toLocaleString() %></div>
                                <div class="stat-label">Total Earnings</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Stats Cards End -->

            <!-- ============= REFERRAL LINK SECTION ============= -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-10">
                            <div class="mil-price-card mil-up mil-mb-30" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                <div class="mil-text-center">
                                    <i class="fa fa-users" style="font-size: 60px; color: white; margin-bottom: 20px;"></i>
                                    <h2 class="mil-light mil-mb-15">Invite & Earn Residual Income!</h2>
                                    <p class="mil-dark-soft mil-mb-30" style="color: rgba(255,255,255,0.9);">
                                        Share your unique referral link to invite friends to become promoters. 
                                        <strong>Earn 70% of administrative fee</strong> every time your referred promoter earns!
                                    </p>
                                    <div class="mil-referral-box" style="background: rgba(255,255,255,0.15); border-radius: 12px; padding: 20px; margin-bottom: 25px;">
                                        <code style="color: white; word-break: break-all; font-size: 16px;" id="referralLink">
                                            <%= typeof baseUrl !== 'undefined' ? baseUrl : 'http://localhost:3000' %>/promoter/register?ref=<%= user._id %>
                                        </code>
                                    </div>
                                    <div class="mil-buttons-frame">
                                        <button class="mil-btn mil-md mil-light" onclick="copyReferralLink()">
                                            <i class="fa fa-copy"></i> Copy Link
                                        </button>
                                        <button class="mil-btn mil-md mil-light" onclick="shareReferralLink()">
                                            <i class="fa fa-whatsapp"></i> Share on WhatsApp
                                        </button>
                                        <button class="mil-btn mil-md mil-light" onclick="shareReferralLinkSocial()">
                                            <i class="fa fa-facebook"></i> Share on Facebook
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ============= REFERRAL LINK SECTION END ============= -->

            <!-- Commission Structure Banner -->
            <div class="mil-cta mil-up">
                <div class="container">
                    <div class="mil-out-frame mil-p-80-80" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-xl-12 mil-text-center">
                                <h2 class="mil-light mil-mb-30 mil-up">Your Commission Structure</h2>
                                <p class="mil-text-m mil-dark-soft mil-up">Earn up to 90% commission when you bring a buyer! 10% administrative fee applies.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Commission Structure Banner End -->

            <!-- ============= CLICKS & REFERRALS TABLES SECTION ============= -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <div class="tab-buttons">
                                    <button class="tab-btn active" onclick="showTab('clicks')">📊 Clicks & Activity</button>
                                    <button class="tab-btn" onclick="showTab('referrals')">👥 Referrals</button>
                                    <button class="tab-btn" onclick="showTab('conversions')">💰 Conversions</button>
                                </div>

                                <!-- Clicks Tab -->
                                <div id="clicksTab" class="tab-content active">
                                    <h4 class="mil-mb-20">Recent Clicks on Your Promotions</h4>
                                    <div id="clicksTable">
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Referrals Tab -->
                                <div id="referralsTab" class="tab-content">
                                    <h4 class="mil-mb-20">People You've Referred</h4>
                                    <div id="referralsTable">
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mil-mt-20 text-center">
                                        <div class="stat-box" style="display: inline-block; min-width: 200px;">
                                            <div class="stat-number" id="totalReferralsCount">0</div>
                                            <div class="stat-label">Total Referrals</div>
                                        </div>
                                        <div class="stat-box" style="display: inline-block; min-width: 200px; margin-left: 15px;">
                                            <div class="stat-number" id="referralEarningsCount">₦0</div>
                                            <div class="stat-label">Earnings from Referrals</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Conversions Tab -->
                                <div id="conversionsTab" class="tab-content">
                                    <h4 class="mil-mb-20">Converted Leads (Successful Sales)</h4>
                                    <div id="conversionsTable">
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ============= CLICKS & REFERRALS TABLES END ============= -->

            <!-- All Properties Section - Promotable Properties -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="mil-text-center">
                        <h2 class="mil-mb-30 mil-up">Properties Available for Promotion</h2>
                        <p class="mil-text-m mil-soft mil-mb-60 mil-up">Click "Promote" on any property to get your unique referral link. When someone clicks and expresses interest, you earn commission!</p>
                    </div>
                    <div class="row" id="propertiesGrid">
                        <% if (typeof properties !== 'undefined' && properties && properties.length > 0) { %>
                            <% properties.forEach(function(property) { %>
                                <div class="col-xl-4 col-md-6 mil-mb-30">
                                    <div class="mil-price-card mil-up" style="height: 100%;">
                                        <div class="property-image" style="position: relative; overflow: hidden; border-radius: 15px; margin-bottom: 20px;">
                                            <% if(property.images && property.images.length > 0) { %>
                                                <img src="<%= property.images[0].url %>" alt="<%= property.title %>" style="width: 100%; height: 220px; object-fit: cover;">
                                            <% } else { %>
                                                <img src="/img/property-placeholder.jpg" alt="<%= property.title %>" style="width: 100%; height: 220px; object-fit: cover;">
                                            <% } %>
                                            <div class="property-badges" style="position: absolute; top: 10px; left: 10px;">
                                                <span class="mil-badge" style="background: #28a745; color: white; padding: 4px 10px; border-radius: 5px; font-size: 11px;">✓ Verified</span>
                                            </div>
                                        </div>
                                        <div class="property-content">
                                            <div class="mil-flex-between mil-mb-10">
                                                <h5 class="property-price" style="color: #03A6A6;">₦<%= property.price ? property.price.toLocaleString() : '0' %></h5>
                                                <span class="mil-text-xs mil-soft"><%= property.transactionType === 'sale' ? 'For Sale' : 'For Rent' %></span>
                                            </div>
                                            <h4 class="property-title mil-mb-10"><%= property.title %></h4>
                                            <p class="mil-text-s mil-soft mil-mb-15"><i class="fa fa-map-marker"></i> <%= property.location ? property.location.city + ', ' + property.location.state : 'Location TBD' %></p>
                                            <div class="property-features mil-flex-between mil-mb-20">
                                                <div class="feature-item"><i class="fa fa-bed"></i> <span><%= property.features && property.features.bedrooms ? property.features.bedrooms : '0' %> beds</span></div>
                                                <div class="feature-item"><i class="fa fa-bath"></i> <span><%= property.features && property.features.bathrooms ? property.features.bathrooms : '0' %> baths</span></div>
                                                <div class="feature-item"><i class="fa fa-car"></i> <span><%= property.features && property.features.parkingSpaces ? property.features.parkingSpaces : '0' %> parking</span></div>
                                            </div>
                                            <div class="property-footer">
                                                <button class="mil-btn mil-sm mil-accent promote-btn" data-property-id="<%= property._id %>" data-property-title="<%= property.title %>">
                                                    <i class="fa fa-bullhorn"></i> Promote & Get Link
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-xl-12">
                                <div class="mil-price-card mil-up mil-text-center" style="padding: 60px 20px;">
                                    <i class="fa fa-building-o" style="font-size: 60px; opacity: 0.3; margin-bottom: 20px;"></i>
                                    <h3 class="mil-mb-15">No Properties Available</h3>
                                    <p class="mil-text-m mil-soft mil-mb-30">Check back soon for new properties to promote!</p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <!-- All Properties End -->

            <!-- Quick Actions -->
            <div class="mil-cta mil-up">
                <div class="container">
                    <div class="mil-out-frame mil-p-80-80" style="background: #f8f9fa;">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-xl-12 mil-text-center">
                                <h2 class="mil-mb-30 mil-up">Quick Actions</h2>
                                <div class="mil-buttons-frame mil-up">
                                    <a href="/promoter/hotels" class="mil-btn mil-sm mil-light">Promote Hotels</a>
                                    <a href="/promoter/submit-property" class="mil-btn mil-sm">Submit Property</a>
                                    <a href="/promoter/submit-buyer" class="mil-btn mil-sm mil-light">Submit Buyer</a>
                                    <a href="/promoter/onboard-hotel" class="mil-btn mil-sm mil-light">Onboard Hotel</a>
                                    <a href="/promoter/earnings" class="mil-btn mil-sm mil-light">View Earnings</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Section -->
            <div class="mil-cta mil-up">
                <div class="container">
                    <div class="mil-out-frame mil-p-80-80" style="background: #f8f9fa;">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-xl-12">
                                <h2 class="mil-mb-30 mil-up">Pro Tips for Maximizing Your Earnings</h2>
                                <div class="row">
                                    <div class="col-md-3 mil-mb-30">
                                        <div class="mil-text-center">
                                            <i class="fa fa-share-alt" style="font-size: 40px; color: #03A6A6; margin-bottom: 15px;"></i>
                                            <h5 class="mil-mb-15">Share on Multiple Platforms</h5>
                                            <p class="mil-text-s mil-soft">Share your property links on WhatsApp, Instagram, Facebook, Twitter, and LinkedIn</p>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mil-mb-30">
                                        <div class="mil-text-center">
                                            <i class="fa fa-users" style="font-size: 40px; color: #03A6A6; margin-bottom: 15px;"></i>
                                            <h5 class="mil-mb-15">Build Your Referral Network</h5>
                                            <p class="mil-text-s mil-soft">Refer other promoters for 70% residual income</p>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mil-mb-30">
                                        <div class="mil-text-center">
                                            <i class="fa fa-hotel" style="font-size: 40px; color: #03A6A6; margin-bottom: 15px;"></i>
                                            <h5 class="mil-mb-15">Promote Hotels</h5>
                                            <p class="mil-text-s mil-soft">Share hotel links to earn 30% commission on every booking</p>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mil-mb-30">
                                        <div class="mil-text-center">
                                            <i class="fa fa-envelope" style="font-size: 40px; color: #03A6A6; margin-bottom: 15px;"></i>
                                            <h5 class="mil-mb-15">Email Marketing</h5>
                                            <p class="mil-text-s mil-soft">Build an email list and share your links with potential buyers</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Tips Section End -->

            <!-- footer -->
            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-3">
                            <a href="/" class="mil-footer-logo mil-mb-60">
                                <img src="/img/logo-2.png" alt="RevaampAP" width="28" height="32">
                            </a>
                        </div>
                        <div class="col-xl-3 mil-mb-60">
                            <h6 class="mil-mb-60">Quick Links</h6>
                            <ul class="mil-footer-list">
                                <li class="mil-text-m mil-soft mil-mb-15"><a href="/">Home</a></li>
                                <li class="mil-text-m mil-soft mil-mb-15"><a href="/properties">Properties</a></li>
                                <li class="mil-text-m mil-soft mil-mb-15"><a href="/promoter/dashboard">Dashboard</a></li>
                                <li class="mil-text-m mil-soft mil-mb-15"><a href="/promoter/earnings">Earnings</a></li>
                            </ul>
                        </div>
                        <div class="col-xl-3 mil-mb-60">
                            <h6 class="mil-mb-60">Support</h6>
                            <ul class="mil-footer-list">
                                <li class="mil-text-m mil-soft mil-mb-15"><a href="/contact">Contact Us</a></li>
                                <li class="mil-text-m mil-soft mil-mb-15"><a href="/faq">FAQ</a></li>
                                <li class="mil-text-m mil-soft mil-mb-15"><a href="/how-it-works">How It Works</a></li>
                            </ul>
                        </div>
                        <div class="col-xl-3 mil-mb-80">
                            <h6 class="mil-mb-60">Newsletter</h6>
                            <p class="mil-text-xs mil-soft mil-mb-15">Get tips and updates for promoters</p>
                            <form class="mil-subscripe-form-footer" id="footerNewsletterForm">
                                <input class="mil-input" type="email" placeholder="Email">
                                <button type="submit"><i class="far fa-envelope-open mil-dark"></i></button>
                            </form>
                        </div>
                    </div>
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6">
                                <p class="mil-text-s mil-soft">© 2024 RevaampAP. All rights reserved.</p>
                            </div>
                            <div class="col-xl-6">
                                <p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Promoter Dashboard</p>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- footer end -->

        </div>
        <!-- content end -->
    </div>
    <!-- wrapper end -->

    <!-- jquery js -->
    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        let clicksData = [];
        let referralsData = [];
        let conversionsData = [];

        // Tab switching
        function showTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            
            document.getElementById(`${tabName}Tab`).classList.add('active');
            event.target.classList.add('active');
        }

        // Copy referral link
        function copyReferralLink() {
            const linkText = document.getElementById('referralLink').innerText;
            navigator.clipboard.writeText(linkText).then(() => alert('Referral link copied!'), () => alert('Failed to copy'));
        }

        function shareReferralLink() {
            const linkText = document.getElementById('referralLink').innerText;
            window.open(`https://wa.me/?text=${encodeURIComponent(`Join RevaampAP as a promoter and earn up to 90% commission! Use my referral link: ${linkText}`)}`, '_blank');
        }

        function shareReferralLinkSocial() {
            const linkText = document.getElementById('referralLink').innerText;
            window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(linkText)}&quote=${encodeURIComponent('Join RevaampAP as a promoter and earn up to 90% commission!')}`, '_blank', 'width=600,height=400');
        }

        // Load clicks data
        async function loadClicks() {
            try {
                const response = await fetch('/promoter/api/clicks');
                const data = await response.json();
                const container = document.getElementById('clicksTable');
                
                if (data.success && data.clicks && data.clicks.length > 0) {
                    container.innerHTML = `
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead>
                                    <tr><th>Property/Hotel</th><th>Type</th><th>IP Address</th><th>Device/Browser</th><th>Clicked At</th><th>Status</th></tr>
                                </thead>
                                <tbody>
                                    ${data.clicks.map(click => `
                                        <tr>
                                            <td>${click.itemTitle || 'N/A'}</td>
                                            <td><span class="badge-click">${click.type || 'Property'}</span></td>
                                            <td><code>${click.ipAddress || 'N/A'}</code></td>
                                            <td><small>${click.deviceInfo || 'N/A'}</small></td>
                                            <td>${new Date(click.clickedAt).toLocaleString()}</td>
                                            <td>${click.converted ? '<span class="badge-converted">Converted</span>' : '<span class="badge-click">Clicked</span>'}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="text-center py-4"><p>No clicks recorded yet. Share your promotion links!</p></div>';
                }
            } catch (error) {
                console.error('Error loading clicks:', error);
                document.getElementById('clicksTable').innerHTML = '<div class="text-center py-4"><p>Error loading clicks data.</p></div>';
            }
        }

        // Load referrals data
        async function loadReferrals() {
            try {
                const response = await fetch('/promoter/api/referrals');
                const data = await response.json();
                const container = document.getElementById('referralsTable');
                
                if (data.success && data.referrals && data.referrals.length > 0) {
                    container.innerHTML = `
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead>
                                    <tr><th>Name</th><th>Email</th><th>Phone</th><th>Type</th><th>Status</th><th>Registered</th><th>Earnings</th></tr>
                                </thead>
                                <tbody>
                                    ${data.referrals.map(ref => `
                                        <tr>
                                            <td>${ref.name || 'N/A'}</td>
                                            <td>${ref.email}</td>
                                            <td>${ref.phone || 'N/A'}</td>
                                            <td><span class="badge-referral">${ref.userType || 'Promoter'}</span></td>
                                            <td>${ref.isApproved ? '<span class="badge-new">Approved</span>' : '<span class="badge-click">Pending</span>'}</td>
                                            <td>${new Date(ref.createdAt).toLocaleDateString()}</td>
                                            <td>₦${(ref.earningsFromReferral || 0).toLocaleString()}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                    document.getElementById('totalReferralsCount').innerText = data.stats.totalReferrals || 0;
                    document.getElementById('referralEarningsCount').innerHTML = `₦${(data.stats.totalEarnings || 0).toLocaleString()}`;
                } else {
                    container.innerHTML = '<div class="text-center py-4"><p>No referrals yet. Share your referral link to invite others!</p></div>';
                    document.getElementById('totalReferralsCount').innerText = '0';
                    document.getElementById('referralEarningsCount').innerHTML = '₦0';
                }
            } catch (error) {
                console.error('Error loading referrals:', error);
                document.getElementById('referralsTable').innerHTML = '<div class="text-center py-4"><p>Error loading referrals data.</p></div>';
            }
        }

        // Load conversions data
        async function loadConversions() {
            try {
                const response = await fetch('/promoter/api/conversions');
                const data = await response.json();
                const container = document.getElementById('conversionsTable');
                
                if (data.success && data.conversions && data.conversions.length > 0) {
                    container.innerHTML = `
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead>
                                    <tr><th>Property/Hotel</th><th>Buyer Name</th><th>Email</th><th>Amount</th><th>Commission</th><th>Date</th><th>Status</th></tr>
                                </thead>
                                <tbody>
                                    ${data.conversions.map(conv => `
                                        <tr>
                                            <td>${conv.itemTitle || 'N/A'}</td>
                                            <td>${conv.buyerName || 'N/A'}</td>
                                            <td>${conv.buyerEmail || 'N/A'}</td>
                                            <td>₦${(conv.amount || 0).toLocaleString()}</td>
                                            <td>₦${(conv.commission || 0).toLocaleString()}</td>
                                            <td>${new Date(conv.createdAt).toLocaleDateString()}</td>
                                            <td><span class="badge-new">Completed</span></td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="text-center py-4"><p>No conversions yet. Keep sharing your links!</p></div>';
                }
            } catch (error) {
                console.error('Error loading conversions:', error);
                document.getElementById('conversionsTable').innerHTML = '<div class="text-center py-4"><p>Error loading conversions data.</p></div>';
            }
        }

        // Create promotion for property
        async function createPromotion(propertyId, propertyTitle) {
            const btn = event.target.closest('.promote-btn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Creating...';
            btn.disabled = true;
            
            try {
                const response = await fetch(`/promoter/api/promotion/${propertyId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                if (data.success) {
                    alert(`Promotion created for "${propertyTitle}"!\n\nShare this link: ${data.promotion.referralLink}\n\nWhen someone clicks and expresses interest, you'll earn commission!`);
                } else {
                    alert(data.message || 'Error creating promotion. Please try again.');
                }
            } catch (error) {
                console.error('Error creating promotion:', error);
                alert('Error creating promotion. Please try again.');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        // Attach promote button handlers
        document.querySelectorAll('.promote-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const propertyId = this.getAttribute('data-property-id');
                const propertyTitle = this.getAttribute('data-property-title');
                createPromotion(propertyId, propertyTitle);
            });
        });

        // Newsletter subscription
        function initNewsletter() {
            const newsletterForm = document.getElementById('footerNewsletterForm');
            if (newsletterForm) {
                newsletterForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const email = newsletterForm.querySelector('input[type="email"]').value;
                    try {
                        const response = await fetch('/api/subscribe', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ email })
                        });
                        const data = await response.json();
                        alert(data.success ? 'Successfully subscribed!' : 'Error subscribing.');
                        if (data.success) newsletterForm.reset();
                    } catch (error) {
                        console.error('Newsletter error:', error);
                        alert('Error subscribing.');
                    }
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadClicks();
            loadReferrals();
            loadConversions();
            initNewsletter();
        });
    </script>
</body>
</html>