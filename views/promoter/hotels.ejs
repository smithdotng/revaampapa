<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    
    <style>
        .hotel-card {
            transition: transform 0.3s;
            cursor: pointer;
        }
        .hotel-card:hover {
            transform: translateY(-5px);
        }
        .hotel-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 12px 12px 0 0;
        }
        .stat-box {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
        .stat-number {
            font-size: 24px;
            font-weight: 700;
            color: #03A6A6;
        }
        .stat-label {
            font-size: 12px;
            color: #666;
            margin-top: 5px;
        }
        .commission-badge {
            background: #28a745;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            display: inline-block;
        }
        .copy-btn {
            background: #03A6A6;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
        }
        .copy-btn:hover {
            background: #028484;
        }
        .share-buttons {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }
        .share-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 4px;
            color: white;
            text-decoration: none;
            font-size: 12px;
        }
        .share-facebook { background: #3b5998; }
        .share-twitter { background: #1da1f2; }
        .share-whatsapp { background: #25d366; }
        .share-linkedin { background: #0077b5; }
        .recent-click {
            padding: 10px;
            border-bottom: 1px solid #eee;
        }
        .recent-click:last-child {
            border-bottom: none;
        }
    </style>
</head>

<body>

    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/promoter/dashboard">Dashboard</a></li>
                        <li><a href="/promoter/hotels" class="mil-active">Hotels</a></li>
                        <li><a href="/promoter/earnings">Earnings</a></li>
                        <li><a href="/promoter/profile">Profile</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <div class="dropdown"><a href="#" class="mil-btn mil-sm dropdown-toggle"><i class="fa fa-user-circle"></i> <%= user.name %></a></div>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-60 mil-up">Hotel Promotions</h1>
                                <ul class="mil-breadcrumbs mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/promoter/dashboard">Dashboard</a></li>
                                    <li>Hotels</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="mil-blog-list mil-p-0-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-4 col-md-6">
                            <div class="stat-box">
                                <div class="stat-number"><%= totalStats.clicks %></div>
                                <div class="stat-label">Total Clicks</div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-6">
                            <div class="stat-box">
                                <div class="stat-number"><%= totalStats.conversions %></div>
                                <div class="stat-label">Conversions</div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-6">
                            <div class="stat-box">
                                <div class="stat-number">₦<%= totalStats.earnings.toLocaleString() %></div>
                                <div class="stat-label">Total Earnings</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hotels Grid -->
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <h2 class="mil-mb-30">Partner Hotels</h2>
                    <div class="row">
                        <% if (hotels && hotels.length > 0) { %>
                            <% hotels.forEach(function(item) { %>
                            <div class="col-xl-4 col-lg-6 mil-mb-30">
                                <div class="hotel-card mil-price-card mil-up">
                                    <% if (item.hotel.images && item.hotel.images.length > 0) { %>
                                        <img src="<%= item.hotel.images[0].url %>" class="hotel-image" onerror="this.src='/img/hotel-placeholder.jpg'">
                                    <% } else { %>
                                        <div class="hotel-image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                                            <i class="fa fa-building" style="font-size: 48px; color: #ccc;"></i>
                                        </div>
                                    <% } %>
                                    <div style="padding: 20px;">
                                        <div class="row mb-2">
                                            <div class="col-8">
                                                <h5><%= item.hotel.name %></h5>
                                                <p class="mil-text-s mil-soft">
                                                    <i class="fa fa-map-marker"></i> <%= item.hotel.location.city %>, <%= item.hotel.location.state %>
                                                </p>
                                            </div>
                                            <div class="col-4 text-right">
                                                <span class="commission-badge"><%= item.hotel.commissionRate %>% Commission</span>
                                            </div>
                                        </div>
                                        
                                        <div class="row text-center mil-mt-20">
                                            <div class="col-4">
                                                <strong><%= item.clicks %></strong>
                                                <small class="mil-text-s mil-soft">Clicks</small>
                                            </div>
                                            <div class="col-4">
                                                <strong><%= item.conversions %></strong>
                                                <small class="mil-text-s mil-soft">Bookings</small>
                                            </div>
                                            <div class="col-4">
                                                <strong>₦<%= item.earnings.toLocaleString() %></strong>
                                                <small class="mil-text-s mil-soft">Earned</small>
                                            </div>
                                        </div>
                                        
                                        <div class="mil-mt-20">
                                            <input type="text" id="link-<%= item.hotel._id %>" value="<%= item.uniqueLink %>" class="form-control" readonly style="font-size: 12px;">
                                            <div class="mil-mt-10">
                                                <button onclick="copyLink('<%= item.hotel._id %>')" class="copy-btn"><i class="fa fa-copy"></i> Copy Link</button>
                                                <a href="/promoter/hotels/<%= item.hotel._id %>" class="mil-link mil-accent" style="margin-left: 10px;">View Stats →</a>
                                            </div>
                                            <div class="share-buttons">
                                                <a href="#" onclick="shareOnFacebook('<%= item.uniqueLink %>', '<%= item.hotel.name %>')" class="share-btn share-facebook"><i class="fa fa-facebook"></i> Share</a>
                                                <a href="#" onclick="shareOnTwitter('<%= item.uniqueLink %>', '<%= item.hotel.name %>')" class="share-btn share-twitter"><i class="fa fa-twitter"></i> Tweet</a>
                                                <a href="#" onclick="shareOnWhatsApp('<%= item.uniqueLink %>', '<%= item.hotel.name %>')" class="share-btn share-whatsapp"><i class="fa fa-whatsapp"></i> WhatsApp</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-xl-12">
                                <div class="mil-text-center mil-p-60">
                                    <i class="fa fa-hotel" style="font-size: 64px; color: #ccc;"></i>
                                    <h4 class="mil-mt-30">No Hotels Available</h4>
                                    <p class="mil-text-m mil-soft">Check back later for partner hotels to promote.</p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Recent Clicks -->
            <% if (recentClicks && recentClicks.length > 0) { %>
            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-mb-30">
                                <h4 class="mil-mb-30">Recent Clicks</h4>
                                <div class="recent-clicks">
                                    <% recentClicks.forEach(function(click) { %>
                                    <div class="recent-click">
                                        <div class="row align-items-center">
                                            <div class="col-md-4">
                                                <strong><%= click.hotel ? click.hotel.name : 'Unknown Hotel' %></strong>
                                            </div>
                                            <div class="col-md-4">
                                                <small class="mil-soft"><i class="fa fa-clock-o"></i> <%= new Date(click.clickedAt).toLocaleString() %></small>
                                            </div>
                                            <div class="col-md-2">
                                                <% if (click.converted) { %>
                                                    <span class="badge badge-success">Converted ✓</span>
                                                <% } else { %>
                                                    <span class="badge badge-secondary">Click</span>
                                                <% } %>
                                            </div>
                                            <div class="col-md-2">
                                                <small><%= click.referrer || 'Direct' %></small>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <p class="mil-text-s mil-soft">© 2024 RevaampAP. All rights reserved.</p>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .form-control { width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; }
        .badge-success { background: #28a745; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .badge-secondary { background: #6c757d; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; }
        .text-right { text-align: right; }
        .mil-mt-20 { margin-top: 20px; }
        .mil-mt-10 { margin-top: 10px; }
        .mil-mb-20 { margin-bottom: 20px; }
    </style>

    <script>
        function copyLink(hotelId) {
            const linkInput = document.getElementById(`link-${hotelId}`);
            linkInput.select();
            document.execCommand('copy');
            alert('Link copied to clipboard!');
        }
        
        function shareOnFacebook(url, title) {
            const shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
            window.open(shareUrl, '_blank', 'width=600,height=400');
            trackShare('<%= hotels[0]?.hotel?._id %>', '<%= hotels[0]?.uniqueCode %>', 'facebook');
        }
        
        function shareOnTwitter(url, title) {
            const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`Check out this hotel on RevaampAP!`)}&url=${encodeURIComponent(url)}`;
            window.open(shareUrl, '_blank', 'width=600,height=400');
            trackShare('<%= hotels[0]?.hotel?._id %>', '<%= hotels[0]?.uniqueCode %>', 'twitter');
        }
        
        function shareOnWhatsApp(url, title) {
            const shareUrl = `https://wa.me/?text=${encodeURIComponent(`${title} - ${url}`)}`;
            window.open(shareUrl, '_blank');
            trackShare('<%= hotels[0]?.hotel?._id %>', '<%= hotels[0]?.uniqueCode %>', 'whatsapp');
        }
        
        function trackShare(hotelId, code, platform) {
            fetch('/promoter/hotels/track-share', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hotelId, code, platform })
            }).catch(err => console.error('Track share error:', err));
        }
    </script>
</body>
</html>