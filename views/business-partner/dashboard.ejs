<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="RevaampAP" />
    <meta name="description" content="Business Partner Dashboard - Track your earnings, manage promotions, and grow your business" />

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">

    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .dropdown-menu li a:hover { background: #f8f9fa; padding-left: 25px; }
        .mil-table-responsive { overflow-x: auto; }
        .mil-table { width: 100%; border-collapse: collapse; }
        .mil-table th, .mil-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .mil-table th { font-weight: 600; color: #333; background: #f8f9fa; }
        .mil-flex-between { display: flex; justify-content: space-between; align-items: center; }
        .mil-mb-10 { margin-bottom: 10px; }
        .mil-mb-20 { margin-bottom: 20px; }
        .stat-box { background: #f8f9fa; padding: 20px; border-radius: 12px; text-align: center; transition: transform 0.3s; }
        .stat-box:hover { transform: translateY(-5px); }
        .stat-number { font-size: 32px; font-weight: 700; color: #03A6A6; }
        .stat-label { font-size: 14px; color: #666; margin-top: 5px; }
        .mil-buttons-frame { display: flex; gap: 15px; justify-content: center; flex-wrap: wrap; }
        .referral-link-container { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .referral-link-input { flex: 1; padding: 12px; border: none; border-radius: 8px; background: rgba(255,255,255,0.15); color: white; font-size: 14px; word-break: break-all; }

        /* Property cards */
        .property-card { transition: transform 0.3s ease; }
        .property-card:hover { transform: translateY(-5px); }
        .share-link-btn { cursor: pointer; transition: all 0.3s ease; background: #f5576c; color: white; border: none; padding: 10px 15px; border-radius: 8px; font-size: 14px; width: 100%; }
        .share-link-btn:hover { background: #d43a52; }

        /* Share Modal */
        .share-modal { display: none; position: fixed; z-index: 10001; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); align-items: center; justify-content: center; }
        .share-modal-content { background-color: white; border-radius: 16px; width: 90%; max-width: 500px; max-height: 80vh; overflow-y: auto; animation: modalSlideIn 0.3s ease; }
        @keyframes modalSlideIn { from { transform: translateY(-50px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .share-modal-header { padding: 20px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
        .share-modal-header h3 { margin: 0; color: #333; }
        .share-modal-close { background: none; border: none; font-size: 24px; cursor: pointer; color: #999; }
        .share-modal-body { padding: 20px; }
        .share-link-box { background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px; word-break: break-all; }
        .share-link-box code { font-size: 12px; color: #f5576c; }
        .share-options { display: flex; flex-direction: column; gap: 10px; }
        .share-option-btn { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border: none; border-radius: 10px; cursor: pointer; font-size: 16px; font-weight: 500; transition: all 0.3s ease; width: 100%; }
        .share-option-btn:hover { transform: translateX(5px); }
        .share-wa { background: #25d366; color: white; }
        .share-fb { background: #3b5998; color: white; }
        .share-twitter { background: #1da1f2; color: white; }
        .share-linkedin { background: #0077b5; color: white; }
        .share-copy { background: #6c757d; color: white; }
        .share-option-btn i { font-size: 20px; width: 25px; }

        /* QR Modal */
        .qr-modal { display: none; position: fixed; z-index: 10002; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); align-items: center; justify-content: center; }
        .qr-modal-content { background-color: white; border-radius: 20px; width: 90%; max-width: 400px; text-align: center; padding: 30px; animation: modalSlideIn 0.3s ease; }
        .qr-code-container { background: white; padding: 20px; border-radius: 12px; margin: 20px 0; display: flex; justify-content: center; }

        /* Bid notice cards */
        .bid-notice-card { border: 2px solid #f5576c; border-radius: 16px; padding: 25px; margin-bottom: 25px; background: white; transition: box-shadow 0.3s; }
        .bid-notice-card:hover { box-shadow: 0 8px 30px rgba(245,87,108,0.15); }
        .bid-notice-header { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 20px 25px; border-radius: 12px; margin-bottom: 20px; }
        .bid-table { width: 100%; border-collapse: collapse; }
        .bid-table td { padding: 10px 0; border-bottom: 1px solid #f0f0f0; font-size: 15px; }
        .bid-table td:first-child { color: #666; width: 55%; }
        .bid-table td:last-child { font-weight: 700; color: #333; }
        .bid-table tr:last-child td { border-bottom: none; }
        .profit-value { color: #28a745 !important; font-size: 18px !important; }
        .deadline-badge { display: inline-block; background: #fff3cd; color: #856404; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; margin-top: 10px; }
        .notice-closed { opacity: 0.6; }
        .badge-status { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .badge-active { background: #d4edda; color: #155724; }
        .badge-closed { background: #f8d7da; color: #721c24; }
        .badge-pending { background: #fff3cd; color: #856404; }
        .badge-approved { background: #d4edda; color: #155724; }

        /* Tabs */
        .tab-buttons { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid #eee; flex-wrap: wrap; }
        .tab-btn { padding: 10px 20px; background: none; border: none; cursor: pointer; font-weight: 600; color: #666; transition: all 0.3s; }
        .tab-btn.active { color: #f5576c; border-bottom: 2px solid #f5576c; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        @media (max-width: 768px) {
            .mil-table th, .mil-table td { padding: 8px; font-size: 12px; }
            .referral-link-container { flex-direction: column; }
            .referral-link-input { width: 100%; }
        }
    </style>
</head>

<body>
<div id="smooth-wrapper" class="mil-wrapper">
    <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
    <div class="mil-progress-track"><div class="mil-progress"></div></div>
    <div class="progress-wrap active-progress"></div>

    <!-- Nav -->
    <div class="mil-top-panel">
        <div class="container">
            <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
            <nav class="mil-top-menu">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/properties">Properties</a></li>
                    <li class="mil-active"><a href="/business-partner/dashboard">Dashboard</a></li>
                    <li><a href="/business-partner/bid">Place a Bid</a></li>
                    <li><a href="/business-partner/earnings">Earnings</a></li>
                    <li><a href="/business-partner/analytics">Analytics</a></li>
                </ul>
            </nav>
            <div class="mil-menu-buttons">
                <div class="dropdown" style="position: relative;">
                    <a href="#" class="mil-btn mil-sm dropdown-toggle" style="display:flex;align-items:center;gap:8px;">
                        <i class="fa fa-user-circle" style="font-size:18px;"></i>
                        <span><%= user.name %></span>
                        <i class="fa fa-chevron-down" style="font-size:12px;"></i>
                    </a>
                    <ul class="dropdown-menu" style="position:absolute;right:0;top:100%;min-width:220px;background:white;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.15);padding:10px 0;margin-top:10px;z-index:1000;">
                        <li><a href="/business-partner/dashboard"><i class="fa fa-tachometer"></i> Dashboard</a></li>
                        <li><a href="/business-partner/bid"><i class="fa fa-gavel"></i> Place a Bid</a></li>
                        <li><a href="/business-partner/earnings"><i class="fa fa-money"></i> Earnings</a></li>
                        <li><a href="/business-partner/analytics"><i class="fa fa-chart-line"></i> Analytics</a></li>
                        <li><a href="/business-partner/hotels"><i class="fa fa-hotel"></i> Hotels</a></li>
                        <li><a href="/business-partner/settings"><i class="fa fa-cog"></i> Settings</a></li>
                        <li><hr></li>
                        <li><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </div>
                <div class="mil-menu-btn"><span></span></div>
            </div>
        </div>
    </div>

    <div id="smooth-content">

        <!-- Banner -->
        <div class="mil-banner mil-banner-inner mil-dissolve">
            <div class="container">
                <div class="row align-items-center justify-content-center">
                    <div class="col-xl-8">
                        <div class="mil-banner-text mil-text-center">
                            <div class="mil-text-m mil-mb-20 mil-up">Welcome back, <%= user.name %>!</div>
                            <h1 class="mil-mb-60 mil-up">Business Partner Dashboard</h1>
                            <ul class="mil-breadcrumbs mil-pub-info mil-center mil-up">
                                <li><a href="/">Home</a></li>
                                <li>Dashboard</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Benefits Banner -->
        <div class="mil-cta mil-up">
            <div class="container">
                <div class="mil-out-frame mil-p-80-80" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-xl-12 mil-text-center">
                            <h2 class="mil-light mil-mb-30 mil-up">Your Business Partner Benefits</h2>
                            <p class="mil-text-m mil-dark-soft mil-up" style="color:rgba(255,255,255,0.9);">Earn up to 90% commission on property sales · Participate in Premium Discount Forward Contracts · Earn from exclusive bid transactions!</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="mil-blog-list mil-p-0-80">
            <div class="container">
                <div class="row">
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-box mil-up mil-mb-30">
                            <div class="stat-number"><%= stats.totalClicks || 0 %></div>
                            <div class="stat-label">Total Clicks</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-box mil-up mil-mb-30">
                            <div class="stat-number"><%= stats.totalReferrals || 0 %></div>
                            <div class="stat-label">Referrals</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-box mil-up mil-mb-30">
                            <div class="stat-number"><%= stats.totalPropertiesShared || 0 %></div>
                            <div class="stat-label">Properties Shared</div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-box mil-up mil-mb-30">
                            <div class="stat-number">₦<%= (stats.totalEarnings || 0).toLocaleString() %></div>
                            <div class="stat-label">Total Earnings</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============= BID NOTICES SECTION ============= -->
        <div class="mil-blog-list mil-p-80-80" style="background: #fff8f8;">
            <div class="container">
                <div class="mil-text-center mil-mb-60">
                    <span style="background:#f5576c;color:white;padding:6px 16px;border-radius:20px;font-size:13px;font-weight:600;letter-spacing:1px;">EXCLUSIVE TO BUSINESS PARTNERS</span>
                    <h2 class="mil-up" style="margin-top:20px;">Active Bid Notices</h2>
                    <p class="mil-text-m mil-soft mil-up">Bid notices posted by Revaamp management. Submit your bids before the deadline.</p>
                </div>

                <% if (typeof bidNotices !== 'undefined' && bidNotices && bidNotices.length > 0) { %>
                    <div class="row">
                        <% bidNotices.forEach(notice => { %>
                            <div class="col-xl-6 mil-mb-30">
                                <div class="bid-notice-card mil-up">
                                    <div class="bid-notice-header">
                                        <div style="font-size:11px;letter-spacing:2px;opacity:0.85;margin-bottom:8px;">BID NOTICE</div>
                                        <h4 style="color:white;margin:0 0 5px;">Txn: <%= notice.transactionNumber %></h4>
                                        <p style="margin:0;opacity:0.9;font-size:14px;"><i class="fa fa-building-o"></i> <%= notice.client %></p>
                                        <div class="deadline-badge">
                                            <i class="fa fa-clock-o"></i>
                                            Deadline: <%= notice.deadlineText || new Date(notice.deadline).toLocaleString('en-NG', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                                        </div>
                                    </div>

                                    <table class="bid-table">
                                        <tr>
                                            <td>Total Lots Available</td>
                                            <td><%= notice.totalLots %> lots</td>
                                        </tr>
                                        <tr>
                                            <td>Transaction Price per Lot</td>
                                            <td>₦<%= notice.transactionPricePerLot.toLocaleString() %></td>
                                        </tr>
                                        <tr>
                                            <td>Transaction Cost per Lot</td>
                                            <td>₦<%= notice.transactionCostPerLot.toLocaleString() %></td>
                                        </tr>
                                        <tr>
                                            <td>Profit per Lot</td>
                                            <td class="profit-value">₦<%= notice.profitPerLot.toLocaleString() %></td>
                                        </tr>
                                        <tr>
                                            <td>Payment to you</td>
                                            <td>Day <%= notice.paymentToPartnerDays %> from cost receipt</td>
                                        </tr>
                                    </table>

                                    <% if (notice.conditions && notice.conditions.length) { %>
                                        <div style="margin-top:15px;">
                                            <strong style="font-size:13px;color:#555;">CONDITIONS:</strong>
                                            <ul style="margin:6px 0 0 18px;font-size:13px;color:#666;">
                                                <% notice.conditions.forEach(c => { %><li><%= c %></li><% }) %>
                                            </ul>
                                        </div>
                                    <% } %>
                                    <% if (notice.allocationCriteria && notice.allocationCriteria.length) { %>
                                        <div style="margin-top:12px;">
                                            <strong style="font-size:13px;color:#555;">CRITERIA FOR ALLOCATION:</strong>
                                            <ul style="margin:6px 0 0 18px;font-size:13px;color:#666;">
                                                <% notice.allocationCriteria.forEach(c => { %><li><%= c %></li><% }) %>
                                            </ul>
                                        </div>
                                    <% } %>
                                    <% if (notice.importantNotes && notice.importantNotes.length) { %>
                                        <div style="margin-top:12px;">
                                            <strong style="font-size:13px;color:#dc3545;">IMPORTANT NOTES:</strong>
                                            <ul style="margin:6px 0 0 18px;font-size:13px;color:#666;">
                                                <% notice.importantNotes.forEach(n => { %><li><%= n %></li><% }) %>
                                            </ul>
                                        </div>
                                    <% } %>

                                    <div style="margin-top:20px;">
                                        <a href="/business-partner/bid?noticeId=<%= notice._id %>" class="mil-btn mil-accent" style="width:100%;text-align:center;display:block;background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                                            <i class="fa fa-gavel"></i> Submit My Bid
                                        </a>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="col-xl-12">
                        <div class="mil-price-card mil-up mil-text-center" style="padding:60px 20px;">
                            <i class="fa fa-gavel" style="font-size:60px;color:#f5576c;opacity:0.3;margin-bottom:20px;display:block;"></i>
                            <h3 class="mil-mb-15">No Active Bid Notices</h3>
                            <p class="mil-text-m mil-soft">Revaamp management will post bid notices here. Check back soon!</p>
                        </div>
                    </div>
                <% } %>

                <!-- My Recent Bids -->
                <% if (typeof myBids !== 'undefined' && myBids && myBids.length > 0) { %>
                    <div class="mil-price-card mil-up" style="margin-top:40px;">
                        <h4 class="mil-mb-20">My Recent Bids</h4>
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead>
                                    <tr>
                                        <th>Transaction</th>
                                        <th>Client</th>
                                        <th>Lots Bid</th>
                                        <th>Total Cost</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% myBids.slice(0,5).forEach(b => { %>
                                        <tr>
                                            <td><strong><%= b.bidNotice ? b.bidNotice.transactionNumber : 'N/A' %></strong></td>
                                            <td><%= b.bidNotice ? b.bidNotice.client : '—' %></td>
                                            <td><%= b.numberOfLots %></td>
                                            <td>₦<%= (b.totalCost || 0).toLocaleString() %></td>
                                            <td><span class="badge-status badge-<%= b.status %>"><%= b.status %></span></td>
                                            <td style="font-size:12px;"><%= new Date(b.createdAt).toLocaleDateString('en-NG') %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <div style="text-align:center;margin-top:15px;">
                            <a href="/business-partner/bid" class="mil-btn mil-sm mil-light">View All My Bids</a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
        <!-- ============= BID NOTICES SECTION END ============= -->

        <!-- ============= REFERRAL LINK ============= -->
        <div class="mil-blog-list mil-p-80-80">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-xl-10">
                        <div class="mil-price-card mil-up mil-mb-30" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                            <div class="mil-text-center">
                                <i class="fa fa-users" style="font-size:60px;color:white;margin-bottom:20px;"></i>
                                <h2 class="mil-light mil-mb-15">Invite & Earn More!</h2>
                                <p class="mil-dark-soft mil-mb-30" style="color:rgba(255,255,255,0.9);">
                                    Share your unique referral link to invite others to become Business Partners or Promoters.
                                    <strong>Earn 20% administrative fee</strong> from every Business Partner you refer!
                                </p>
                                <div class="referral-link-container" style="background:rgba(255,255,255,0.15);border-radius:12px;padding:20px;margin-bottom:25px;">
                                    <input type="text" id="referralLinkInput" class="referral-link-input" value="Generating link..." readonly>
                                    <button class="mil-btn mil-sm mil-light" onclick="generateAndCopyReferralLink()" style="white-space:nowrap;">
                                        <i class="fa fa-copy"></i> Generate & Copy
                                    </button>
                                </div>
                                <div class="mil-buttons-frame">
                                    <button class="mil-btn mil-md mil-light" onclick="shareOnWhatsApp()"><i class="fa fa-whatsapp"></i> WhatsApp</button>
                                    <button class="mil-btn mil-md mil-light" onclick="shareOnFacebook()"><i class="fa fa-facebook"></i> Facebook</button>
                                    <button class="mil-btn mil-md mil-light" onclick="shareOnTwitter()"><i class="fa fa-twitter"></i> Twitter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============= PROPERTIES FOR SHARING ============= -->
        <div class="mil-blog-list mil-p-80-80" style="background:#fafafa;">
            <div class="container">
                <div class="mil-text-center">
                    <h2 class="mil-mb-30 mil-up">Properties Available for Sharing</h2>
                    <p class="mil-text-m mil-soft mil-mb-60 mil-up">Click "Share Link" on any property to get your unique referral link and share it on social media!</p>
                </div>
                <div class="row" id="propertiesGrid">
                    <% if (typeof properties !== 'undefined' && properties && properties.length > 0) { %>
                        <% properties.forEach(function(property) { %>
                            <div class="col-xl-4 col-md-6 mil-mb-30">
                                <div class="mil-price-card mil-up property-card" style="height:100%;">
                                    <div class="property-image" style="position:relative;overflow:hidden;border-radius:15px;margin-bottom:20px;">
                                        <% if (property.images && property.images.length > 0) { %>
                                            <img src="<%= property.images[0].url %>" alt="<%= property.title %>" style="width:100%;height:220px;object-fit:cover;">
                                        <% } else { %>
                                            <img src="/img/property-placeholder.jpg" alt="<%= property.title %>" style="width:100%;height:220px;object-fit:cover;">
                                        <% } %>
                                        <div style="position:absolute;top:10px;left:10px;">
                                            <span style="background:#28a745;color:white;padding:4px 10px;border-radius:5px;font-size:11px;">✓ Verified</span>
                                        </div>
                                    </div>
                                    <div class="property-content">
                                        <div class="mil-flex-between mil-mb-10">
                                            <h5 style="color:#f5576c;">₦<%= property.price ? property.price.toLocaleString() : '0' %></h5>
                                            <span class="mil-text-xs mil-soft"><%= property.transactionType === 'sale' ? 'For Sale' : 'For Rent' %></span>
                                        </div>
                                        <h4 class="mil-mb-10"><%= property.title %></h4>
                                        <p class="mil-text-s mil-soft mil-mb-15"><i class="fa fa-map-marker"></i> <%= property.location ? property.location.city + ', ' + property.location.state : 'Location TBD' %></p>
                                        <div class="mil-flex-between mil-mb-20">
                                            <div><i class="fa fa-bed"></i> <%= property.features && property.features.bedrooms ? property.features.bedrooms : '0' %> beds</div>
                                            <div><i class="fa fa-bath"></i> <%= property.features && property.features.bathrooms ? property.features.bathrooms : '0' %> baths</div>
                                            <div><i class="fa fa-car"></i> <%= property.features && property.features.parkingSpaces ? property.features.parkingSpaces : '0' %> parking</div>
                                        </div>
                                        <button class="share-link-btn" onclick="openShareModal('<%= property._id %>', '<%= property.title.replace(/'/g, "\\'") %>')">
                                            <i class="fa fa-share-alt"></i> Share Link
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-xl-12">
                            <div class="mil-price-card mil-up mil-text-center" style="padding:60px 20px;">
                                <i class="fa fa-building-o" style="font-size:60px;opacity:0.3;margin-bottom:20px;display:block;"></i>
                                <h3 class="mil-mb-15">No Properties Available</h3>
                                <p class="mil-text-m mil-soft">Check back soon for new properties to promote!</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Share Modal -->
        <div id="shareModal" class="share-modal">
            <div class="share-modal-content">
                <div class="share-modal-header">
                    <h3><i class="fa fa-share-alt"></i> Share Property</h3>
                    <button class="share-modal-close" onclick="closeShareModal()">&times;</button>
                </div>
                <div class="share-modal-body">
                    <div id="sharePropertyTitle" style="font-weight:600;margin-bottom:15px;color:#f5576c;"></div>
                    <div class="share-link-box"><code id="sharePropertyLink">Loading...</code></div>
                    <div class="share-options">
                        <button class="share-option-btn share-wa" onclick="shareToWhatsApp()"><i class="fa fa-whatsapp"></i> Share on WhatsApp</button>
                        <button class="share-option-btn share-fb" onclick="shareToFacebook()"><i class="fa fa-facebook"></i> Share on Facebook</button>
                        <button class="share-option-btn share-twitter" onclick="shareToTwitter()"><i class="fa fa-twitter"></i> Share on Twitter</button>
                        <button class="share-option-btn share-linkedin" onclick="shareToLinkedIn()"><i class="fa fa-linkedin"></i> Share on LinkedIn</button>
                        <button class="share-option-btn share-copy" onclick="copyShareLink()"><i class="fa fa-copy"></i> Copy Link</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- QR Modal -->
        <div id="qrModal" class="qr-modal">
            <div class="qr-modal-content">
                <h3><i class="fa fa-qrcode"></i> Scan QR Code</h3>
                <div class="qr-code-container" id="qrCodeContainer"></div>
                <button class="share-modal-close" style="margin-top:15px;background:none;border:none;color:#999;cursor:pointer;" onclick="closeQRModal()">Close</button>
            </div>
        </div>

        <!-- ============= ACTIVITY TABS ============= -->
        <div class="mil-blog-list mil-p-80-80">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="mil-price-card mil-up mil-mb-30">
                            <div class="tab-buttons">
                                <button class="tab-btn active" onclick="showTab('promotions')">🏠 My Promotions</button>
                                <button class="tab-btn" onclick="showTab('referrals')">👥 Referrals</button>
                                <button class="tab-btn" onclick="showTab('clicks')">📊 Clicks</button>
                                <button class="tab-btn" onclick="showTab('conversions')">💰 Conversions</button>
                            </div>

                            <div id="promotionsTab" class="tab-content active">
                                <h4 class="mil-mb-20">Your Active Property Promotions</h4>
                                <div id="promotionsList"><p class="mil-soft" style="padding:20px 0;">Loading...</p></div>
                            </div>
                            <div id="referralsTab" class="tab-content">
                                <h4 class="mil-mb-20">Your Referrals</h4>
                                <div id="referralsTable"><p class="mil-soft" style="padding:20px 0;">Loading...</p></div>
                            </div>
                            <div id="clicksTab" class="tab-content">
                                <h4 class="mil-mb-20">Recent Clicks</h4>
                                <div id="clicksTable"><p class="mil-soft" style="padding:20px 0;">Loading...</p></div>
                            </div>
                            <div id="conversionsTab" class="tab-content">
                                <h4 class="mil-mb-20">Conversions</h4>
                                <div id="conversionsTable"><p class="mil-soft" style="padding:20px 0;">Loading...</p></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="mil-cta mil-up">
            <div class="container">
                <div class="mil-out-frame mil-p-80-80" style="background:#f8f9fa;">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-xl-12 mil-text-center">
                            <h2 class="mil-mb-30 mil-up">Quick Actions</h2>
                            <div class="mil-buttons-frame mil-up">
                                <a href="/business-partner/bid" class="mil-btn mil-sm" style="background:linear-gradient(135deg,#f093fb 0%,#f5576c 100%);color:white;"><i class="fa fa-gavel"></i> Place a Bid</a>
                                <a href="/business-partner/hotels" class="mil-btn mil-sm mil-light">Promote Hotels</a>
                                <a href="/business-partner/submit-property" class="mil-btn mil-sm mil-light">Submit Property</a>
                                <a href="/business-partner/submit-buyer" class="mil-btn mil-sm mil-light">Submit Buyer</a>
                                <a href="/business-partner/earnings" class="mil-btn mil-sm mil-light">View Earnings</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="mil-p-80-0">
            <div class="container">
                <div class="row">
                    <div class="col-xl-3">
                        <a href="/" class="mil-footer-logo mil-mb-60"><img src="/img/logo-2.png" alt="RevaampAP" width="28" height="32"></a>
                    </div>
                    <div class="col-xl-3 mil-mb-60">
                        <h6 class="mil-mb-60">Quick Links</h6>
                        <ul class="mil-footer-list">
                            <li class="mil-text-m mil-soft mil-mb-15"><a href="/">Home</a></li>
                            <li class="mil-text-m mil-soft mil-mb-15"><a href="/properties">Properties</a></li>
                            <li class="mil-text-m mil-soft mil-mb-15"><a href="/business-partner/dashboard">Dashboard</a></li>
                        </ul>
                    </div>
                    <div class="col-xl-3 mil-mb-60">
                        <h6 class="mil-mb-60">Support</h6>
                        <ul class="mil-footer-list">
                            <li class="mil-text-m mil-soft mil-mb-15"><a href="/contact">Contact Us</a></li>
                            <li class="mil-text-m mil-soft mil-mb-15"><a href="/how-it-works">How It Works</a></li>
                        </ul>
                    </div>
                    <div class="col-xl-3 mil-mb-80">
                        <h6 class="mil-mb-60">Newsletter</h6>
                        <form class="mil-subscripe-form-footer" id="footerNewsletterForm">
                            <input class="mil-input" type="email" placeholder="Email">
                            <button type="submit"><i class="far fa-envelope-open mil-dark"></i></button>
                        </form>
                    </div>
                </div>
                <div class="mil-footer-bottom">
                    <div class="row">
                        <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA All rights reserved.</p></div>
                        <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Business Partner Dashboard</p></div>
                    </div>
                </div>
            </div>
        </footer>

    </div>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script src="/js/plugins/swiper.min.js"></script>
<script src="/js/plugins/gsap.min.js"></script>
<script src="/js/plugins/ScrollSmoother.min.js"></script>
<script src="/js/plugins/ScrollTrigger.min.js"></script>
<script src="/js/plugins/ScrollTo.min.js"></script>
<script src="/js/plugins/magnific-popup.js"></script>
<script src="/js/main.js"></script>

<script>
    let referralLink = null;
    let currentPropertyLink = null;

    // ---- Referral link ----
    async function generateAndCopyReferralLink() {
        try {
            const response = await fetch('/business-partner/api/generate-referral-link');
            const data = await response.json();
            if (data.success) {
                referralLink = data.link;
                document.getElementById('referralLinkInput').value = referralLink;
                document.getElementById('referralLinkInput').select();
                document.execCommand('copy');
                alert('Referral link copied to clipboard!');
                trackShare('copy', 'referral', referralLink);
            } else {
                alert('Error generating referral link.');
            }
        } catch (e) { alert('Error generating referral link.'); }
    }

    async function loadReferralLink() {
        try {
            const response = await fetch('/business-partner/api/generate-referral-link');
            const data = await response.json();
            if (data.success) {
                referralLink = data.link;
                document.getElementById('referralLinkInput').value = referralLink;
            }
        } catch (e) {}
    }

    function shareOnWhatsApp() {
        if (!referralLink) { alert('Please generate your referral link first.'); return; }
        const msg = `Become a Business Partner using my referral link: ${referralLink} and earn up to 90% commission plus participate in premium discount forward contracts!`;
        window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, '_blank');
        trackShare('whatsapp', 'referral', referralLink);
    }
    function shareOnFacebook() {
        if (!referralLink) { alert('Please generate your referral link first.'); return; }
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(referralLink)}`, '_blank', 'width=600,height=400');
        trackShare('facebook', 'referral', referralLink);
    }
    function shareOnTwitter() {
        if (!referralLink) { alert('Please generate your referral link first.'); return; }
        const text = `Become a Business Partner and earn up to 90% commission on property sales!`;
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(referralLink)}`, '_blank', 'width=600,height=400');
        trackShare('twitter', 'referral', referralLink);
    }

    async function trackShare(platform, linkType, link) {
        try {
            await fetch('/business-partner/api/track-share', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ platform, link, linkType })
            });
        } catch (e) {}
    }

    // ---- Property share modal ----
    async function openShareModal(propertyId, propertyTitle) {
        document.getElementById('shareModal').style.display = 'flex';
        document.getElementById('sharePropertyTitle').textContent = propertyTitle;
        document.getElementById('sharePropertyLink').textContent = 'Generating link...';
        currentPropertyLink = null;
        try {
            const response = await fetch(`/business-partner/api/promotion/${propertyId}`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            const data = await response.json();
            if (data.success && data.shareLink) {
                currentPropertyLink = data.shareLink;
                document.getElementById('sharePropertyLink').textContent = currentPropertyLink;
            } else {
                const base = window.location.origin;
                const ref = referralLink ? referralLink.split('ref=')[1] : '';
                currentPropertyLink = `${base}/properties/${propertyId}${ref ? '?ref=' + ref : ''}`;
                document.getElementById('sharePropertyLink').textContent = currentPropertyLink;
            }
        } catch (e) {
            currentPropertyLink = window.location.origin + '/properties/' + propertyId;
            document.getElementById('sharePropertyLink').textContent = currentPropertyLink;
        }
    }
    function closeShareModal() { document.getElementById('shareModal').style.display = 'none'; }
    function shareToWhatsApp() {
        if (!currentPropertyLink) return;
        window.open(`https://wa.me/?text=${encodeURIComponent('🏠 Check out this property: ' + currentPropertyLink)}`, '_blank');
        trackShare('whatsapp', 'property', currentPropertyLink);
    }
    function shareToFacebook() {
        if (!currentPropertyLink) return;
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentPropertyLink)}`, '_blank', 'width=600,height=400');
        trackShare('facebook', 'property', currentPropertyLink);
    }
    function shareToTwitter() {
        if (!currentPropertyLink) return;
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent('🏠 Check out this property!')}&url=${encodeURIComponent(currentPropertyLink)}`, '_blank', 'width=600,height=400');
        trackShare('twitter', 'property', currentPropertyLink);
    }
    function shareToLinkedIn() {
        if (!currentPropertyLink) return;
        window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentPropertyLink)}`, '_blank', 'width=600,height=400');
    }
    function copyShareLink() {
        if (!currentPropertyLink) return;
        navigator.clipboard.writeText(currentPropertyLink).then(() => alert('Link copied!')).catch(() => {
            const el = document.createElement('textarea');
            el.value = currentPropertyLink;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            alert('Link copied!');
        });
        trackShare('copy', 'property', currentPropertyLink);
    }
    function closeQRModal() { document.getElementById('qrModal').style.display = 'none'; }

    // ---- Activity tabs ----
    function showTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(tabName + 'Tab').classList.add('active');
        event.target.classList.add('active');
        if (tabName === 'promotions') loadPromotions();
        if (tabName === 'referrals') loadReferrals();
        if (tabName === 'clicks') loadClicks();
        if (tabName === 'conversions') loadConversions();
    }

    async function loadPromotions() {
        const el = document.getElementById('promotionsList');
        try {
            const r = await fetch('/business-partner/api/promotions');
            const data = await r.json();
            if (data.success && data.promotions && data.promotions.length) {
                el.innerHTML = `<div class="mil-table-responsive"><table class="mil-table"><thead><tr><th>Property</th><th>Clicks</th><th>Status</th><th>Date</th></tr></thead><tbody>${data.promotions.map(p => `<tr><td>${p.property?.title || '—'}</td><td>${p.clicks || 0}</td><td>${p.status}</td><td>${new Date(p.createdAt).toLocaleDateString()}</td></tr>`).join('')}</tbody></table></div>`;
            } else { el.innerHTML = '<p class="mil-soft" style="padding:20px 0;">No active promotions yet.</p>'; }
        } catch (e) { el.innerHTML = '<p class="mil-soft">Error loading promotions.</p>'; }
    }

    async function loadReferrals() {
        const el = document.getElementById('referralsTable');
        try {
            const r = await fetch('/business-partner/api/referrals');
            const data = await r.json();
            if (data.success && data.referrals && data.referrals.length) {
                el.innerHTML = `<div class="mil-table-responsive"><table class="mil-table"><thead><tr><th>Name</th><th>Email</th><th>Date</th></tr></thead><tbody>${data.referrals.map(r => `<tr><td>${r.name || '—'}</td><td>${r.email || '—'}</td><td>${new Date(r.createdAt).toLocaleDateString()}</td></tr>`).join('')}</tbody></table></div>`;
            } else { el.innerHTML = '<p class="mil-soft" style="padding:20px 0;">No referrals yet.</p>'; }
        } catch (e) { el.innerHTML = '<p class="mil-soft">Error loading referrals.</p>'; }
    }

    async function loadClicks() {
        const el = document.getElementById('clicksTable');
        try {
            const r = await fetch('/business-partner/api/clicks');
            const data = await r.json();
            if (data.success && data.clicks && data.clicks.length) {
                el.innerHTML = `<div class="mil-table-responsive"><table class="mil-table"><thead><tr><th>Type</th><th>IP</th><th>Date</th></tr></thead><tbody>${data.clicks.map(c => `<tr><td>${c.linkType || 'property'}</td><td>${c.ipAddress || '—'}</td><td>${new Date(c.clickedAt || c.createdAt).toLocaleDateString()}</td></tr>`).join('')}</tbody></table></div>`;
            } else { el.innerHTML = '<p class="mil-soft" style="padding:20px 0;">No click data yet.</p>'; }
        } catch (e) { el.innerHTML = '<p class="mil-soft">Error loading clicks.</p>'; }
    }

    async function loadConversions() {
        const el = document.getElementById('conversionsTable');
        try {
            const r = await fetch('/business-partner/api/conversions');
            const data = await r.json();
            if (data.success && data.conversions && data.conversions.length) {
                el.innerHTML = `<div class="mil-table-responsive"><table class="mil-table"><thead><tr><th>Property</th><th>Amount</th><th>Commission</th><th>Date</th></tr></thead><tbody>${data.conversions.map(c => `<tr><td>${c.property?.title || '—'}</td><td>₦${(c.salePrice || 0).toLocaleString()}</td><td>₦${(c.commissionSplit?.promoter?.amount || 0).toLocaleString()}</td><td>${new Date(c.transactionDate || c.createdAt).toLocaleDateString()}</td></tr>`).join('')}</tbody></table></div>`;
            } else { el.innerHTML = '<p class="mil-soft" style="padding:20px 0;">No conversions yet.</p>'; }
        } catch (e) { el.innerHTML = '<p class="mil-soft">Error loading conversions.</p>'; }
    }

    // Newsletter
    document.addEventListener('DOMContentLoaded', function() {
        loadReferralLink();
        loadPromotions();
        const form = document.getElementById('footerNewsletterForm');
        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = form.querySelector('input[type="email"]').value;
                try {
                    const r = await fetch('/api/subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ email }) });
                    const data = await r.json();
                    alert(data.success ? 'Subscribed!' : 'Error.');
                    if (data.success) form.reset();
                } catch (e) { alert('Error.'); }
            });
        }
    });
</script>
</body>
</html>
