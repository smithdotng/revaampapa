<!DOCTYPE html>
<html lang="en-US">
<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <style>
        .dropdown-menu { display: none; }
        .dropdown:hover .dropdown-menu, .dropdown .dropdown-menu.show { display: block; }
        .mil-table { width:100%; border-collapse:collapse; }
        .mil-table th, .mil-table td { padding:12px; text-align:left; border-bottom:1px solid #eee; }
        .mil-table th { font-weight:600; color:#333; background:#f8f9fa; }
        .mil-table-responsive { overflow-x:auto; }
        .bid-notice-card { border:2px solid #f5576c; border-radius:16px; padding:25px; margin-bottom:25px; cursor:pointer; transition:all 0.3s; }
        .bid-notice-card:hover, .bid-notice-card.selected { box-shadow:0 8px 30px rgba(245,87,108,0.25); border-color:#f5576c; background:#fff8f8; }
        .bid-notice-header { background:linear-gradient(135deg,#f093fb 0%,#f5576c 100%); color:white; padding:15px 20px; border-radius:10px; margin-bottom:15px; }
        .notice-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f5f5f5; font-size:14px; }
        .notice-row:last-child { border-bottom:none; }
        .profit-value { color:#28a745; font-weight:700; }
        .badge-status { display:inline-block; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:600; }
        .badge-pending { background:#fff3cd; color:#856404; }
        .badge-approved { background:#d4edda; color:#155724; }
        .badge-rejected { background:#f8d7da; color:#721c24; }
        .cost-preview { background:#f8f9fa; border-radius:10px; padding:15px; margin-top:15px; display:none; }
    </style>
</head>
<body>
<div id="smooth-wrapper" class="mil-wrapper">
    <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
    <div class="mil-progress-track"><div class="mil-progress"></div></div>
    <div class="progress-wrap active-progress"></div>

    <div class="mil-top-panel">
        <div class="container">
            <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
            <nav class="mil-top-menu">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/business-partner/hotels">Hotels</a></li>
                    <li><a href="/business-partner/dashboard">Dashboard</a></li>
                    <li class="mil-active"><a href="/business-partner/bid">Bid</a></li>
                    <li><a href="/business-partner/earnings">Earnings</a></li>
                    <li><a href="/business-partner/settings">Settings</a></li>
                </ul>
            </nav>
            <div class="mil-menu-buttons">
                <div class="dropdown" style="position:relative;">
                    <a href="#" class="mil-btn mil-sm dropdown-toggle"><i class="fa fa-user-circle"></i> <%= user.name %></a>
                    <ul class="dropdown-menu" style="position:absolute;right:0;top:100%;min-width:220px;background:white;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.15);padding:10px 0;margin-top:10px;z-index:1000;">
                        <li><a href="/business-partner/dashboard">Dashboard</a></li>
                        <li><a href="/business-partner/bid">Place a Bid</a></li>
                        <li><a href="/business-partner/settings">Settings</a></li>
                        <li><hr></li>
                        <li><a href="/logout">Logout</a></li>
                    </ul>
                </div>
                <div class="mil-menu-btn"><span></span></div>
            </div>
        </div>
    </div>

    <div id="smooth-content">
        <div class="mil-banner mil-banner-inner mil-dissolve">
            <div class="container">
                <div class="row align-items-center justify-content-center">
                    <div class="col-xl-8">
                        <div class="mil-banner-text mil-text-center">
                            <h1 class="mil-mb-60 mil-up">Place a Bid</h1>
                            <ul class="mil-breadcrumbs mil-center mil-up">
                                <li><a href="/">Home</a></li>
                                <li><a href="/business-partner/dashboard">Dashboard</a></li>
                                <li>Bid</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mil-blog-list mil-p-80-80">
            <div class="container">
                <% if (locals.success && success.length) { %>
                    <div style="background:#d4edda;color:#155724;padding:15px;border-radius:8px;margin-bottom:20px;"><%= success[0] %></div>
                <% } %>
                <% if (locals.error && error.length) { %>
                    <div style="background:#f8d7da;color:#721c24;padding:15px;border-radius:8px;margin-bottom:20px;"><%= error[0] %></div>
                <% } %>

                <div class="row">
                    <!-- Active Notices + Form -->
                    <div class="col-xl-8">
                        <% if (typeof bidNotices !== 'undefined' && bidNotices && bidNotices.length > 0) { %>
                            <h3 class="mil-mb-30">Active Bid Notices</h3>
                            <% bidNotices.forEach(notice => { %>
                                <div class="bid-notice-card mil-up <%= selectedNotice && selectedNotice._id.toString() === notice._id.toString() ? 'selected' : '' %>"
                                     onclick="selectNotice('<%= notice._id %>', <%= notice.transactionCostPerLot %>, '<%= notice.transactionNumber %>', '<%= notice.client %>', <%= notice.totalLots %>)">
                                    <div class="bid-notice-header">
                                        <div style="font-size:11px;letter-spacing:2px;opacity:0.85;margin-bottom:5px;">BID NOTICE</div>
                                        <h5 style="color:white;margin:0 0 3px;">Txn: <%= notice.transactionNumber %></h5>
                                        <p style="margin:0;opacity:0.9;font-size:13px;"><%= notice.client %></p>
                                    </div>
                                    <div class="notice-row"><span style="color:#666;">Total Lots</span><span><%= notice.totalLots %></span></div>
                                    <div class="notice-row"><span style="color:#666;">Transaction Price/Lot</span><span>₦<%= notice.transactionPricePerLot.toLocaleString() %></span></div>
                                    <div class="notice-row"><span style="color:#666;">Transaction Cost/Lot</span><span>₦<%= notice.transactionCostPerLot.toLocaleString() %></span></div>
                                    <div class="notice-row"><span style="color:#666;">Profit/Lot</span><span class="profit-value">₦<%= notice.profitPerLot.toLocaleString() %></span></div>
                                    <div class="notice-row">
                                        <span style="color:#666;">Deadline</span>
                                        <span style="color:#dc3545;font-weight:600;">
                                            <%= notice.deadlineText || new Date(notice.deadline).toLocaleString('en-NG', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                                        </span>
                                    </div>
                                    <% if (notice.conditions && notice.conditions.length) { %>
                                        <div style="margin-top:12px;padding-top:12px;border-top:1px dashed #eee;">
                                            <strong style="font-size:12px;color:#555;">CONDITIONS:</strong>
                                            <ul style="margin:5px 0 0 16px;font-size:12px;color:#666;">
                                                <% notice.conditions.forEach(c => { %><li><%= c %></li><% }) %>
                                            </ul>
                                        </div>
                                    <% } %>
                                    <% if (notice.importantNotes && notice.importantNotes.length) { %>
                                        <div style="margin-top:10px;">
                                            <strong style="font-size:12px;color:#dc3545;">IMPORTANT:</strong>
                                            <ul style="margin:5px 0 0 16px;font-size:12px;color:#666;">
                                                <% notice.importantNotes.forEach(n => { %><li><%= n %></li><% }) %>
                                            </ul>
                                        </div>
                                    <% } %>
                                    <div style="margin-top:12px;font-size:12px;color:#03A6A6;font-weight:600;">
                                        <i class="fa fa-hand-o-right"></i> Click to select this notice and bid
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="mil-price-card mil-up mil-text-center" style="padding:60px 20px;">
                                <i class="fa fa-gavel" style="font-size:60px;color:#f5576c;opacity:0.3;margin-bottom:20px;display:block;"></i>
                                <h3 class="mil-mb-15">No Active Bid Notices</h3>
                                <p class="mil-text-m mil-soft">Revaamp management will post bid notices here. Check back soon!</p>
                                <a href="/business-partner/dashboard" class="mil-btn mil-sm mil-light" style="margin-top:20px;">← Back to Dashboard</a>
                            </div>
                        <% } %>
                    </div>

                    <!-- Bid Form -->
                    <div class="col-xl-4">
                        <div class="mil-price-card mil-up" style="position:sticky;top:100px;">
                            <h4 class="mil-mb-20"><i class="fa fa-gavel"></i> Submit Your Bid</h4>
                            <% if (bidNotices && bidNotices.length > 0) { %>
                                <form action="/business-partner/bid" method="POST" id="bidForm">
                                    <input type="hidden" name="bidNoticeId" id="bidNoticeId" value="<%= selectedNotice ? selectedNotice._id : '' %>">

                                    <div id="selectedNoticePreview" style="background:linear-gradient(135deg,#f093fb 0%,#f5576c 100%);color:white;padding:12px 16px;border-radius:10px;margin-bottom:15px;<%= selectedNotice ? '' : 'display:none' %>">
                                        <div style="font-size:11px;opacity:0.8;">SELECTED NOTICE</div>
                                        <div id="previewTxn" style="font-weight:700;"><%= selectedNotice ? selectedNotice.transactionNumber : '' %></div>
                                        <div id="previewClient" style="font-size:12px;opacity:0.9;"><%= selectedNotice ? selectedNotice.client : '' %></div>
                                    </div>

                                    <div style="<%= selectedNotice ? '' : 'display:none' %>" id="noSelectionMsg" class="mil-mb-15">
                                    </div>
                                    <div id="noSelectionHint" style="<%= selectedNotice ? 'display:none' : '' %>;color:#999;font-size:14px;padding:15px;background:#f8f9fa;border-radius:8px;margin-bottom:15px;">
                                        <i class="fa fa-arrow-left"></i> Select a bid notice on the left to continue.
                                    </div>

                                    <div class="mil-mb-15">
                                        <label class="mil-text-sm mil-soft mil-mb-10">Number of Lots *</label>
                                        <input type="number" name="numberOfLots" id="numberOfLots" class="mil-input" placeholder="e.g. 5" min="1" required onchange="updateCostPreview()">
                                    </div>

                                    <div class="cost-preview" id="costPreview">
                                        <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:8px;">
                                            <span style="color:#666;">Cost per lot</span>
                                            <span id="previewCostPerLot">₦0</span>
                                        </div>
                                        <div style="display:flex;justify-content:space-between;font-size:16px;font-weight:700;color:#f5576c;">
                                            <span>Total to pay</span>
                                            <span id="previewTotalCost">₦0</span>
                                        </div>
                                        <div style="display:flex;justify-content:space-between;font-size:14px;color:#28a745;margin-top:8px;">
                                            <span>Potential profit</span>
                                            <span id="previewProfit">₦0</span>
                                        </div>
                                    </div>

                                    <div class="mil-mb-20" style="margin-top:15px;">
                                        <label class="mil-text-sm mil-soft mil-mb-10">Message (optional)</label>
                                        <textarea name="message" class="mil-input" rows="3" placeholder="Add any notes..."></textarea>
                                    </div>

                                    <button type="submit" class="mil-btn mil-accent" style="width:100%;background:linear-gradient(135deg,#f093fb 0%,#f5576c 100%);" id="submitBtn">
                                        <i class="fa fa-gavel"></i> Submit Bid
                                    </button>
                                </form>
                            <% } else { %>
                                <p class="mil-soft">No active notices to bid on.</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- My Bids History -->
                <% if (typeof myBids !== 'undefined' && myBids && myBids.length > 0) { %>
                    <div class="mil-price-card mil-up" style="margin-top:50px;">
                        <h4 class="mil-mb-20">My Bid History</h4>
                        <div class="mil-table-responsive">
                            <table class="mil-table">
                                <thead>
                                    <tr>
                                        <th>Transaction</th>
                                        <th>Client</th>
                                        <th>Lots</th>
                                        <th>Total Cost</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% myBids.forEach(b => { %>
                                        <tr>
                                            <td><strong><%= b.bidNotice ? b.bidNotice.transactionNumber : 'N/A' %></strong></td>
                                            <td><%= b.bidNotice ? b.bidNotice.client : '—' %></td>
                                            <td><%= b.numberOfLots %></td>
                                            <td>₦<%= (b.totalCost || 0).toLocaleString() %></td>
                                            <td><span class="badge-status badge-<%= b.status %>"><%= b.status %></span></td>
                                            <td style="font-size:12px;"><%= new Date(b.createdAt).toLocaleDateString('en-NG') %></td>
                                        </tr>
                                        <% if (b.message) { %>
                                            <tr><td colspan="6" style="font-size:12px;color:#777;font-style:italic;padding-top:0;">Note: <%= b.message %></td></tr>
                                        <% } %>
                                        <% if (b.adminNote) { %>
                                            <tr><td colspan="6" style="font-size:12px;color:#03A6A6;padding-top:0;"><strong>Admin note:</strong> <%= b.adminNote %></td></tr>
                                        <% } %>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <footer class="mil-p-80-0">
            <div class="container"><div class="mil-footer-bottom"><p class="mil-text-s mil-soft">© 2026 RevaampAPA All rights reserved.</p></div></div>
        </footer>
    </div>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script src="/js/plugins/gsap.min.js"></script>
<script src="/js/plugins/ScrollSmoother.min.js"></script>
<script src="/js/plugins/ScrollTrigger.min.js"></script>
<script src="/js/main.js"></script>

<script>
    // Store notice data for cost preview
    const noticeData = {};
    <% if (typeof bidNotices !== 'undefined' && bidNotices) { %>
        <% bidNotices.forEach(n => { %>
            noticeData['<%= n._id %>'] = {
                costPerLot: <%= n.transactionCostPerLot %>,
                profitPerLot: <%= n.profitPerLot %>,
                txn: '<%= n.transactionNumber %>',
                client: '<%= n.client.replace(/'/g, "\\'") %>',
                totalLots: <%= n.totalLots %>
            };
        <% }) %>
    <% } %>

    let selectedNoticeId = '<%= selectedNotice ? selectedNotice._id : "" %>';
    let selectedCostPerLot = <%= selectedNotice ? selectedNotice.transactionCostPerLot : 0 %>;
    let selectedProfitPerLot = <%= selectedNotice ? selectedNotice.profitPerLot : 0 %>;

    function selectNotice(id, costPerLot, txn, client, totalLots) {
        // Deselect all
        document.querySelectorAll('.bid-notice-card').forEach(c => c.classList.remove('selected'));
        // Select clicked
        event.currentTarget.classList.add('selected');

        selectedNoticeId = id;
        const nd = noticeData[id] || { costPerLot, profitPerLot: 0, txn, client };
        selectedCostPerLot = nd.costPerLot;
        selectedProfitPerLot = nd.profitPerLot;

        document.getElementById('bidNoticeId').value = id;
        document.getElementById('selectedNoticePreview').style.display = 'block';
        document.getElementById('previewTxn').textContent = nd.txn || txn;
        document.getElementById('previewClient').textContent = nd.client || client;
        document.getElementById('noSelectionHint').style.display = 'none';

        updateCostPreview();
        // Scroll to form on mobile
        if (window.innerWidth < 992) {
            document.getElementById('bidForm').scrollIntoView({ behavior: 'smooth' });
        }
    }

    function updateCostPreview() {
        const lots = parseInt(document.getElementById('numberOfLots').value) || 0;
        if (lots > 0 && selectedCostPerLot > 0) {
            const totalCost = lots * selectedCostPerLot;
            const totalProfit = lots * selectedProfitPerLot;
            document.getElementById('previewCostPerLot').textContent = '₦' + selectedCostPerLot.toLocaleString();
            document.getElementById('previewTotalCost').textContent = '₦' + totalCost.toLocaleString();
            document.getElementById('previewProfit').textContent = '₦' + totalProfit.toLocaleString();
            document.getElementById('costPreview').style.display = 'block';
        } else {
            document.getElementById('costPreview').style.display = 'none';
        }
    }

    // Auto-select if noticeId in URL
    <% if (selectedNotice) { %>
        document.addEventListener('DOMContentLoaded', () => {
            const card = document.querySelector('.bid-notice-card.selected');
            if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    <% } %>
</script>
</body>
</html>
