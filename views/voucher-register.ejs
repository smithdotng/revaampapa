<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="author" content="RevaampAPA">
    <title>Revaamp Room Voucher Subscription | Cashback on Hotel Stays</title>
    <meta name="description" content="Subscribe to the Revaamp Room Voucher and earn cashback on stays at any hotel listed on RevaampAPA. Register your stay before you check in and claim your discount as cashback.">
    <meta name="robots" content="index, follow">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://revaampapa.com/voucher/register">
    <meta property="og:title" content="Revaamp Room Voucher — Cashback on Every Stay">
    <meta property="og:description" content="Subscribe once, then earn cashback on stays at any hotel listed on RevaampAPA. Register your stay before check-in to claim.">
    <meta property="og:site_name" content="RevaampAPA">
    <meta property="og:locale" content="en_NG">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Revaamp Room Voucher — Cashback on Every Stay">
    <meta name="twitter:description" content="Subscribe once, then earn cashback on stays at any hotel listed on RevaampAPA.">
    <link rel="canonical" href="https://revaampapa.com/voucher/register">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/properties">Properties</a></li>
                        <li><a href="/hotels">Hotels</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <a href="/login" class="mil-btn mil-sm">Log in</a>
                    <a href="/hotels" class="mil-btn mil-sm mil-light">Browse Hotels</a>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-exclamation-circle"></i> <%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fa fa-check-circle"></i> <%= success %></div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Cashback on Hotel Stays</div>
                                <h1 class="mil-mb-60 mil-up">Revaamp Room Voucher</h1>
                                <ul class="mil-breadcrumbs mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/hotels">Hotels</a></li>
                                    <li><a href="/voucher/register">Room Voucher</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-cta mil-up mil-mt-30">
                <div class="container">
                    <div class="mil-out-frame mil-p-80-80" style="background: linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%);">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-xl-12 mil-text-center">
                                <h2 class="mil-light mil-mb-15 mil-up">Subscribe once. Get money back on every stay.</h2>
                                <p class="mil-text-m mil-light mil-mb-0 mil-up">Discounted rates at every listed hotel &nbsp;|&nbsp; Paid to you as cashback &nbsp;|&nbsp; Register your stay to claim</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- How it works -->
            <div class="mil-features mil-p-80-40">
                <div class="container">
                    <div class="mil-text-center mil-mb-60">
                        <h2 class="mil-mb-30 mil-up">How the Room Voucher works</h2>
                        <p class="mil-text-m mil-soft mil-up">Three steps, and the third one is the one people forget.</p>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-id-card-o" style="font-size:45px;color:#6C2BD9;"></i>
                                <h5 class="mil-mb-10 mil-mt-15">1. Subscribe</h5>
                                <p class="mil-text-s mil-soft">Join the programme and get your membership number. It is what identifies you at any hotel listed on Revaamp.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-building-o" style="font-size:45px;color:#6C2BD9;"></i>
                                <h5 class="mil-mb-10 mil-mt-15">2. Pick a listed hotel</h5>
                                <p class="mil-text-s mil-soft">Every hotel in the Revaamp directory carries a cashback rate. Browse them and choose where you want to stay.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%; border:2px solid #6C2BD9;">
                                <i class="fa fa-check-square-o" style="font-size:45px;color:#6C2BD9;"></i>
                                <h5 class="mil-mb-10 mil-mt-15">3. Register your stay <em>before</em> you go</h5>
                                <p class="mil-text-s mil-soft"><strong>This is the part that matters.</strong> Register your interest against that specific hotel before check-in. No registered stay means no claim &mdash; cashback cannot be applied retroactively.</p>
                            </div>
                        </div>
                    </div>
                    <div class="mil-text-center mil-mt-30">
                        <p class="mil-text-s mil-soft">Your cashback is paid to you after the stay is confirmed. Rates vary by hotel and are shown on each listing.</p>
                    </div>
                </div>
            </div>

            <!-- Subscribe form -->
            <div class="mil-blog-list mil-p-40-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-6">
                            <div class="mil-price-card">
                                <div class="mil-text-center mil-mb-30">
                                    <i class="fa fa-ticket" style="font-size: 60px; color: #6C2BD9;"></i>
                                    <h3 class="mil-mb-15 mil-mt-15">Subscribe to the Room Voucher</h3>
                                    <p class="mil-text-m mil-soft">We activate your subscription and email your membership number.</p>
                                </div>

                                <form action="/voucher/register" method="POST">
                                    <input type="hidden" name="ref" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>">

                                    <div class="row">
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="name" placeholder="Full name *" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="email" name="email" placeholder="Email address *" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="tel" name="phone" placeholder="Phone number *" required>
                                        </div>
                                        <div class="col-md-4">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="city" placeholder="City">
                                        </div>
                                        <div class="col-md-4">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="state" placeholder="State">
                                        </div>
                                        <div class="col-md-4">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="country" placeholder="Country" value="Nigeria">
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="password" name="password" placeholder="Password (min. 8 characters) *" required>
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-30" type="password" name="confirmPassword" placeholder="Confirm password *" required>
                                        </div>
                                    </div>

                                    <div class="mil-checkbox-frame mil-up mil-mb-30">
                                        <div class="mil-checkbox">
                                            <input type="checkbox" id="terms" name="terms" required>
                                            <label for="terms"></label>
                                        </div>
                                        <p class="mil-text-xs mil-soft">I understand that cashback is only payable on stays registered against a hotel listing before check-in, and I agree to the <a href="/terms" class="mil-accent">Terms and Conditions</a> and <a href="/privacy" class="mil-accent">Privacy Policy</a></p>
                                    </div>

                                    <div class="mil-up">
                                        <button type="submit" class="mil-btn mil-md mil-fw">Subscribe to the Room Voucher</button>
                                    </div>

                                    <div class="mil-text-center mil-mt-30">
                                        <p class="mil-text-s mil-soft">Already subscribed? <a href="/login" class="mil-accent">Login here</a></p>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">&copy; 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Room Voucher Programme</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(function(a) {
                a.style.opacity = '0';
                setTimeout(function() { if (a.parentNode) a.remove(); }, 300);
            });
        }, 7000);
    </script>

    <style>
        .mil-fw { width: 100%; }
        .mil-mt-30 { margin-top: 30px; }
        .mil-mt-15 { margin-top: 15px; }
        .mil-p-40-80 { padding: 40px 0 80px; }
        .mil-p-80-40 { padding: 80px 0 40px; }
    </style>
</body>
</html>
