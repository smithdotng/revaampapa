<!-- Room Voucher Subscriber top panel -->
<div class="mil-top-panel">
    <div class="container">
        <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
        <nav class="mil-top-menu">
            <ul>
                <li><a href="/">Home</a></li>
                <li class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'mil-active' : '' %>"><a href="/voucher/dashboard">Dashboard</a></li>
                <li class="<%= typeof active !== 'undefined' && active === 'reservations' ? 'mil-active' : '' %>"><a href="/voucher/reservations">My Reservations</a></li>
                <li><a href="/hotels">Browse Hotels</a></li>
                <li class="<%= typeof active !== 'undefined' && active === 'settings' ? 'mil-active' : '' %>"><a href="/voucher/settings">Settings</a></li>
            </ul>
        </nav>
        <div class="mil-menu-buttons">
            <div class="dropdown" style="position: relative;">
                <a href="#" class="mil-btn mil-sm dropdown-toggle" style="display: flex; align-items: center; gap: 8px;">
                    <i class="fa fa-user-circle"></i>
                    <span><%= user.name %></span>
                    <i class="fa fa-chevron-down"></i>
                </a>
                <ul class="dropdown-menu">
                    <li><a href="/voucher/settings"><i class="fa fa-cog"></i> Settings</a></li>
                    <li><a href="/logout"><i class="fa fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </div>
            <div class="mil-menu-btn"><span></span></div>
        </div>
    </div>
</div>
