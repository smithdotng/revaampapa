<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">

    <style>
        .hotel-card-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 12px 12px 0 0;
            display: block;
        }
        .hotel-card-img-placeholder {
            width: 100%;
            height: 220px;
            background: #f0f4f8;
            border-radius: 12px 12px 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .hotel-card-body {
            padding: 24px;
        }
        .hotel-amenity-chip {
            display: inline-block;
            background: rgba(3,166,166,0.1);
            color: #03A6A6;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 12px;
            margin: 3px 3px 0 0;
        }
        .hotel-filter-bar {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 40px;
        }
        .hotel-filter-bar input, .hotel-filter-bar select {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            background: #fff;
        }
        .hotel-rating {
            color: #f5a623;
            font-size: 13px;
        }
        .hotel-location {
            font-size: 13px;
            color: #888;
            margin-bottom: 10px;
        }
        .pagination-wrap {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin-top: 40px;
        }
        .pagination-wrap a, .pagination-wrap span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 8px;
            border: 1px solid #ddd;
            font-size: 14px;
            text-decoration: none;
            color: #333;
        }
        .pagination-wrap span.current {
            background: #03A6A6;
            color: #fff;
            border-color: #03A6A6;
        }
    </style>
</head>

<body>

<div id="smooth-wrapper" class="mil-wrapper">
    <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
    <div class="mil-progress-track"><div class="mil-progress"></div></div>
    <div class="progress-wrap active-progress"></div>

    <div class="mil-top-panel">
        <div class="container">
            <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
            <nav class="mil-top-menu">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/properties">Properties</a></li>
                    <li><a href="/hotels" class="mil-active">Hotels</a></li>
                    <li><a href="/blog">Blog</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </nav>
            <div class="mil-menu-buttons">
                <% if (user) { %>
                    <a href="/<%= user.type === 'superadmin' ? 'superadmin' : (user.type === 'promoter' ? 'promoter' : 'business-partner') %>/dashboard" class="mil-btn mil-sm"><i class="fa fa-user-circle"></i> <%= user.name %></a>
                <% } else { %>
                    <a href="/login" class="mil-btn mil-sm mil-border">Login</a>
                <% } %>
                <div class="mil-menu-btn"><span></span></div>
            </div>
        </div>
    </div>

    <div id="smooth-content">

        <!-- Banner -->
        <div class="mil-banner mil-banner-inner mil-dissolve">
            <div class="container">
                <div class="row align-items-center justify-content-center">
                    <div class="col-xl-8">
                        <div class="mil-banner-text mil-text-center">
                            <h1 class="mil-mb-60 mil-up">Partner Hotels</h1>
                            <ul class="mil-breadcrumbs mil-center mil-up">
                                <li><a href="/">Home</a></li>
                                <li>Hotels</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="mil-blog-list mil-p-80-0">
            <div class="container">
                <div class="hotel-filter-bar mil-up">
                    <form method="GET" action="/hotels">
                        <div class="row align-items-end">
                            <div class="col-xl-4 col-md-6 mil-mb-20">
                                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">City</label>
                                <input type="text" name="city" placeholder="e.g. Lagos" value="<%= filters.city || '' %>">
                            </div>
                            <div class="col-xl-4 col-md-6 mil-mb-20">
                                <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">State</label>
                                <input type="text" name="state" placeholder="e.g. Lagos State" value="<%= filters.state || '' %>">
                            </div>
                            <div class="col-xl-4 col-md-12 mil-mb-20">
                                <button type="submit" class="mil-btn" style="width:100%;padding:10px 20px;">
                                    <i class="fa fa-search"></i> Search Hotels
                                </button>
                            </div>
                        </div>
                        <% if (filters.city || filters.state) { %>
                        <div style="margin-top:8px;">
                            <a href="/hotels" style="font-size:13px;color:#888;"><i class="fa fa-times"></i> Clear filters</a>
                            <span style="font-size:13px;color:#888;margin-left:16px;"><%= total %> hotel<%= total !== 1 ? 's' : '' %> found</span>
                        </div>
                        <% } %>
                    </form>
                </div>
            </div>
        </div>

        <!-- Hotel Grid -->
        <div class="mil-blog-list mil-p-40-80">
            <div class="container">
                <% if (hotels && hotels.length > 0) { %>
                <div class="row">
                    <% hotels.forEach(function(hotel) {
                        const primaryImage = hotel.images && hotel.images.find(i => i.isPrimary);
                        const heroImg = primaryImage ? primaryImage.url : (hotel.images && hotel.images.length > 0 ? hotel.images[0].url : null);
                    %>
                    <div class="col-xl-4 col-lg-6 mil-mb-30">
                        <a href="/hotels/<%= hotel.slug %>" class="mil-price-card mil-up" style="display:block;text-decoration:none;color:inherit;transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <% if (heroImg) { %>
                                <img src="<%= heroImg %>" alt="<%= hotel.name %>" class="hotel-card-img" onerror="this.onerror=null;this.src='/img/hotel-placeholder.svg'">
                            <% } else { %>
                                <div class="hotel-card-img-placeholder">
                                    <i class="fa fa-building" style="font-size:48px;color:#ccc;"></i>
                                </div>
                            <% } %>
                            <div class="hotel-card-body">
                                <% if (hotel.featured) { %>
                                    <span style="background:#03A6A6;color:#fff;font-size:11px;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:8px;">Featured</span>
                                <% } %>
                                <h5 style="margin-bottom:6px;"><%= hotel.name %></h5>
                                <p class="hotel-location"><i class="fa fa-map-marker"></i> <%= hotel.location.city %><% if (hotel.location.state) { %>, <%= hotel.location.state %><% } %></p>
                                <% if (hotel.rating && hotel.rating > 0) { %>
                                <p class="hotel-rating mil-mb-10">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <i class="fa fa-star<%= i <= Math.round(hotel.rating) ? '' : '-o' %>"></i>
                                    <% } %>
                                    <span style="color:#888;font-size:12px;margin-left:4px;">(<%= hotel.rating.toFixed(1) %>)</span>
                                </p>
                                <% } %>
                                <% if (hotel.amenities && hotel.amenities.length > 0) { %>
                                <div style="margin-top:10px;">
                                    <% hotel.amenities.slice(0,4).forEach(function(a) { %>
                                        <span class="hotel-amenity-chip"><%= a.replace('_', ' ') %></span>
                                    <% }); %>
                                    <% if (hotel.amenities.length > 4) { %>
                                        <span class="hotel-amenity-chip">+<%= hotel.amenities.length - 4 %> more</span>
                                    <% } %>
                                </div>
                                <% } %>
                                <div style="margin-top:16px;">
                                    <span class="mil-link mil-accent">View Details →</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }); %>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                <div class="pagination-wrap mil-up">
                    <% if (currentPage > 1) { %>
                        <a href="?page=<%= currentPage - 1 %><%= filters.city ? '&city=' + filters.city : '' %><%= filters.state ? '&state=' + filters.state : '' %>"><i class="fa fa-chevron-left"></i></a>
                    <% } %>
                    <% for (let p = 1; p <= totalPages; p++) { %>
                        <% if (p === currentPage) { %>
                            <span class="current"><%= p %></span>
                        <% } else { %>
                            <a href="?page=<%= p %><%= filters.city ? '&city=' + filters.city : '' %><%= filters.state ? '&state=' + filters.state : '' %>"><%= p %></a>
                        <% } %>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="?page=<%= currentPage + 1 %><%= filters.city ? '&city=' + filters.city : '' %><%= filters.state ? '&state=' + filters.state : '' %>"><i class="fa fa-chevron-right"></i></a>
                    <% } %>
                </div>
                <% } %>

                <% } else { %>
                <div class="mil-text-center mil-p-60 mil-up">
                    <i class="fa fa-hotel" style="font-size:64px;color:#ccc;"></i>
                    <h4 class="mil-mt-30">No Hotels Found</h4>
                    <% if (filters.city || filters.state) { %>
                        <p class="mil-text-m mil-soft">No hotels match your search. <a href="/hotels" class="mil-accent">View all hotels</a></p>
                    <% } else { %>
                        <p class="mil-text-m mil-soft">No partner hotels are available at the moment. Check back soon.</p>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Become a Partner Hotel -->
        <div class="mil-p-0-80">
            <div class="container">
                <div class="mil-out-frame mil-p-80-80" style="background: linear-gradient(135deg, #7b4397 0%, #dc2430 100%); border-radius: 20px;">
                    <div class="row align-items-center">
                        <div class="col-xl-8">
                            <h3 class="mil-light mil-mb-15">Run a hotel? Get listed here.</h3>
                            <p class="mil-text-m mil-mb-0" style="color: rgba(255,255,255,0.85);">Revaamp Partner Hotels are marketed to our whole network across Africa &mdash; and your rooms get off-taken by Revaamp.</p>
                        </div>
                        <div class="col-xl-4 mil-text-right">
                            <a href="/partner-hotel/register" class="mil-btn mil-md mil-light mil-add-arrow">Become a Partner Hotel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>

    </div>
</div>

<script src="/js/plugins/jquery.min.js"></script>
<script src="/js/plugins/swiper.min.js"></script>
<script src="/js/plugins/gsap.min.js"></script>
<script src="/js/plugins/ScrollSmoother.min.js"></script>
<script src="/js/plugins/ScrollTrigger.min.js"></script>
<script src="/js/plugins/ScrollTo.min.js"></script>
<script src="/js/plugins/magnific-popup.js"></script>
<script src="/js/main.js"></script>

</body>
</html>
