<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="author" content="RevaampAPA">
    <title>Revaamp Partner Hotel Registration | List Your Hotel Across Africa</title>
    <meta name="description" content="Partner with Revaamp to market and promote your hotel to a pan-African network of promoters, business partners and travellers. List your hotel at revaampapa.com/partner-hotel/register.">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://revaampapa.com/partner-hotel/register">
    <meta property="og:title" content="Revaamp Partner Hotel — Get Seen. Get Booked.">
    <meta property="og:description" content="List your hotel on Revaamp and put it in front of the entire Revaamp network across Africa. Marketing and promotions handled by a continent-wide army of promoters.">
    <meta property="og:image" content="https://revaampapa.com/img/partner-hotel-og.jpg">
    <meta property="og:site_name" content="RevaampAPA">
    <meta property="og:locale" content="en_NG">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://revaampapa.com/partner-hotel/register">
    <meta name="twitter:title" content="Revaamp Partner Hotel — Get Seen. Get Booked.">
    <meta name="twitter:description" content="Put your hotel in front of the Revaamp network across Africa. Marketing and promotions, handled.">
    <meta name="twitter:image" content="https://revaampapa.com/img/partner-hotel-og.jpg">
    <meta name="twitter:site" content="@revaampap">

    <link rel="canonical" href="https://revaampapa.com/partner-hotel/register">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/properties">Properties</a></li>
                        <li><a href="/hotels">Hotels</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <a href="/login" class="mil-btn mil-sm">Log in</a>
                    <a href="/register" class="mil-btn mil-sm mil-light">List Property</a>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger alert-dismissible fade show m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert">&times;</button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success alert-dismissible fade show m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;">
                <i class="fas fa-check-circle"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert">&times;</button>
            </div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Marketing &amp; Promotions for Hotels</div>
                                <h1 class="mil-mb-60 mil-up">Revaamp Partner Hotel</h1>
                                <ul class="mil-breadcrumbs mil-center mil-up">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/hotels">Hotels</a></li>
                                    <li><a href="/partner-hotel/register">Partner Hotel</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-cta mil-up mil-mt-30">
                <div class="container">
                    <div class="mil-out-frame mil-p-80-80" style="background: linear-gradient(135deg, #7b4397 0%, #dc2430 100%);">
                        <div class="row justify-content-between align-items-center">
                            <div class="col-xl-12 mil-text-center">
                                <h2 class="mil-light mil-mb-15 mil-up">🏨 Your Hotel. In Front of an Entire Continent. 🏨</h2>
                                <p class="mil-text-m mil-light mil-mb-0 mil-up">Listed on Revaamp &nbsp;|&nbsp; Promoted by our network &nbsp;|&nbsp; Tracked bookings, real numbers</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- What you get -->
            <div class="mil-features mil-p-80-40">
                <div class="container">
                    <div class="mil-text-center mil-mb-60">
                        <h2 class="mil-mb-30 mil-up">What a Partner Hotel Gets</h2>
                        <p class="mil-text-m mil-soft mil-up">Revaamp operates across Africa. When your hotel is listed, it inherits that reach.</p>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-eye" style="font-size:45px;color:#7b4397;"></i>
                                <h5 class="mil-mb-10 mil-mt-15">Eyeballs From Day One</h5>
                                <p class="mil-text-s mil-soft">Your listing is pushed to the whole Revaamp network — property owners, promoters, business partners and subscribers across the continent.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-bullhorn" style="font-size:45px;color:#7b4397;"></i>
                                <h5 class="mil-mb-10 mil-mt-15">Rooms Off-Taken by Revaamp</h5>
                                <p class="mil-text-s mil-soft">Revaamp off-takes your rooms and its promoters actively market them across the network using unique tracking links.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mil-mb-30">
                            <div class="mil-price-card mil-up mil-text-center" style="height:100%;">
                                <i class="fa fa-chart-line" style="font-size:45px;color:#7b4397;"></i>
                                <h5 class="mil-mb-10 mil-mt-15">Numbers You Can Check</h5>
                                <p class="mil-text-s mil-soft">Your dashboard shows clicks, which promoters drove them, bookings and room nights — not a vague "brand awareness" report.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Registration form -->
            <div class="mil-blog-list mil-p-40-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-7">
                            <div class="mil-price-card">
                                <div class="mil-text-center mil-mb-30">
                                    <i class="fa fa-hotel" style="font-size: 60px; color: #7b4397;"></i>
                                    <h3 class="mil-mb-15 mil-mt-15">Apply to List Your Hotel</h3>
                                    <p class="mil-text-m mil-soft">Tell us about the property. Our team reviews every application before it goes live.</p>
                                </div>

                                <form action="/partner-hotel/register" method="POST" enctype="multipart/form-data">
                                    <input type="hidden" name="ref" value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>">

                                    <h4 class="mil-mb-15 mil-up">The Hotel</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="hotelName" placeholder="Hotel name *" required>
                                        </div>
                                        <div class="col-md-12">
                                            <textarea class="mil-input mil-up mil-mb-15" name="description" rows="4" placeholder="Describe the hotel — what makes it worth booking? *" required></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <select class="mil-input mil-up mil-mb-15" name="starRating">
                                                <option value="0">Star rating (optional)</option>
                                                <option value="1">1 star</option>
                                                <option value="2">2 star</option>
                                                <option value="3">3 star</option>
                                                <option value="4">4 star</option>
                                                <option value="5">5 star</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="number" min="1" name="numberOfRooms" placeholder="Total number of rooms">
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="number" name="yearEstablished" placeholder="Year established">
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="url" name="website" placeholder="Website (optional)">
                                        </div>
                                    </div>

                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Location</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="address" placeholder="Street address">
                                        </div>
                                        <div class="col-md-4">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="city" placeholder="City *" required>
                                        </div>
                                        <div class="col-md-4">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="state" placeholder="State / Region *" required>
                                        </div>
                                        <div class="col-md-4">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="country" placeholder="Country" value="Nigeria">
                                        </div>
                                    </div>

                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Rooms &amp; Rates</h4>
                                    <div class="mil-divider mil-mb-30"></div>
                                    <p class="mil-text-xs mil-soft mil-mb-15">Add the room types you want promoted. You can change these any time from your dashboard.</p>

                                    <div id="roomTypeRows">
                                        <div class="row room-type-row">
                                            <div class="col-md-5"><input class="mil-input mil-mb-15" type="text" name="roomTypeName" placeholder="Room type (e.g. Deluxe)"></div>
                                            <div class="col-md-4"><input class="mil-input mil-mb-15" type="number" name="roomTypePrice" placeholder="Rate per night"></div>
                                            <div class="col-md-3"><input class="mil-input mil-mb-15" type="number" name="roomTypeCount" placeholder="Rooms"></div>
                                        </div>
                                    </div>
                                    <button type="button" class="mil-btn mil-sm mil-mb-30" onclick="addRoomTypeRow()"><i class="fa fa-plus"></i> Add another room type</button>

                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Amenities</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <div class="row mil-mb-30">
                                        <% var amenityList = [
                                            ['wifi','Wi-Fi'], ['pool','Swimming pool'], ['gym','Gym'],
                                            ['restaurant','Restaurant'], ['parking','Parking'], ['spa','Spa'],
                                            ['conference','Conference facilities'], ['airport_shuttle','Airport shuttle'],
                                            ['room_service','Room service'], ['bar','Bar']
                                        ]; %>
                                        <% amenityList.forEach(function(a) { %>
                                            <div class="col-md-6">
                                                <label class="mil-text-s mil-soft" style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                                                    <input type="checkbox" name="amenities" value="<%= a[0] %>"> <%= a[1] %>
                                                </label>
                                            </div>
                                        <% }); %>
                                    </div>

                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Photos</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">Hotel photos (up to 10)</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="images" accept="image/*" multiple>
                                        <p class="mil-text-xs mil-soft mil-mt-5">The first photo becomes your listing's cover image. Good photos are the single biggest driver of clicks.</p>
                                    </div>

                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Verification Documents</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">CAC / Business Registration</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="cacCertificate" accept="image/*,.pdf">
                                    </div>

                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">Hotel / Tourism Operating Licence</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="hotelLicence" accept="image/*,.pdf">
                                    </div>

                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">Rate Card / Corporate Rate Policy (Optional)</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="ratePolicy" accept=".pdf,.doc,.docx,image/*">
                                        <p class="mil-text-xs mil-soft mil-mt-5">The rates you're willing to extend to the Revaamp network.</p>
                                    </div>

                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Your Contact Details</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <div class="row">
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="name" placeholder="Contact person's full name *" required>
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="position" placeholder="Position (e.g. General Manager)">
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="tel" name="phone" placeholder="Phone number *" required>
                                        </div>
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="email" name="email" placeholder="Email address *" required>
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="password" name="password" placeholder="Password (min. 8 characters) *" required>
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-30" type="password" name="confirmPassword" placeholder="Confirm password *" required>
                                        </div>
                                    </div>

                                    <div class="mil-checkbox-frame mil-up mil-mb-30">
                                        <div class="mil-checkbox">
                                            <input type="checkbox" id="mandate" name="mandate" required>
                                            <label for="mandate"></label>
                                        </div>
                                        <p class="mil-text-xs mil-soft">I confirm I am authorised to list this hotel and I accept the Revaamp Partner Hotel mandate — to honour rates and availability presented to the Revaamp network in good faith.</p>
                                    </div>

                                    <div class="mil-checkbox-frame mil-up mil-mb-30">
                                        <div class="mil-checkbox">
                                            <input type="checkbox" id="terms" name="terms" required>
                                            <label for="terms"></label>
                                        </div>
                                        <p class="mil-text-xs mil-soft">I agree to the <a href="/terms" class="mil-accent">Terms and Conditions</a> and <a href="/privacy" class="mil-accent">Privacy Policy</a></p>
                                    </div>

                                    <div class="mil-up">
                                        <button type="submit" class="mil-btn mil-md mil-fw">Submit Partner Hotel Application</button>
                                    </div>

                                    <div class="mil-text-center mil-mt-30">
                                        <p class="mil-text-s mil-soft">
                                            We review every application and email you the decision &mdash; there is no account to manage.
                                            Questions? <a href="/contact" class="mil-accent">Talk to our team</a>
                                        </p>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Partner Hotel Programme</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <script>
        function addRoomTypeRow() {
            var wrap = document.getElementById('roomTypeRows');
            if (wrap.querySelectorAll('.room-type-row').length >= 8) return;
            var row = wrap.querySelector('.room-type-row').cloneNode(true);
            row.querySelectorAll('input').forEach(function(i) { i.value = ''; });
            wrap.appendChild(row);
        }

        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(function(alert) {
                alert.style.opacity = '0';
                setTimeout(function() { if (alert.parentNode) alert.remove(); }, 300);
            });
        }, 6000);
    </script>

    <style>
        .mil-fw { width: 100%; }
        .mil-mt-30 { margin-top: 30px; }
        .mil-mt-10 { margin-top: 10px; }
        .mil-mt-5 { margin-top: 5px; }
        .mil-mb-5 { margin-bottom: 5px; }
        .mil-p-40-80 { padding: 40px 0 80px; }
        .mil-p-80-40 { padding: 80px 0 40px; }
    </style>
</body>

</html>
