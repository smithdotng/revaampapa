<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/project-subscriber/dashboard">Dashboard</a></li>
                        <li class="mil-active"><a href="/project-subscriber/projects">Projects</a></li>
                        <li><a href="/project-subscriber/bank-guarantee">Bank Guarantee</a></li>
                        <li><a href="/project-subscriber/subscription">Subscription</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <a href="/project-subscriber/projects" class="mil-btn mil-sm"><i class="fa fa-arrow-left"></i> Back</a>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20" style="text-transform:capitalize;">Status: <%= (project.status || '').replace(/_/g,' ') %></div>
                                <h1 class="mil-mb-15"><%= project.title %></h1>
                                <p class="mil-text-m mil-soft"><%= project.progress || 0 %>% complete</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-price-card mil-mb-30">
                                <div class="mil-text-right mil-mb-15">
                                    <a href="/project-subscriber/projects/<%= project.slug %>/updates" class="mil-btn mil-sm"><i class="fa fa-bullhorn"></i> Updates</a>
                                    <a href="/project-subscriber/projects/<%= project.slug %>/financials" class="mil-btn mil-sm"><i class="fa fa-coins"></i> Financials</a>
                                </div>

                                <h4 class="mil-mb-15">Overview</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <p><%= project.description %></p>
                                <p class="mil-mt-15"><strong>Type:</strong> <span style="text-transform:capitalize;"><%= project.projectType %></span></p>
                                <p><strong>Value:</strong> ₦<%= (project.projectValue || 0).toLocaleString() %></p>
                                <p><strong>Duration:</strong> <%= project.projectDuration %> months</p>
                                <% if (project.location) { %>
                                    <p><strong>Location:</strong> <%= [project.location.address, project.location.city, project.location.state].filter(Boolean).join(', ') || 'N/A' %></p>
                                <% } %>

                                <h4 class="mil-mb-15 mil-mt-30">Bank Guarantee</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <% if (project.bankGuarantee) { %>
                                    <p><strong>Bank:</strong> <%= project.bankGuarantee.bankName || 'N/A' %></p>
                                    <p><strong>Reference:</strong> <%= project.bankGuarantee.referenceNumber || 'N/A' %></p>
                                    <p><strong>Amount:</strong> ₦<%= (project.bankGuarantee.amount || 0).toLocaleString() %></p>
                                    <p style="text-transform:capitalize;"><strong>Status:</strong> <%= project.bankGuarantee.status || 'pending' %></p>
                                <% } else { %>
                                    <p class="mil-soft">No bank guarantee on record.</p>
                                <% } %>

                                <h4 class="mil-mb-15 mil-mt-30">Service Fee</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <% if (project.serviceFee) { %>
                                    <p><strong>Fee (<%= project.serviceFee.percentage || 10 %>%):</strong> ₦<%= (project.serviceFee.amount || 0).toLocaleString() %></p>
                                    <p><strong>Paid:</strong> <%= project.serviceFee.paid ? 'Yes' : 'No' %></p>
                                <% } %>

                                <h4 class="mil-mb-15 mil-mt-30">Milestones</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <% if (project.milestones && project.milestones.length) { %>
                                    <ul>
                                        <% project.milestones.forEach(function(m){ %>
                                            <li class="mil-mb-15"><strong><%= m.title %></strong> — <span style="text-transform:capitalize;"><%= (m.status||'').replace(/_/g,' ') %></span> (<%= m.percentage || 0 %>%)<% if (m.dueDate) { %> · due <%= new Date(m.dueDate).toLocaleDateString() %><% } %></li>
                                        <% }); %>
                                    </ul>
                                <% } else { %>
                                    <p class="mil-soft">No milestones yet.</p>
                                <% } %>

                                <h4 class="mil-mb-15 mil-mt-30">Documents</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <% if (project.documents && project.documents.length) { %>
                                    <ul>
                                        <% project.documents.forEach(function(d){ %>
                                            <li><a href="<%= d.url %>" target="_blank" class="mil-accent"><i class="fa fa-file-alt"></i> <%= d.name || d.type || 'Document' %></a></li>
                                        <% }); %>
                                    </ul>
                                <% } else { %>
                                    <p class="mil-soft">No documents uploaded.</p>
                                <% } %>

                                <% if (project.projectManager) { %>
                                    <h4 class="mil-mb-15 mil-mt-30">Project Manager</h4>
                                    <div class="mil-divider mil-mb-30"></div>
                                    <p><strong><%= project.projectManager.name %></strong></p>
                                    <p><%= project.projectManager.email %> · <%= project.projectManager.phone %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Project Management Dashboard</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .mil-divider { height: 1px; background: #e0e0e0; margin: 15px 0; }
    </style>
</body>

</html>
