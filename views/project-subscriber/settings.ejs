<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAP" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/project-subscriber/dashboard">Dashboard</a></li>
                        <li><a href="/project-subscriber/projects">Projects</a></li>
                        <li><a href="/project-subscriber/bank-guarantee">Bank Guarantee</a></li>
                        <li><a href="/project-subscriber/subscription">Subscription</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <a href="/project-subscriber/dashboard" class="mil-btn mil-sm"><i class="fa fa-arrow-left"></i> Back</a>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div class="alert alert-success m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;"><i class="fas fa-check-circle"></i> <%= success %></div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <h1 class="mil-mb-15">Settings</h1>
                                <p class="mil-text-m mil-soft">Manage your profile and password</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-6 mil-mb-30">
                            <div class="mil-price-card">
                                <h4 class="mil-mb-30">Profile</h4>
                                <form action="/project-subscriber/update-profile" method="POST">
                                    <label class="mil-text-s mil-soft">Full name</label>
                                    <input class="mil-input mil-mb-15" type="text" name="name" value="<%= user.name || '' %>" required>

                                    <label class="mil-text-s mil-soft">Phone</label>
                                    <input class="mil-input mil-mb-15" type="tel" name="phone" value="<%= user.phone || '' %>" required>

                                    <label class="mil-text-s mil-soft">Country of residence</label>
                                    <input class="mil-input mil-mb-15" type="text" name="countryOfResidence" value="<%= (user.projectSubscriberProfile && user.projectSubscriberProfile.countryOfResidence) || '' %>">

                                    <label class="mil-text-s mil-soft">Passport / ID number</label>
                                    <input class="mil-input mil-mb-30" type="text" name="passportNumber" value="<%= (user.projectSubscriberProfile && user.projectSubscriberProfile.passportNumber) || '' %>">

                                    <button type="submit" class="mil-btn mil-md mil-fw">Save Profile</button>
                                </form>
                            </div>
                        </div>

                        <div class="col-xl-6 mil-mb-30">
                            <div class="mil-price-card">
                                <h4 class="mil-mb-30">Change Password</h4>
                                <form action="/project-subscriber/change-password" method="POST">
                                    <label class="mil-text-s mil-soft">Current password</label>
                                    <input class="mil-input mil-mb-15" type="password" name="currentPassword" required>

                                    <label class="mil-text-s mil-soft">New password</label>
                                    <input class="mil-input mil-mb-15" type="password" name="newPassword" placeholder="min. 8 characters" required>

                                    <label class="mil-text-s mil-soft">Confirm new password</label>
                                    <input class="mil-input mil-mb-30" type="password" name="confirmPassword" required>

                                    <button type="submit" class="mil-btn mil-md mil-fw">Update Password</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-xl-12">
                            <div class="mil-price-card">
                                <h4 class="mil-mb-15">Account</h4>
                                <div class="mil-divider mil-mb-30"></div>
                                <p><strong>Email:</strong> <%= user.email %></p>
                                <p style="text-transform:capitalize;"><strong>Subscription:</strong> <%= (user.projectSubscriberProfile && user.projectSubscriberProfile.subscriptionStatus) || 'inactive' %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Project Management Dashboard</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .mil-fw { width: 100%; }
        .mil-input { width: 100%; padding: 12px 15px; border: 1px solid #e0e0e0; border-radius: 8px; }
        .mil-divider { height: 1px; background: #e0e0e0; margin: 15px 0; }
        label { display: block; margin-bottom: 5px; font-weight: 500; }
    </style>
</body>

</html>
