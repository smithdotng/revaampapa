<!DOCTYPE html>
<html lang="en-US">

<head>
    <title><%= title %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/fonts/css/switzer.css" type="text/css" media="all">
    <link rel="stylesheet" href="/fonts/css/font-awesome.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/bootstrap-grid.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/swiper.min.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/plugins/magnific-popup.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/style.css" type="text/css" media="all">
    <link rel="stylesheet" href="/css/custom.css" type="text/css" media="all">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div id="smooth-wrapper" class="mil-wrapper">
        <div class="mil-preloader"><div class="mil-load"></div><p class="h2 mil-mb-30"><span class="mil-light mil-counter" data-number="100">100</span><span class="mil-light">%</span></p></div>
        <div class="mil-progress-track"><div class="mil-progress"></div></div>
        <div class="progress-wrap active-progress"></div>

        <div class="mil-top-panel">
            <div class="container">
                <a href="/" class="mil-logo"><img src="/img/logo.png" alt="RevaampAPA" width="83" height="32"></a>
                <nav class="mil-top-menu">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/architect/dashboard">Dashboard</a></li>
                        <li class="mil-active"><a href="/architect/assessment/new">New Assessment</a></li>
                    </ul>
                </nav>
                <div class="mil-menu-buttons">
                    <a href="/architect/dashboard" class="mil-btn mil-sm"><i class="fa fa-arrow-left"></i> Back</a>
                    <div class="mil-menu-btn"><span></span></div>
                </div>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
            <div class="alert alert-danger alert-dismissible fade show m-3" style="position: fixed; top: 100px; right: 20px; z-index: 9999;">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <div id="smooth-content">
            <div class="mil-banner mil-banner-inner mil-dissolve">
                <div class="container">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-banner-text mil-text-center">
                                <div class="mil-text-m mil-mb-20 mil-up">Verification Phase &mdash; Structural Assessment</div>
                                <h1 class="mil-mb-30 mil-up">Structural Assessment Report</h1>
                                <p class="mil-text-m mil-soft mil-up">Conduct and submit your structural assessment of the proposed project plan</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mil-blog-list mil-p-80-80">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-xl-8">
                            <div class="mil-price-card">
                                <form action="/architect/assessment/new" method="POST" enctype="multipart/form-data">

                                    <!-- Project context -->
                                    <h4 class="mil-mb-15 mil-up">Project Details</h4>
                                    <div class="mil-divider mil-mb-30"></div>
                                    <div class="row">
                                        <div class="col-md-12">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="projectTitle" placeholder="Project title *" required>
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="projectLocation" placeholder="Project location (city / state)">
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="promoterName" placeholder="Promoter / proposer name">
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="proposedUse" placeholder="Proposed use (residential, commercial...)">
                                        </div>
                                        <div class="col-md-6">
                                            <input class="mil-input mil-up mil-mb-15" type="text" name="projectId" placeholder="Project reference / ID (optional)">
                                        </div>
                                    </div>

                                    <!-- Assessment body -->
                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Structural Assessment</h4>
                                    <div class="mil-divider mil-mb-30"></div>

                                    <label class="mil-text-s mil-soft mil-up">Site conditions</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="siteConditions" rows="3" placeholder="Topography, access, surroundings, drainage..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Soil / foundation assessment</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="foundationAssessment" rows="3" placeholder="Soil type, bearing capacity, recommended foundation..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Structural design review</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="structuralDesignReview" rows="3" placeholder="Review of the proposed structural design / drawings..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Materials assessment</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="materialsAssessment" rows="3" placeholder="Suitability and quality of specified materials..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Load-bearing evaluation</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="loadBearingEvaluation" rows="3" placeholder="Load paths, capacity, safety factors..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Compliance with building codes / regulations</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="complianceWithCodes" rows="3" placeholder="Relevant codes, permits, regulatory compliance..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Identified risks</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="identifiedRisks" rows="3" placeholder="Structural / safety risks identified..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Recommendations</label>
                                    <textarea class="mil-input mil-up mil-mb-15" name="recommendations" rows="3" placeholder="Recommended actions / modifications..."></textarea>

                                    <label class="mil-text-s mil-soft mil-up">Additional remarks</label>
                                    <textarea class="mil-input mil-up mil-mb-30" name="remarks" rows="2" placeholder="Any other remarks..."></textarea>

                                    <!-- Verdict -->
                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Assessment Verdict</h4>
                                    <div class="mil-divider mil-mb-30"></div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft mil-up">Structural integrity rating</label>
                                            <select class="mil-input mil-up mil-mb-15" name="structuralIntegrityRating">
                                                <option value="excellent">Excellent</option>
                                                <option value="good" selected>Good</option>
                                                <option value="fair">Fair</option>
                                                <option value="poor">Poor</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="mil-text-s mil-soft mil-up">Recommendation</label>
                                            <select class="mil-input mil-up mil-mb-15" name="recommendation">
                                                <option value="approved" selected>Approved</option>
                                                <option value="approved_with_conditions">Approved with conditions</option>
                                                <option value="rejected">Rejected</option>
                                            </select>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="mil-text-s mil-soft mil-up">Conditions (if any)</label>
                                            <textarea class="mil-input mil-up mil-mb-15" name="conditions" rows="2" placeholder="Conditions attached to the approval..."></textarea>
                                        </div>
                                    </div>

                                    <!-- Supporting documents -->
                                    <h4 class="mil-mb-15 mil-up mil-mt-30">Supporting Documents</h4>
                                    <div class="mil-divider mil-mb-30"></div>
                                    <div class="mil-mb-30">
                                        <label class="mil-text-s mil-soft mil-up">Plans / drawings / report (up to 10 files)</label>
                                        <input class="mil-input mil-up mil-mt-10" type="file" name="supportingDocuments" accept="image/*,.pdf,.doc,.docx" multiple>
                                        <p class="mil-text-xs mil-soft mil-mt-5">Attach the proposed plan, drawings, or your full report (PDF, DOC or image - Max 10MB each)</p>
                                    </div>

                                    <div class="mil-up mil-mt-30">
                                        <button type="submit" class="mil-btn mil-md mil-fw"><i class="fa fa-paper-plane"></i> Submit Structural Assessment Report</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mil-p-80-0">
                <div class="container">
                    <div class="mil-footer-bottom">
                        <div class="row">
                            <div class="col-xl-6"><p class="mil-text-s mil-soft">© 2026 RevaampAPA. All rights reserved.</p></div>
                            <div class="col-xl-6"><p class="mil-text-s mil-text-right mil-sm-text-left mil-soft">Architect Dashboard</p></div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/js/plugins/jquery.min.js"></script>
    <script src="/js/plugins/swiper.min.js"></script>
    <script src="/js/plugins/gsap.min.js"></script>
    <script src="/js/plugins/ScrollSmoother.min.js"></script>
    <script src="/js/plugins/ScrollTrigger.min.js"></script>
    <script src="/js/plugins/ScrollTo.min.js"></script>
    <script src="/js/plugins/magnific-popup.js"></script>
    <script src="/js/main.js"></script>

    <style>
        .mil-fw { width: 100%; }
        .mil-mt-30 { margin-top: 30px; }
        .mil-mt-10 { margin-top: 10px; }
        .mil-mb-5 { margin-bottom: 5px; }
        .mil-mb-15 { margin-bottom: 15px; }
        .mil-mb-30 { margin-bottom: 30px; }
        .mil-input { width: 100%; padding: 12px 15px; border: 1px solid #e0e0e0; border-radius: 8px; }
        .mil-divider { height: 1px; background: #e0e0e0; margin: 15px 0; }
        label { display: block; margin-bottom: 5px; font-weight: 500; }
    </style>
</body>

</html>
